---
const pathname = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/categories', label: 'Categories' },
  { href: '/resources', label: 'Resources' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const socials = [
  {
    name: 'X',
    href: 'https://x.com/digisoneglobal',
    label: 'X (Twitter)',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  },
  {
    name: 'LinkedIn',
    href: 'https://linkedin.com/company/digisoneglobal',
    label: 'LinkedIn',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    name: 'Instagram',
    href: 'https://instagram.com/digisoneglobal',
    label: 'Instagram',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
  },
  {
    name: 'YouTube',
    href: 'https://youtube.com/@digisoneglobal',
    label: 'YouTube',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/' || pathname === '';
  return pathname === href || pathname.startsWith(href + '/');
}
---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <!-- Logo -->
    <a href="/" class="logo" aria-label="DigiSone Global — Home">
      <span class="logo-mark">
        <span class="logo-mark-inner">D</span>
      </span>
      <span class="logo-text">
        DigiSone<span class="logo-accent">Global</span>
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link', { active: isActive(item.href) }]}
            >
              <span class="nav-label">{item.label}</span>
              <span class="nav-indicator" aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Right side -->
    <div class="header-actions">
      <div class="social-desktop" aria-label="Social media">
        {socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="social-btn"
            aria-label={s.label}
            title={s.label}
          >
            <Fragment set:html={s.icon} />
          </a>
        ))}
      </div>

      <div class="actions-divider" aria-hidden="true"></div>

      <a href="/#newsletter" class="btn-cta">
        <span>Subscribe</span>
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <button
        class="menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        id="menu-toggle"
      >
        <span class="hamburger" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  <!-- ========== MOBILE NAV ========== -->
  <div class="nav-mobile" id="mobile-nav" hidden>
    <nav aria-label="Mobile">
      <!-- Navigation Links -->
      <ul class="mobile-nav-list">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link-mobile', { active: isActive(item.href) }]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Donation -->
      <div class="mobile-section">
        <p class="section-label">Support Our Work</p>
        <a href="/donate" class="btn-donate">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
          <span>Donate Now</span>
        </a>
      </div>

      <!-- Social -->
      <div class="mobile-section">
        <p class="section-label">Follow @digisoneglobal</p>
        <div class="mobile-social-grid">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="social-card"
              aria-label={s.label}
            >
              <span class="social-icon">
                <Fragment set:html={s.icon} />
              </span>
              <span class="social-name">{s.name}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <a href="/#newsletter" class="btn-cta mobile">
        Get Weekly Briefing
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(248, 250, 252, 0.8);
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    border-bottom: 1px solid rgba(15, 23, 42, 0.06);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  .site-header.scrolled {
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 8px 30px rgba(15, 23, 42, 0.06);
  }

  .header-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0.85rem 1.35rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  /* Logo */
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: #0b1220;
    flex-shrink: 0;
  }

  .logo-mark {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: linear-gradient(135deg, #2563eb 0%, #6366f1 55%, #8b5cf6 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 1px rgba(255,255,255,0.15) inset, 0 6px 18px rgba(37,99,235,0.35);
  }

  .logo-mark-inner {
    color: white;
    font-family: "Space Grotesk", "Inter", system-ui, sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
  }

  .logo-text {
    font-family: "Space Grotesk", "Inter", system-ui, sans-serif;
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.03em;
  }

  .logo-accent {
    background: linear-gradient(120deg, #2563eb, #6366f1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Desktop Nav */
  .nav-desktop { display: none; }
  .nav-desktop ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.1rem;
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    padding: 0.5rem 0.85rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #64748b;
    border-radius: 10px;
    text-decoration: none;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .nav-link:hover { color: #0b1220; background: rgba(15,23,42,0.04); }
  .nav-link.active { color: #2563eb; background: rgba(37,99,235,0.08); }
  .nav-indicator {
    position: absolute;
    bottom: 4px;
    left: 50%;
    width: 0;
    height: 2.5px;
    border-radius: 2px;
    background: linear-gradient(90deg, #2563eb, #6366f1);
    transform: translateX(-50%);
    transition: width 0.3s ease;
    opacity: 0;
  }
  .nav-link:hover .nav-indicator,
  .nav-link.active .nav-indicator { width: 18px; opacity: 1; }

  /* Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .social-desktop { display: none; }
  .social-btn {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #64748b;
    transition: all 0.2s ease;
  }
  .social-btn:hover {
    color: #2563eb;
    background: rgba(37,99,235,0.08);
  }
  .actions-divider {
    display: none;
    width: 1px;
    height: 20px;
    background: rgba(15,23,42,0.1);
  }
  .btn-cta {
    display: none;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 1.15rem;
    border-radius: 11px;
    font-size: 0.875rem;
    font-weight: 600;
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: white;
    text-decoration: none;
    box-shadow: 0 5px 16px rgba(37,99,235,0.3);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .btn-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 22px rgba(37,99,235,0.4);
  }

  /* Hamburger */
  .menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(15,23,42,0.08);
    border-radius: 11px;
    background: white;
    cursor: pointer;
  }
  .hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 17px;
  }
  .hamburger span {
    display: block;
    height: 2px;
    width: 100%;
    background: #0b1220;
    border-radius: 2px;
    transition: all 0.28s ease;
  }
  .menu-toggle[aria-expanded="true"] .hamburger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-toggle[aria-expanded="true"] .hamburger span:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle[aria-expanded="true"] .hamburger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ========== MOBILE NAV - CLEAN & COMPACT ========== */
  .nav-mobile {
    border-top: 1px solid rgba(15, 23, 42, 0.06);
    background: #ffffff;
  }

  .nav-mobile[hidden] {
    display: none;
  }

  .nav-mobile nav {
    padding: 1rem 1.25rem 1.4rem; 2 rem
  }

  /* Nav Links - tighter */
  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .nav-link-mobile {
    display: block;
    padding: 0.82rem 1rem;
    font-size: 1.02rem;
    font-weight: 600;
    color: #334155;
    border-radius: 12px;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .nav-link-mobile:hover {
    background: #f1f5f9;
    color: #0f172a;
  }

  .nav-link-mobile.active {
    background: #eff6ff;
    color: #2563eb;
  }

  /* Sections */
  .mobile-section {
    margin-top: 1.25rem;
    padding-top: 1.15rem;
    border-top: 1px solid #f1f5f9;
  }

  .section-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #94a3b8;
    margin: 0 0 0.7rem 0.1rem;
  }

  /* Donate - stronger */
  .btn-donate {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.9rem 1rem;
    border-radius: 13px;
    font-size: 0.98rem;
    font-weight: 600;
    color: #be123c;
    background: #fff1f2;
    border: 1px solid #fecdd3;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-donate:hover {
    background: #ffe4e6;
    border-color: #fda4af;
  }

  .btn-donate svg {
    color: #e11d48;
    flex-shrink: 0;
  }

  /* Social Grid - fixed icons */
  .mobile-social-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .social-card {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.75rem 0.9rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    text-decoration: none;
    color: #334155;
    font-size: 0.88rem;
    font-weight: 600;
    transition: all 0.15s ease;
  }

  .social-card:hover {
    background: #eff6ff;
    border-color: #bfdbfe;
    color: #2563eb;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .social-icon svg {
    width: 15px;
    height: 15px;
  }

  .social-name {
    line-height: 1.1;
  }

  /* Mobile CTA */
  .btn-cta.mobile {
    display: flex;
    width: 100%;
    margin-top: 1.25rem;
    padding: 0.9rem 1rem;
    font-size: 0.95rem;
    border-radius: 13px;
  }

  /* Desktop */
  @media (min-width: 960px) {
    .nav-desktop { display: block; }
    .social-desktop { display: flex; }
    .actions-divider { display: block; }
    .btn-cta { display: inline-flex; }
    .menu-toggle { display: none; }
    .nav-mobile { display: none !important; }
  }

  @media (max-width: 480px) {
    .header-inner { padding: 0.75rem 1.1rem; }
    .logo-text { font-size: 1.05rem; }
    .logo-mark { width: 34px; height: 34px; }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  if (header) {
    const onScroll = () => {
      header.classList.toggle('scrolled', window.scrollY > 12);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (toggle && mobileNav) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      toggle.setAttribute('aria-label', expanded ? 'Open menu' : 'Close menu');
      mobileNav.hidden = expanded;
    });

    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
        mobileNav.hidden = true;
      });
    });
  }
</script>
