---
// Header.astro
---
<header class="site-header">
  <div class="container">
    <!-- Premium Image Logo + Written Text Combo -->
    <div class="logo-area">
      <a href="/" class="logo-link">
        <img src="/logo.webp" alt="DigiSone Global Logo" class="main-logo" />
        <div class="logo-text-group">
          <span class="logo-text-bold">DigiSone</span>
          <span class="logo-text-light">Global</span>
        </div>
      </a>
      <span class="tagline">Origin: Sonbhadra <span class="separator">|</span> Impact: Global</span>
    </div>

    <!-- Premium Hamburger Menu Trigger -->
    <button class="mobile-menu-toggle" id="menuToggle" aria-label="Toggle Menu">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>

    <!-- Navigation Menu Layout -->
    <nav class="nav-menu" id="navMenu">
      <a href="/" class="nav-link active">Home</a>
      <a href="/blog" class="nav-link">Blog</a>
      <a href="/categories" class="nav-link">Categories</a>
      <a href="/about" class="nav-link">About</a>
      <div class="contact-btn-wrapper">
        <a href="/contact" class="nav-link contact-btn">Contact</a>
      </div>
    </nav>
  </div>
</header>

<script>
  // Clean mobile toggle handler
  const menuToggle = document.getElementById('menuToggle');
  const navMenu = document.getElementById('navMenu');

  if (menuToggle && navMenu) {
    menuToggle.addEventListener('click', () => {
      menuToggle.classList.toggle('active');
      navMenu.classList.toggle('open');
    });
  }
</script>

<style>
  /* Premium Glassmorphism Header Setup */
  .site-header {
    background-color: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(226, 232, 240, 0.8);
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 0.75rem 0;
    transition: all 0.3s ease;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* Logo Area Design */
  .logo-area {
    display: flex;
    flex-direction: column;
  }

  .logo-link {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .main-logo {
    height: 34px;
    width: auto;
    object-fit: contain;
  }

  /* Written Logo Layout next to image */
  .logo-text-group {
    display: flex;
    align-items: center;
    font-size: 1.35rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .logo-text-bold {
    color: #0f172a;
    font-weight: 800;
  }

  .logo-text-light {
    color: #2563eb;
    font-weight: 500;
    margin-left: 1px;
  }

  .tagline {
    font-size: 0.68rem;
    color: #64748b;
    margin-top: 0.25rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .separator {
    color: #cbd5e1;
    margin: 0 2px;
  }

  /* Premium Navigation Links */
  .nav-menu {
    display: flex;
    align-items: center;
    gap: 2.2rem;
  }

  .nav-link {
    text-decoration: none;
    color: #475569;
    font-weight: 600;
    font-size: 0.92rem;
    position: relative;
    padding: 0.5rem 0;
    transition: color 0.25s ease;
  }

  /* Premium Underline Slide Effect on Hover */
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: #f59e0b;
    transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-link:hover::after, .nav-link.active::after {
    width: 100%;
  }

  .nav-link:hover, .nav-link.active {
    color: #f59e0b;
  }

  /* Premium Contact Button Customizing */
  .contact-btn-wrapper {
    padding-left: 0.5rem;
  }

  .nav-link.contact-btn {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    color: #ffffff;
    padding: 0.55rem 1.4rem;
    border-radius: 50px;
    box-shadow: 0 4px 10px rgba(15, 23, 42, 0.15);
    font-weight: 500;
  }

  .nav-link.contact-btn::after {
    display: none;
  }

  .nav-link.contact-btn:hover {
    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 6px 15px rgba(37, 99, 235, 0.25);
  }

  /* Sleek Modern Hamburger Icon styling */
  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 22px;
    height: 16px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 101;
  }

  .mobile-menu-toggle .bar {
    width: 100%;
    height: 2px;
    background-color: #0f172a;
    border-radius: 2px;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Tablet and Mobile Optimization Layer */
  @media (max-width: 768px) {
    .mobile-menu-toggle {
      display: flex;
    }

    .nav-menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background-color: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(15px);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      border-bottom: 0px solid #f1f5f9;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
    }

    .nav-menu.open {
      max-height: 450px;
      border-bottom: 1px solid #e2e8f0;
      padding: 1rem 0;
    }

    .nav-link {
      padding: 0.9rem 2rem;
      width: 100%;
      box-sizing: border-box;
      font-size: 1rem;
    }

    .nav-link::after {
      display: none;
    }

    .nav-link:hover {
      background-color: #f8fafc;
      padding-left: 2.3rem;
    }

    .contact-btn-wrapper {
      padding: 0.5rem 2rem;
    }

    .nav-link.contact-btn {
      border-radius: 8px;
      text-align: center;
      box-shadow: none;
    }
    
    .nav-link.contact-btn:hover {
      transform: none;
    }

    /* Slick Cross icon morphing */
    .mobile-menu-toggle.active .bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .mobile-menu-toggle.active .bar:nth-child(2) {
      opacity: 0;
      transform: scaleX(0);
    }
    .mobile-menu-toggle.active .bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>
