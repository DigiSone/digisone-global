---
// Header.astro
---
<header class="site-header">
  <div class="container">
    <!-- Premium Image Logo + Written Text Combo -->
    <div class="logo-area">
      <a href="/" class="logo-link">
        <img src="/logo.webp" alt="DigiSone Global Logo" class="main-logo" />
        <div class="logo-text-group">
          <span class="logo-text-bold">DigiSone</span>
          <span class="logo-text-light">Global</span>
        </div>
      </a>
      <span class="tagline">Origin: Sonbhadra <span class="separator">|</span> Impact: Global</span>
    </div>

    <!-- Right Side Actions (Desktop Only) -->
    <div class="header-right-desktop">
      <!-- Navigation Menu Layout -->
      <nav class="nav-menu-desktop">
        <a href="/" class="nav-link active">Home</a>
        <a href="/blog" class="nav-link">Blog</a>
        <a href="/categories" class="nav-link">Categories</a>
        <a href="/about" class="nav-link">About</a>
        <a href="/contact" class="nav-link-mobile contact-btn-mobile">Contact</a>

      </nav>

      <!-- Social Links (Desktop Only) -->
      <div class="header-socials-desktop">
        <a href="x.com/digisoneglobal" aria-label="Twitter" class="social-icon">𝕏</a>
        <a href="linkedin.com/company/digisoneglobal" aria-label="LinkedIn" class="social-icon">in</a>
        <a href="youtube.com/@digisoneglobal" aria-label="YouTube" class="social-icon">yt</a>
      </div>
    </div>

    <!-- Premium Hamburger Menu Trigger -->
    <button class="mobile-menu-toggle" id="menuToggle" aria-label="Toggle Menu">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>

    <!-- Combined Mobile Dropdown Menu -->
    <div class="mobile-dropdown" id="navMenu">
      <nav class="nav-menu-mobile">
        <a href="/" class="nav-link-mobile active">Home</a>
        <a href="/blog" class="nav-link-mobile">Blog</a>
        <a href="/categories" class="nav-link-mobile">Categories</a>
        <a href="/about" class="nav-link-mobile">About</a>
        <div class="contact-btn-wrapper-mobile">
          <a href="/contact" class="nav-link-mobile contact-btn-mobile">Contact</a>
        </div>
      </nav>
      
      <!-- Social Links Inside Mobile Dropdown -->
      <div class="mobile-menu-socials">
        <p class="socials-label">Follow Us</p>
        <div class="social-icons-row">
          <a href="x.com/digisoneglobal" aria-label="Twitter" class="social-icon-mobile">𝕏</a>
          <a href="linkedin.com/company/digisoneglobal" aria-label="LinkedIn" class="social-icon-mobile">in</a>
          <a href="youtube.com/@digisoneglobal" aria-label="YouTube" class="social-icon-mobile">yt</a>
        </div>
      </div>
    </div>

  </div>
</header>

<script>
  // Clean mobile toggle handler
  const menuToggle = document.getElementById('menuToggle');
  const navMenu = document.getElementById('navMenu');

  if (menuToggle && navMenu) {
    menuToggle.addEventListener('click', () => {
      menuToggle.classList.toggle('active');
      navMenu.classList.toggle('open');
    });
  }
</script>

<style>
  /* Premium Glassmorphism Header Setup */
  .site-header {
    background-color: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(226, 232, 240, 0.8);
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 0.75rem 0;
    transition: all 0.3s ease;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* Logo Area Design */
  .logo-area {
    display: flex;
    flex-direction: column;
  }

  .logo-link {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .main-logo {
    height: 34px;
    width: auto;
    object-fit: contain;
  }

  .logo-text-group {
    display: flex;
    align-items: center;
    font-size: 1.35rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .logo-text-bold {
    color: #0f172a;
    font-weight: 800;
  }

  .logo-text-light {
    color: #2563eb;
    font-weight: 500;
    margin-left: 1px;
  }

  .tagline {
    font-size: 0.68rem;
    color: #64748b;
    margin-top: 0.25rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .separator {
    color: #cbd5e1;
    margin: 0 2px;
  }

  /* Desktop Right Container Layout */
  .header-right-desktop {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  .nav-menu-desktop {
    display: flex;
    align-items: center;
    gap: 1.8rem;
  }

  .nav-link {
    text-decoration: none;
    color: #475569;
    font-weight: 600;
    font-size: 0.92rem;
    position: relative;
    padding: 0.5rem 0;
    transition: color 0.25s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: #f59e0b;
    transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-link:hover::after, .nav-link.active::after {
    width: 100%;
  }

  .nav-link:hover, .nav-link.active {
    color: #f59e0b;
  }

  .nav-link.contact-btn {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    color: #ffffff;
    padding: 0.55rem 1.4rem;
    border-radius: 50px;
    box-shadow: 0 4px 10px rgba(15, 23, 42, 0.15);
    font-weight: 500;
  }

  .nav-link.contact-btn::after {
    display: none;
  }

  .nav-link.contact-btn:hover {
    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 6px 15px rgba(37, 99, 235, 0.25);
  }

  /* Desktop Social Icons Styling */
  .header-socials-desktop {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    border-left: 1px solid #e2e8f0;
    padding-left: 1.2rem;
  }

  .social-icon {
    text-decoration: none;
    color: #64748b;
    font-size: 0.85rem;
    font-weight: bold;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background-color: #f8fafc;
    transition: all 0.2s ease;
  }

  .social-icon:hover {
    background-color: #0f172a;
    color: #ffffff;
    transform: translateY(-1px);
  }

  /* Sleek Modern Hamburger Icon styling */
  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 22px;
    height: 16px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 101;
  }

  .mobile-menu-toggle .bar {
    width: 100%;
    height: 2px;
    background-color: #0f172a;
    border-radius: 2px;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Tablet and Mobile Layer Layout */
  .mobile-dropdown {
    display: none;
  }

  @media (max-width: 768px) {
    .header-right-desktop {
      display: none;
    }

    .mobile-menu-toggle {
      display: flex;
    }

    /* Redesigned Mobile Drawer Container */
    .mobile-dropdown {
      display: flex;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background-color: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(15px);
      flex-direction: column;
      gap: 0;
      padding: 0;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      border-bottom: 0px solid #f1f5f9;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
    }

    .mobile-dropdown.open {
      max-height: 520px;
      border-bottom: 1px solid #e2e8f0;
    }

    .nav-menu-mobile {
      display: flex;
      flex-direction: column;
      width: 100%;
    }

    .nav-link-mobile {
      text-decoration: none;
      color: #475569;
      font-weight: 600;
      padding: 0.9rem 2rem;
      width: 100%;
      box-sizing: border-box;
      font-size: 1rem;
      transition: all 0.2s ease;
    }

    .nav-link-mobile:hover, .nav-link-mobile.active {
      color: #f59e0b;
      background-color: #f8fafc;
      padding-left: 2.3rem;
    }

    .contact-btn-wrapper-mobile {
      padding: 0.5rem 2rem;
    }

    .nav-link-mobile.contact-btn-mobile {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      color: #ffffff;
      border-radius: 8px;
      text-align: center;
      display: block;
      padding: 0.7rem 0;
    }

    /* Mobile Social Links Block */
    .mobile-menu-socials {
      border-top: 1px solid #f1f5f9;
      padding: 1.5rem 2rem;
      margin-top: 0.5rem;
      background-color: #f8fafc;
    }

    .socials-label {
      margin: 0 0 0.75rem 0;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #94a3b8;
      font-weight: 700;
    }

    .social-icons-row {
      display: flex;
      gap: 1rem;
    }

    .social-icon-mobile {
      text-decoration: none;
      color: #475569;
      font-weight: bold;
      font-size: 0.9rem;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background-color: #ffffff;
      border: 1px solid #e2e8f0;
      transition: all 0.2s ease;
    }

    .social-icon-mobile:hover {
      background-color: #0f172a;
      color: #ffffff;
    }

    /* Slick Cross icon morphing */
    .mobile-menu-toggle.active .bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .mobile-menu-toggle.active .bar:nth-child(2) {
      opacity: 0;
      transform: scaleX(0);
    }
    .mobile-menu-toggle.active .bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style> 
