---
// Footer.astro
const currentYear = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-container">
    
    <!-- Left Column: Branding and Description -->
    <div class="footer-brand-section">
      <div class="footer-logo">
        <img src="/logo.webp" alt="DigiSone Global Logo" class="footer-logo-img" />
        <div class="logo-text-group">
          <span class="logo-text-bold">DigiSone</span>
          <span class="logo-text-light">Global</span>
        </div>
      </div>
      <p class="footer-description">
        A modern technology and digital knowledge platform built for creators, businesses, and professionals to make technology accessible through actionable content.
      </p>
      <div class="footer-socials">
        <a href="#" aria-label="Twitter" class="social-link">𝕏</a>
        <a href="#" aria-label="LinkedIn" class="social-link">in</a>
        <a href="#" aria-label="GitHub" class="social-link">git</a>
        <a href="#" aria-label="YouTube" class="social-link">yt</a>
      </div>
    </div>

    <!-- Center Column: Quick Navigation Links -->
    <div class="footer-links-section">
      <h3 class="footer-heading">Navigation</h3>
      <ul class="footer-links-list">
        <li><a href="/" class="f-link">Home</a></li>
        <li><a href="/blog" class="f-link">Blog Posts</a></li>
        <li><a href="/categories" class="f-link">Categories</a></li>
        <li><a href="/about" class="f-link">About Us</a></li>
        <li><a href="/contact" class="f-link">Contact</a></li>
      </ul>
    </div>

    <!-- Right Column: Categories / Topics -->
    <div class="footer-links-section">
      <h3 class="footer-heading">Resources</h3>
      <ul class="footer-links-list">
        <li><a href="#" class="f-link">Web Development</a></li>
        <li><a href="#" class="f-link">Digital Marketing</a></li>
        <li><a href="#" class="f-link">Artificial Intelligence</a></li>
        <li><a href="#" class="f-link">Privacy Policy</a></li>
        <li><a href="#" class="f-link">Terms of Service</a></li>
      </ul>
    </div>

  </div>

  <!-- Bottom Bar: Copyright and Location Tag -->
  <div class="footer-bottom">
    <div class="footer-bottom-container">
      <p class="copyright-text">&copy; {currentYear} DigiSone Global. All rights reserved.</p>
      <p class="location-tag">Origin: Sonbhadra <span class="bullet">&bull;</span> Impact: Global</p>
    </div>
  </div>
</footer>

<style>
  /* Premium Footer Layout */
  .site-footer {
    background-color: #ffffff;
    border-top: 1px solid rgba(226, 232, 240, 0.8);
    padding: 4rem 0 0 0;
    margin-top: auto; /* Pushes footer to bottom if content is short */
    font-family: system-ui, -apple-system, sans-serif;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem 3rem 1.5rem;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 4rem;
  }

  /* Branding Section */
  .footer-brand-section {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .footer-logo-img {
    height: 32px;
    width: auto;
    object-fit: contain;
  }

  .logo-text-group {
    display: flex;
    align-items: center;
    font-size: 1.3rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .logo-text-bold {
    color: #0f172a;
    font-weight: 800;
  }

  .logo-text-light {
    color: #2563eb;
    font-weight: 500;
    margin-left: 1px;
  }

  .footer-description {
    color: #64748b;
    font-size: 0.92rem;
    line-height: 1.6;
    max-width: 400px;
  }

  /* Social Icons Setup */
  .footer-socials {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: #f8fafc;
    color: #475569;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: bold;
    transition: all 0.25s ease;
    border: 1px solid #e2e8f0;
  }

  .social-link:hover {
    background-color: #0f172a;
    color: #ffffff;
    transform: translateY(-2px);
    border-color: #0f172a;
  }

  /* Links Column Styling */
  .footer-links-section {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .footer-heading {
    color: #0f172a;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .footer-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .f-link {
    text-decoration: none;
    color: #64748b;
    font-size: 0.92rem;
    font-weight: 500;
    transition: all 0.2s ease;
    display: inline-block;
  }

  .f-link:hover {
    color: #f59e0b; /* Accent color matching header */
    transform: translateX(3px); /* Subtle shift animation */
  }

  /* Bottom Copyright Bar */
  .footer-bottom {
    border-top: 1px solid #f1f5f9;
    padding: 1.5rem 0;
    background-color: #f8fafc;
  }

  .footer-bottom-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .copyright-text {
    color: #64748b;
    font-size: 0.85rem;
    margin: 0;
  }

  .location-tag {
    color: #94a3b8;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0;
  }

  .bullet {
    color: #cbd5e1;
    margin: 0 4px;
  }

  /* Responsive Design Layer */
  @media (max-width: 968px) {
    .footer-container {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
    .footer-brand-section {
      grid-column: span 2;
    }
  }

  @media (max-width: 580px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding-bottom: 2rem;
    }
    .footer-brand-section {
      grid-column: span 1;
    }
    .footer-bottom-container {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
    }
  }
</style>
