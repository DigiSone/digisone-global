---
import CookieConsent from './CookieConsent.astro';
const year = new Date().getFullYear();

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/categories', label: 'Categories' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const categoryLinks = [
  { href: '/categories/artificial-intelligence', label: 'Artificial Intelligence' },
  { href: '/categories/business-strategy', label: 'Business Strategy' },
  { href: '/categories/startups', label: 'Startups' },
  { href: '/categories/cybersecurity', label: 'Cybersecurity' },
  { href: '/categories/cloud-computing', label: 'Cloud Computing' },
  { href: '/categories/future-of-work', label: 'Future of Work' },
];

const socials = [
  {
    name: 'X',
    href: 'https://x.com/digisoneglobal',
    label: 'X (Twitter)',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  },
  {
    name: 'LinkedIn',
    href: 'https://linkedin.com/company/digisoneglobal',
    label: 'LinkedIn',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    name: 'Instagram',
    href: 'https://instagram.com/digisoneglobal',
    label: 'Instagram',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
  },
  {
    name: 'YouTube',
    href: 'https://youtube.com/@digisoneglobal',
    label: 'YouTube',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <!-- Top grid -->
    <div class="footer-grid">
      <!-- Brand -->
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="DigiSone Global — Home">
          <span class="logo-mark">
            <span class="logo-mark-inner">D</span>
          </span>
          <span class="logo-text">
            DigiSone<span class="logo-accent">Global</span>
          </span>
        </a>
        <p class="brand-desc">
          Premium insights on Artificial Intelligence, business strategy,
          startups, cybersecurity, cloud, and the future of work.
        </p>
        <a href="mailto:info@digisone.com" class="footer-email">
          <span class="email-icon" aria-hidden="true">✉️</span>
          info@digisone.com
        </a>
      </div>

      <!-- Explore -->
      <div class="footer-col">
        <h3 class="footer-heading">Explore</h3>
        <ul class="footer-links">
          {navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Categories -->
      <div class="footer-col">
        <h3 class="footer-heading">Categories</h3>
        <ul class="footer-links">
          {categoryLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Newsletter + Social -->
      <div class="footer-col footer-cta-col">
        <h3 class="footer-heading">Stay ahead</h3>
        <p class="cta-text">
          Get the weekly technology briefing — AI, strategy, and digital transformation.
        </p>
        <a href="/#newsletter" class="footer-cta">
          Subscribe
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <div class="footer-social">
          <p class="social-label">Follow @digisoneglobal</p>
          <div class="social-row">
            {socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="social-btn"
                aria-label={s.label}
                title={s.label}
              >
                <Fragment set:html={s.icon} />
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p class="copyright">
        © {year} DigiSone Global. All rights reserved.
      </p>
      <div class="legal-links">
        <a href="/privacy">Privacy</a>
        <span class="dot" aria-hidden="true">·</span>
        <a href="/terms">Terms</a>
        <span class="dot" aria-hidden="true">·</span>
        <a href="/contact">Contact</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    background: linear-gradient(180deg, #0b1220 0%, #0f172a 50%, #0b1220 100%);
    color: rgba(255, 255, 255, 0.88);
    position: relative;
    overflow: hidden;
  }

  .site-footer::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(37, 99, 235, 0.45),
      rgba(99, 102, 241, 0.45),
      transparent
    );
  }

  .site-footer::after {
    content: "";
    position: absolute;
    top: -30%;
    right: -10%;
    width: 50%;
    height: 60%;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.12), transparent 70%);
    pointer-events: none;
  }

  .footer-inner {
    position: relative;
    z-index: 1;
    max-width: 1240px;
    margin: 0 auto;
    padding: 4rem 1.5rem 1.75rem;
  }

  /* ——— Grid ——— */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.9fr 1.1fr 1.2fr;
    gap: 2.5rem 2rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* ——— Brand ——— */
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: white;
    margin-bottom: 1.15rem;
  }

  .logo-mark {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: linear-gradient(135deg, #2563eb 0%, #6366f1 55%, #8b5cf6 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.12) inset,
      0 8px 20px rgba(37, 99, 235, 0.35);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .footer-logo:hover .logo-mark {
    transform: scale(1.06) rotate(-3deg);
  }

  .logo-mark-inner {
    color: white;
    font-family: "Space Grotesk", "Inter", system-ui, sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .logo-text {
    font-family: "Space Grotesk", "Inter", system-ui, sans-serif;
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.03em;
  }

  .logo-accent {
    background: linear-gradient(120deg, #60a5fa, #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .brand-desc {
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.55);
    max-width: 300px;
    margin: 0 0 1.25rem;
  }

  .footer-email {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #93c5fd;
    text-decoration: none;
    transition: color 0.2s ease, gap 0.25s ease;
  }

  .footer-email:hover {
    color: #bfdbfe;
    gap: 0.65rem;
  }

  .email-icon {
    font-size: 0.95rem;
  }

  /* ——— Columns ——— */
  .footer-heading {
    font-family: "Space Grotesk", "Inter", system-ui, sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.4);
    margin: 0 0 1.15rem;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-links a {
    font-size: 0.95rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .footer-links a:hover {
    color: white;
    transform: translateX(3px);
  }

  /* ——— CTA col ——— */
  .cta-text {
    font-size: 0.92rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.55);
    margin: 0 0 1.15rem;
  }

  .footer-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 1.25rem;
    border-radius: 12px;
    font-size: 0.9rem;
    font-weight: 600;
    background: white;
    color: #0b1220;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.25s ease;
  }

  .footer-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
  }

  .footer-social {
    margin-top: 1.75rem;
  }

  .social-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.4);
    margin: 0 0 0.75rem;
  }

  .social-row {
    display: flex;
    gap: 0.45rem;
  }

  .social-btn {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.65);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      color 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease,
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .social-btn:hover {
    color: white;
    background: rgba(37, 99, 235, 0.25);
    border-color: rgba(37, 99, 235, 0.35);
    transform: translateY(-2px);
  }

  /* ——— Bottom ——— */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
  }

  .copyright {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.4);
    margin: 0;
  }

  .legal-links {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.85rem;
  }

  .legal-links a {
    color: rgba(255, 255, 255, 0.45);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .legal-links a:hover {
    color: rgba(255, 255, 255, 0.85);
  }

  .legal-links .dot {
    color: rgba(255, 255, 255, 0.25);
  }

  /* ——— Responsive ——— */
  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.25rem 1.75rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .footer-inner {
      padding: 3rem 1.15rem 1.5rem;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-bottom: 2.25rem;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .brand-desc {
      max-width: none;
    }
  }
</style>
