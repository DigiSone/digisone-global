---
// src/pages/donate.astro
import Layout from '../layouts/Layout.astro'; // adjust path if your layout is different
---

<Layout title="Donate — DigiSone Global" description="Support independent digital insights and research at DigiSone Global.">
  <main class="donate-page">
    <!-- Hero -->
    <section class="hero">
      <div class="container">
        <div class="hero-badge">Support Independent Work</div>
        <h1>
          Help us keep <span class="gradient-text">DigiSone Global</span> free & independent
        </h1>
        <p class="hero-sub">
          Your contribution directly funds research, writing, tools, and the time it takes to bring
          clear digital insights to thousands of readers every month.
        </p>
      </div>
    </section>

    <!-- Main Content -->
    <section class="content">
      <div class="container grid">
        <!-- Left: Why Donate -->
        <div class="why">
          <h2>Where your support goes</h2>
          <ul class="impact-list">
            <li>
              <div class="icon">🔍</div>
              <div>
                <strong>Independent Research</strong>
                <span>Deep-dive articles and analysis free from ads and sponsored bias.</span>
              </div>
            </li>
            <li>
              <div class="icon">✍️</div>
              <div>
                <strong>Quality Writing & Editing</strong>
                <span>Hours spent researching, writing, and refining every piece.</span>
              </div>
            </li>
            <li>
              <div class="icon">🛠️</div>
              <div>
                <strong>Tools & Infrastructure</strong>
                <span>Hosting, newsletters, analytics, and the tech that keeps the site running.</span>
              </div>
            </li>
            <li>
              <div class="icon">🌍</div>
              <div>
                <strong>Growing the Community</strong>
                <span>Reaching more readers who care about thoughtful digital content.</span>
              </div>
            </li>
          </ul>

          <div class="note">
            <strong>100% independent.</strong> We don’t run ads or accept paid placements that
            compromise editorial integrity. Your support is what makes this possible.
          </div>
        </div>

        <!-- Right: Donation Card -->
        <div class="donate-card">
          <div class="card-header">
            <h3>Make a Contribution</h3>
            <p>Choose an amount or enter your own. Every bit helps.</p>
          </div>

          <div class="amount-grid">
            <button class="amount-btn" data-amount="5">₹500</button>
            <button class="amount-btn" data-amount="10">₹1,000</button>
            <button class="amount-btn active" data-amount="25">₹2,500</button>
            <button class="amount-btn" data-amount="50">₹5,000</button>
          </div>

          <div class="custom-amount">
            <label for="custom">Or enter a custom amount (₹)</label>
            <div class="input-wrap">
              <span>₹</span>
              <input type="number" id="custom" placeholder="Enter amount" min="100" />
            </div>
          </div>

          <div class="freq">
            <label class="radio">
              <input type="radio" name="freq" value="once" checked />
              <span>One-time</span>
            </label>
            <label class="radio">
              <input type="radio" name="freq" value="monthly" />
              <span>Monthly</span>
            </label>
          </div>

          <!-- Replace these hrefs with your real payment links -->
          <a href="https://razorpay.me/your-link" class="btn-primary" id="donate-btn">
            Donate ₹2,500
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>

          <p class="secure">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2"/>
            </svg>
            Secure payment • Instant confirmation
          </p>

          <div class="alt-methods">
            <p>Prefer another way?</p>
            <div class="alt-links">
              <a href="mailto:hello@digisoneglobal.com">Email us</a>
              <span>•</span>
              <a href="https://paypal.me/yourhandle" target="_blank" rel="noopener">PayPal</a>
              <span>•</span>
              <a href="/contact">Contact</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Thank You Strip -->
    <section class="thanks">
      <div class="container">
        <p>
          Already a supporter? <strong>Thank you.</strong> You make this work possible.
        </p>
      </div>
    </section>
  </main>
</Layout>

<style>
  .donate-page {
    --blue: #2563eb;
    --blue-dark: #1d4ed8;
    --purple: #6366f1;
    --rose: #e11d48;
    --slate-900: #0b1220;
    --slate-600: #475569;
    --slate-500: #64748b;
    --slate-400: #94a3b8;
    --slate-100: #f1f5f9;
    --white: #ffffff;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Hero */
  .hero {
    padding: 5.5rem 0 4rem;
    text-align: center;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  }

  .hero-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--blue);
    background: rgba(37, 99, 235, 0.08);
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }

  .hero h1 {
    font-family: "Space Grotesk", "Inter", system-ui, sans-serif;
    font-size: clamp(2rem, 5vw, 2.85rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--slate-900);
    line-height: 1.2;
    max-width: 720px;
    margin: 0 auto 1.25rem;
  }

  .gradient-text {
    background: linear-gradient(120deg, var(--blue), var(--purple));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-sub {
    font-size: 1.1rem;
    color: var(--slate-600);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.65;
  }

  /* Content Grid */
  .content {
    padding: 2rem 0 5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
      align-items: start;
    }
  }

  /* Why section */
  .why h2 {
    font-family: "Space Grotesk", "Inter", system-ui, sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--slate-900);
    margin: 0 0 1.75rem;
    letter-spacing: -0.02em;
  }

  .impact-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .impact-list li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .impact-list .icon {
    font-size: 1.35rem;
    line-height: 1;
    flex-shrink: 0;
    width: 2.4rem;
    height: 2.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f1f5f9;
    border-radius: 10px;
  }

  .impact-list strong {
    display: block;
    font-size: 1rem;
    color: var(--slate-900);
    margin-bottom: 0.2rem;
  }

  .impact-list span {
    font-size: 0.92rem;
    color: var(--slate-500);
    line-height: 1.5;
  }

  .note {
    background: #f8fafc;
    border: 1px solid rgba(15, 23, 42, 0.06);
    border-radius: 14px;
    padding: 1.15rem 1.25rem;
    font-size: 0.92rem;
    color: var(--slate-600);
    line-height: 1.55;
  }

  .note strong {
    color: var(--slate-900);
  }

  /* Donation Card */
  .donate-card {
    background: white;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 20px;
    padding: 2rem;
    box-shadow:
      0 4px 6px -1px rgba(15, 23, 42, 0.04),
      0 20px 40px -12px rgba(15, 23, 42, 0.08);
  }

  .card-header {
    margin-bottom: 1.75rem;
  }

  .card-header h3 {
    font-family: "Space Grotesk", "Inter", system-ui, sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--slate-900);
    margin: 0 0 0.35rem;
    letter-spacing: -0.02em;
  }

  .card-header p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--slate-500);
  }

  .amount-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
  }

  .amount-btn {
    padding: 0.85rem;
    border-radius: 12px;
    border: 1.5px solid rgba(15, 23, 42, 0.1);
    background: white;
    font-size: 1rem;
    font-weight: 600;
    color: var(--slate-600);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .amount-btn:hover {
    border-color: var(--blue);
    color: var(--blue);
  }

  .amount-btn.active {
    background: rgba(37, 99, 235, 0.08);
    border-color: var(--blue);
    color: var(--blue);
    box-shadow: 0 0 0 1px var(--blue);
  }

  .custom-amount {
    margin-bottom: 1.5rem;
  }

  .custom-amount label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--slate-500);
    margin-bottom: 0.45rem;
  }

  .input-wrap {
    display: flex;
    align-items: center;
    border: 1.5px solid rgba(15, 23, 42, 0.12);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .input-wrap:focus-within {
    border-color: var(--blue);
  }

  .input-wrap span {
    padding: 0 0.9rem;
    font-weight: 600;
    color: var(--slate-500);
    background: #f8fafc;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .input-wrap input {
    flex: 1;
    border: none;
    padding: 0.85rem 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--slate-900);
    outline: none;
    background: transparent;
  }

  .freq {
    display: flex;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .radio {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--slate-600);
    cursor: pointer;
  }

  .radio input {
    accent-color: var(--blue);
    width: 1.05rem;
    height: 1.05rem;
  }

  .btn-primary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 1rem 1.5rem;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
    color: white;
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.12) inset,
      0 8px 24px rgba(37, 99, 235, 0.35);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.18) inset,
      0 12px 32px rgba(37, 99, 235, 0.45);
  }

  .secure {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin: 1rem 0 0;
    font-size: 0.8rem;
    color: var(--slate-400);
  }

  .secure svg {
    color: #10b981;
  }

  .alt-methods {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(15, 23, 42, 0.06);
    text-align: center;
  }

  .alt-methods p {
    font-size: 0.85rem;
    color: var(--slate-500);
    margin: 0 0 0.5rem;
  }

  .alt-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .alt-links a {
    color: var(--blue);
    text-decoration: none;
  }

  .alt-links a:hover {
    text-decoration: underline;
  }

  .alt-links span {
    color: var(--slate-400);
  }

  /* Thanks strip */
  .thanks {
    background: #f8fafc;
    border-top: 1px solid rgba(15, 23, 42, 0.06);
    padding: 1.75rem 0;
    text-align: center;
  }

  .thanks p {
    margin: 0;
    font-size: 1rem;
    color: var(--slate-600);
  }

  .thanks strong {
    color: var(--slate-900);
  }
</style>

<script>
  const amountBtns = document.querySelectorAll('.amount-btn');
  const customInput = document.getElementById('custom') as HTMLInputElement;
  const donateBtn = document.getElementById('donate-btn') as HTMLAnchorElement;

  let selectedAmount = 2500;

  function updateButton(amount: number) {
    selectedAmount = amount;
    donateBtn.innerHTML = `
      Donate ₹${amount.toLocaleString('en-IN')}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    `;
  }

  amountBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      amountBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      customInput.value = '';
      const amount = Number(btn.getAttribute('data-amount')) * 100; // converting demo units
      // Actually using the displayed values
      const text = btn.textContent?.replace('₹', '').replace(',', '') || '2500';
      updateButton(Number(text));
    });
  });

  customInput?.addEventListener('input', () => {
    amountBtns.forEach((b) => b.classList.remove('active'));
    const val = Number(customInput.value);
    if (val >= 100) {
      updateButton(val);
    }
  });
</script>
