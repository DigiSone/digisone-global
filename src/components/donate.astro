---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Donate — DigiSone Global";
const description = "Support independent research and writing at DigiSone Global. Multiple payment options available worldwide.";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header />

    <main class="donate-page">
      <!-- Hero -->
      <section class="hero">
        <div class="container">
          <div class="hero-badge">Support Independent Work</div>
          <h1>
            Help keep <span class="gradient-text">DigiSone Global</span> independent
          </h1>
          <p class="hero-sub">
            Your contribution funds research, writing, tools, and the time it takes to publish
            clear digital insights every month. Multiple payment methods available.
          </p>
        </div>
      </section>

      <!-- Content -->
      <section class="content">
        <div class="container grid">
          <!-- Left: Why -->
          <div class="why">
            <h2>Where your support goes</h2>
            <ul class="impact-list">
              <li>
                <div class="icon">🔍</div>
                <div>
                  <strong>Independent Research</strong>
                  <span>Deep analysis without ads or sponsored bias.</span>
                </div>
              </li>
              <li>
                <div class="icon">✍️</div>
                <div>
                  <strong>Quality Writing</strong>
                  <span>Time spent researching, writing, and editing every piece.</span>
                </div>
              </li>
              <li>
                <div class="icon">🛠️</div>
                <div>
                  <strong>Tools & Infrastructure</strong>
                  <span>Hosting, newsletters, analytics, and site operations.</span>
                </div>
              </li>
              <li>
                <div class="icon">🌍</div>
                <div>
                  <strong>Growing Reach</strong>
                  <span>Helping more readers access thoughtful digital content.</span>
                </div>
              </li>
            </ul>

            <div class="note">
              <strong>100% independent.</strong> We don’t run ads or accept paid placements that
              compromise editorial integrity. Your support makes this possible.
            </div>
          </div>

          <!-- Right: Donate Card -->
          <div class="donate-card">
            <div class="card-header">
              <h3>Make a Contribution</h3>
              <p>Choose an amount, then select your preferred payment method.</p>
            </div>

            <!-- Amount -->
            <div class="amount-grid">
              <button type="button" class="amount-btn" data-amount="500">₹500</button>
              <button type="button" class="amount-btn" data-amount="1000">₹1,000</button>
              <button type="button" class="amount-btn active" data-amount="2500">₹2,500</button>
              <button type="button" class="amount-btn" data-amount="5000">₹5,000</button>
            </div>

            <div class="custom-amount">
              <label for="custom">Custom amount</label>
              <div class="input-wrap">
                <span class="currency">₹</span>
                <input type="number" id="custom" placeholder="Enter amount" min="100" />
              </div>
            </div>

            <!-- Popular Methods -->
            <div class="method-section">
              <p class="method-title">Popular methods</p>
              <div class="method-grid primary">
                <a href="YOUR_RAZORPAY_LINK" class="method-card featured" id="main-donate-link">
                  <span class="method-icon">🇮🇳</span>
                  <div>
                    <strong>UPI / GPay / PhonePe</strong>
                    <span>Instant • India</span>
                  </div>
                </a>

                <a href="YOUR_PAYPAL_LINK" target="_blank" rel="noopener" class="method-card">
                  <span class="method-icon">🔵</span>
                  <div>
                    <strong>PayPal</strong>
                    <span>International</span>
                  </div>
                </a>

                <a href="YOUR_STRIPE_LINK" target="_blank" rel="noopener" class="method-card">
                  <span class="method-icon">💳</span>
                  <div>
                    <strong>Card / Stripe</strong>
                    <span>Visa, Mastercard</span>
                  </div>
                </a>

                <a href="YOUR_KOFI_LINK" target="_blank" rel="noopener" class="method-card">
                  <span class="method-icon">☕</span>
                  <div>
                    <strong>Ko-fi</strong>
                    <span>One-time support</span>
                  </div>
                </a>
              </div>
            </div>

            <!-- More Methods -->
            <div class="method-section">
              <p class="method-title">More ways</p>
              <div class="method-grid secondary">
                <a href="YOUR_PAYONEER_LINK" target="_blank" rel="noopener" class="method-card small">
                  <strong>Payoneer</strong>
                </a>
                <a href="#bank-details" class="method-card small">
                  <strong>Bank Transfer</strong>
                </a>
                <a href="mailto:hello@digisoneglobal.com?subject=Donation%20Support" class="method-card small">
                  <strong>Email Us</strong>
                </a>
              </div>
            </div>

            <!-- Crypto -->
            <div class="method-section">
              <p class="method-title">Crypto</p>
              <div class="crypto-list">
                <div class="crypto-item">
                  <div class="crypto-left">
                    <span class="crypto-badge btc">BTC</span>
                    <code class="crypto-address" id="btc-address">YOUR_BTC_ADDRESS</code>
                  </div>
                  <button type="button" class="copy-btn" data-copy="btc-address">Copy</button>
                </div>

                <div class="crypto-item">
                  <div class="crypto-left">
                    <span class="crypto-badge eth">ETH</span>
                    <code class="crypto-address" id="eth-address">YOUR_ETH_ADDRESS</code>
                  </div>
                  <button type="button" class="copy-btn" data-copy="eth-address">Copy</button>
                </div>

                <div class="crypto-item">
                  <div class="crypto-left">
                    <span class="crypto-badge sol">SOL</span>
                    <code class="crypto-address" id="sol-address">YOUR_SOL_ADDRESS</code>
                  </div>
                  <button type="button" class="copy-btn" data-copy="sol-address">Copy</button>
                </div>

                <div class="crypto-item">
                  <div class="crypto-left">
                    <span class="crypto-badge bnb">BNB</span>
                    <code class="crypto-address" id="bnb-address">YOUR_BNB_ADDRESS</code>
                  </div>
                  <button type="button" class="copy-btn" data-copy="bnb-address">Copy</button>
                </div>
              </div>
            </div>

            <!-- Bank -->
            <div class="method-section bank-box" id="bank-details">
              <p class="method-title">Bank Transfer</p>
              <div class="bank-details">
                <p><strong>Account Name:</strong> Your Name / DigiSone Global</p>
                <p><strong>Account Number:</strong> XXXX XXXX XXXX</p>
                <p><strong>IFSC:</strong> XXXX0000000</p>
                <p><strong>Bank:</strong> Your Bank Name</p>
                <p class="bank-note">After transfer, please email the receipt for confirmation.</p>
              </div>
            </div>

            <p class="secure">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2"/>
              </svg>
              Multiple secure options • Choose what works for you
            </p>
          </div>
        </div>
      </section>

      <!-- Thanks -->
      <section class="thanks">
        <div class="container">
          <p>Already a supporter? <strong>Thank you.</strong> You make this work possible.</p>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .donate-page {
    --blue: #2563eb;
    --blue-dark: #1d4ed8;
    --purple: #6366f1;
    --text: #0b1220;
    --muted: #64748b;
    --border: #e2e8f0;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  /* Hero */
  .hero {
    padding: 4.5rem 0 3.25rem;
    text-align: center;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  }

  .hero-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--blue);
    background: rgba(37, 99, 235, 0.08);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    margin-bottom: 1.1rem;
  }

  .hero h1 {
    font-family: "Space Grotesk", "Inter", system-ui, sans-serif;
    font-size: clamp(1.85rem, 4.5vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text);
    line-height: 1.2;
    max-width: 680px;
    margin: 0 auto 1rem;
  }

  .gradient-text {
    background: linear-gradient(120deg, var(--blue), var(--purple));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-sub {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 540px;
    margin: 0 auto;
    line-height: 1.65;
  }

  /* Grid */
  .content {
    padding: 1.5rem 0 4.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 3.5rem;
      align-items: start;
    }
  }

  /* Why */
  .why h2 {
    font-family: "Space Grotesk", "Inter", system-ui, sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 1.5rem;
  }

  .impact-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .impact-list li {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }

  .impact-list .icon {
    width: 2.2rem;
    height: 2.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f1f5f9;
    border-radius: 9px;
    font-size: 1.15rem;
    flex-shrink: 0;
  }

  .impact-list strong {
    display: block;
    font-size: 0.95rem;
    color: var(--text);
    margin-bottom: 0.15rem;
  }

  .impact-list span {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.45;
  }

  .note {
    background: #f8fafc;
    border: 1px solid rgba(15, 23, 42, 0.06);
    border-radius: 12px;
    padding: 1rem 1.15rem;
    font-size: 0.9rem;
    color: #475569;
    line-height: 1.55;
  }

  .note strong {
    color: var(--text);
  }

  /* Card */
  .donate-card {
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 18px;
    padding: 1.6rem 1.35rem;
    box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.04), 0 14px 36px -10px rgba(15, 23, 42, 0.08);
  }

  .card-header {
    margin-bottom: 1.35rem;
  }

  .card-header h3 {
    font-family: "Space Grotesk", "Inter", system-ui, sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 0.3rem;
  }

  .card-header p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--muted);
  }

  /* Amount */
  .amount-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.55rem;
    margin-bottom: 1.1rem;
  }

  .amount-btn {
    padding: 0.75rem 0.5rem;
    border-radius: 10px;
    border: 1.5px solid var(--border);
    background: #fff;
    font-size: 0.92rem;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .amount-btn:hover {
    border-color: var(--blue);
    color: var(--blue);
  }

  .amount-btn.active {
    background: #eff6ff;
    border-color: var(--blue);
    color: var(--blue);
    box-shadow: 0 0 0 1px var(--blue);
  }

  .custom-amount {
    margin-bottom: 1.35rem;
  }

  .custom-amount label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 0.35rem;
  }

  .input-wrap {
    display: flex;
    align-items: center;
    border: 1.5px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
  }

  .input-wrap:focus-within {
    border-color: var(--blue);
  }

  .input-wrap .currency {
    padding: 0 0.8rem;
    font-weight: 600;
    color: var(--muted);
    background: #f8fafc;
    font-size: 0.92rem;
  }

  .input-wrap input {
    flex: 1;
    border: none;
    padding: 0.75rem 0.85rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
    outline: none;
    background: transparent;
    min-width: 0;
  }

  /* Methods */
  .method-section {
    margin-top: 1.25rem;
  }

  .method-title {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #94a3b8;
    margin: 0 0 0.6rem;
  }

  .method-grid {
    display: grid;
    gap: 0.5rem;
  }

  .method-grid.primary {
    grid-template-columns: 1fr;
  }

  @media (min-width: 480px) {
    .method-grid.primary {
      grid-template-columns: 1fr 1fr;
    }
  }

  .method-grid.secondary {
    grid-template-columns: repeat(3, 1fr);
  }

  .method-card {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.8rem 0.9rem;
    border-radius: 11px;
    background: #f8fafc;
    border: 1px solid var(--border);
    text-decoration: none;
    color: var(--text);
    transition: all 0.15s ease;
  }

  .method-card:hover {
    background: #eff6ff;
    border-color: #bfdbfe;
  }

  .method-card.featured {
    background: linear-gradient(135deg, #eff6ff, #f0f9ff);
    border-color: #bfdbfe;
  }

  .method-card.small {
    justify-content: center;
    padding: 0.65rem 0.4rem;
    font-size: 0.82rem;
  }

  .method-icon {
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .method-card strong {
    display: block;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .method-card span {
    display: block;
    font-size: 0.72rem;
    color: var(--muted);
    margin-top: 0.1rem;
  }

  /* Crypto */
  .crypto-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .crypto-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.65rem 0.8rem;
    background: #f8fafc;
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  .crypto-left {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
  }

  .crypto-badge {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.18rem 0.4rem;
    border-radius: 5px;
    color: white;
    flex-shrink: 0;
  }

  .crypto-badge.btc { background: #f59e0b; }
  .crypto-badge.eth { background: #6366f1; }
  .crypto-badge.sol { background: #14b8a6; }
  .crypto-badge.bnb { background: #eab308; color: #0f172a; }

  .crypto-address {
    font-size: 0.72rem;
    color: #475569;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 150px;
  }

  .copy-btn {
    flex-shrink: 0;
    padding: 0.32rem 0.65rem;
    font-size: 0.72rem;
    font-weight: 600;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: white;
    color: var(--blue);
    cursor: pointer;
  }

  .copy-btn:hover {
    background: #eff6ff;
  }

  /* Bank */
  .bank-box {
    padding-top: 0.25rem;
  }

  .bank-details {
    background: #f8fafc;
    border: 1px solid var(--border);
    border-radius: 11px;
    padding: 0.95rem 1rem;
    font-size: 0.86rem;
    color: #334155;
    line-height: 1.65;
  }

  .bank-details p {
    margin: 0 0 0.3rem;
  }

  .bank-note {
    margin-top: 0.5rem !important;
    font-size: 0.78rem;
    color: var(--muted);
  }

  .secure {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    margin: 1.25rem 0 0;
    font-size: 0.76rem;
    color: #94a3b8;
  }

  .secure svg {
    color: #10b981;
    flex-shrink: 0;
  }

  /* Thanks */
  .thanks {
    background: #f8fafc;
    border-top: 1px solid rgba(15, 23, 42, 0.06);
    padding: 1.5rem 0;
    text-align: center;
  }

  .thanks p {
    margin: 0;
    font-size: 0.95rem;
    color: #475569;
  }

  .thanks strong {
    color: var(--text);
  }
</style>

<script>
  // Amount buttons
  const amountBtns = document.querySelectorAll('.amount-btn');
  const customInput = document.getElementById('custom');

  amountBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      amountBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      if (customInput) customInput.value = '';
    });
  });

  if (customInput) {
    customInput.addEventListener('input', () => {
      amountBtns.forEach((b) => b.classList.remove('active'));
    });
  }

  // Copy crypto addresses
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-copy');
      const el = document.getElementById(id);
      if (!el) return;

      try {
        await navigator.clipboard.writeText(el.textContent.trim());
        const original = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => {
          btn.textContent = original || 'Copy';
        }, 1500);
      } catch {
        btn.textContent = 'Error';
        setTimeout(() => {
          btn.textContent = 'Copy';
        }, 1500);
      }
    });
  });
</script>
