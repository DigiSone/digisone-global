---
// Global head used by every page via <BaseHead />
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage } = Astro.props;

// IDs
const GA_ID = 'G-H0KPNYR03Q';
// AdSense client — approval ke baad fill karo (example: ca-pub-xxxxxxxxxxxxxxxx)
const ADSENSE_CLIENT = ''; // e.g. 'ca-pub-1234567890123456'
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#2563eb" />

<!-- Icons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/favicon.ico" />

<!-- Sitemap & RSS -->
<link rel="sitemap" href="/sitemap-0.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>

<!-- Performance: third-party origins -->
<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
<link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
<link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />

<!-- Fonts -->
<Font cssVariable="--font-atkinson" preload />

<!-- Canonical -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="DigiSone Global" />
<meta name="robots" content="index, follow" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image.src, Astro.url)} />


<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "DigiSone Global",
  "url": "https://digisone.com",
  "description": "Premium insights on AI, business strategy, startups and technology",
  "publisher": {
    "@type": "Organization",
    "name": "DigiSone Global"
  }
}
</script>




<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "DigiSone Global",
  "url": "https://digisone.com",
  "logo": "https://digisone.com/favicon.svg",
  "sameAs": [
    "https://x.com/digisoneglobal",
    "https://youtube.com/@digisoneglobal",
    "https://linkedin.com/company/digisoneglobal"
  ]
}
</script>



<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "How to make money online in 2027?",
  "datePublished": "2026-08-04",
  "author": {
    "@type": "Person",
    "name": "Vikas Mishra"
  },
  "publisher": {
    "@type": "Organization",
    "name": "DigiSone Global"
  }
}
</script>




<!--
  Google Consent Mode v2 — DEFAULT DENIED (must run before GA / Ads)
  CookieConsent.astro later calls consent update on Accept / Save
-->
<script is:inline>
	window.dataLayer = window.dataLayer || [];
	function gtag() {
		dataLayer.push(arguments);
	}
	window.gtag = gtag;

	gtag('consent', 'default', {
		ad_storage: 'denied',
		ad_user_data: 'denied',
		ad_personalization: 'denied',
		analytics_storage: 'denied',
		functionality_storage: 'granted',
		security_storage: 'granted',
		wait_for_update: 500,
	});
</script>

<!-- Google Analytics 4 — only if user allowed Analytics -->
<script is:inline define:vars={{ GA_ID }}>
	window.dataLayer = window.dataLayer || [];
	function gtag() {
		dataLayer.push(arguments);
	}
	window.gtag = window.gtag || gtag;

	function loadGA() {
		if (window.__gaLoaded) return;
		window.__gaLoaded = true;

		var s = document.createElement('script');
		s.async = true;
		s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
		s.onload = function () {
			gtag('js', new Date());
			gtag('config', GA_ID, { anonymize_ip: true });
		};
		document.head.appendChild(s);
	}

	function consentAllowsAnalytics() {
		try {
			var raw = localStorage.getItem('digisone_consent_v1');
			if (!raw) return false;
			var state = JSON.parse(raw);
			return !!(state && state.analytics);
		} catch (e) {
			return false;
		}
	}

	function tryLoadGA() {
		if (consentAllowsAnalytics()) loadGA();
	}

	// After first paint / idle — still respects consent
	if ('requestIdleCallback' in window) {
		requestIdleCallback(tryLoadGA, { timeout: 4000 });
	} else {
		window.addEventListener('load', function () {
			setTimeout(tryLoadGA, 1500);
		});
	}

	// When banner Accept / Save fires
	window.addEventListener('digisone-consent', function (e) {
		if (e.detail && e.detail.analytics) loadGA();
	});
</script>



<script src="https://analytics.ahrefs.com/analytics.js" data-key="IpgHlp1RhUS/P9SD3Wdweg" async></script>






<!--
  Google AdSense — ONLY after approval + fill ADSENSE_CLIENT
  Loads when advertising consent is granted (or you can always load
  non-personalized path later with Consent Mode)
-->
{
	ADSENSE_CLIENT && (
		<script is:inline define:vars={{ ADSENSE_CLIENT }}>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			window.gtag = window.gtag || gtag;

			function loadAds() {
				if (window.__adsLoaded) return;
				window.__adsLoaded = true;
				var s = document.createElement('script');
				s.async = true;
				s.src =
					'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' +
					ADSENSE_CLIENT;
				s.crossOrigin = 'anonymous';
				document.head.appendChild(s);
			}

			function consentAllowsAds() {
				try {
					var raw = localStorage.getItem('digisone_consent_v1');
					if (!raw) return false;
					var state = JSON.parse(raw);
					return !!(state && state.advertising);
				} catch (e) {
					return false;
				}
			}

			function tryLoadAds() {
				if (consentAllowsAds()) loadAds();
			}

			tryLoadAds();
			window.addEventListener('digisone-consent', function (e) {
				if (e.detail && e.detail.advertising) loadAds();
			});
		</script>
	)
}
