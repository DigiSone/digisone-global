<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			:root {
				--bg: #f1f5f9;
				--surface: #fff;
				--text: #0b1220;
				--muted: #475569;
				--primary: #2563eb;
				--border: rgba(15, 23, 42, 0.08);
				--radius: 1rem;
				--font: system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
			}
			* { box-sizing: border-box; }
			body {
				margin: 0;
				font-family: var(--font);
				background: var(--bg);
				color: var(--text);
				line-height: 1.6;
			}
			main {
				width: min(100% - 2rem, 56rem);
				margin-inline: auto;
				padding: 2.5rem 0 4rem;
			}
			h1 {
				font-size: clamp(1.85rem, 4vw, 2.6rem);
				letter-spacing: -0.03em;
				margin: 0 0 0.6rem;
			}
			.lead { color: var(--muted); margin: 0 0 1.25rem; font-size: 1.05rem; }
			.note {
				background: #eff6ff;
				border: 1px solid #bfdbfe;
				color: #1e3a8a;
				padding: 0.9rem 1rem;
				border-radius: var(--radius);
				font-size: 0.9rem;
				margin-bottom: 1.75rem;
			}
			.toc {
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 1rem 1.15rem;
				margin-bottom: 2rem;
			}
			.toc strong { display: block; margin-bottom: 0.5rem; }
			.toc-links { display: flex; flex-wrap: wrap; gap: 0.45rem; }
			.toc-links a {
				font-size: 0.8rem;
				font-weight: 600;
				padding: 0.3rem 0.65rem;
				border-radius: 999px;
				background: #f8fafc;
				border: 1px solid var(--border);
				color: var(--text);
				text-decoration: none;
			}
			.toc-links a:hover { color: var(--primary); border-color: #93c5fd; }
			section.cat { margin: 2.75rem 0; scroll-margin-top: 5rem; }
			section.cat h2 {
				font-size: 1.45rem;
				margin: 0 0 0.4rem;
				letter-spacing: -0.02em;
			}
			.cat-intro { color: var(--muted); margin: 0 0 1.1rem; }
			.sub { margin: 1.35rem 0 0.5rem; font-size: 1.05rem; }
			.tools { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.65rem; }
			.tool {
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 0.95rem 1rem;
			}
			.tool-top {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.45rem 0.65rem;
				margin-bottom: 0.3rem;
			}
			.tool a.name {
				font-weight: 700;
				color: var(--primary);
				text-decoration: none;
			}
			.tool a.name:hover { text-decoration: underline; }
			.badge {
				font-size: 0.68rem;
				font-weight: 700;
				padding: 0.15rem 0.45rem;
				border-radius: 999px;
				background: #f1f5f9;
				color: var(--muted);
				border: 1px solid var(--border);
			}
			.badge.os { background: #ecfdf5; color: #065f46; border-color: #a7f3d0; }
			.badge.free { background: #eff6ff; color: #1d4ed8; border-color: #bfdbfe; }
			.badge.paid { background: #fff7ed; color: #c2410c; border-color: #fed7aa; }
			.badge.freemium { background: #f5f3ff; color: #5b21b6; border-color: #ddd6fe; }
			.blurb { margin: 0; font-size: 0.9rem; color: var(--text); }
			.access { margin: 0.35rem 0 0; font-size: 0.8rem; color: var(--muted); }
			.disclaimer {
				margin-top: 2.5rem;
				font-size: 0.85rem;
				color: var(--muted);
				padding: 1rem;
				border: 1px solid var(--border);
				border-radius: var(--radius);
				background: var(--surface);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Resources & tools directory</h1>
			<p class="lead">
				Curated AI, testing, SEO, IDE, social, video, converter and image tools — with official links,
				pricing labels and device notes. Built for builders and operators.
			</p>
			<p class="note">
				This is a living shortlist, not every tool on the internet. Always verify licenses, privacy
				policies and pricing on the official site before use. DigiSone Global is not affiliated with
				these products unless stated.
			</p>

			<nav class="toc" aria-label="Categories">
				<strong>Jump to category</strong>
				<div class="toc-links">
					{categories.map((c) => (
						<a href={`#${c.id}`}>{c.title}</a>
					))}
				</div>
			</nav>

			{categories.map((cat) => (
				<section class="cat" id={cat.id}>
					<h2>{cat.title}</h2>
					<p class="cat-intro">{cat.intro}</p>
					{cat.subs.map((sub) => (
						<>
							<h3 class="sub">{sub.name}</h3>
							<ul class="tools">
								{sub.tools.map((t) => (
									<li class="tool">
										<div class="tool-top">
											<a class="name" href={t.url} target="_blank" rel="noopener noreferrer">
												{t.name}
											</a>
											<span
												class:list={[
													'badge',
													t.type === 'Open Source' && 'os',
													t.type === 'Free' && 'free',
													t.type === 'Paid' && 'paid',
													t.type === 'Freemium' && 'freemium',
												]}
											>
												{t.type}
											</span>
										</div>
										<p class="blurb">{t.blurb}</p>
										<p class="access">
											<strong>Access:</strong> {t.access}
										</p>
									</li>
								))}
							</ul>
						</>
					))}
				</section>
			))}

			<p class="disclaimer">
				<strong>Disclaimer:</strong> Tool status (free/paid/open source) can change. “Access” describes
				typical clients, not a full accessibility audit of each product. For product accessibility
				conformance, check each vendor’s VPAT/ACR or documentation. Suggestions:
				<a href="mailto:info@digisone.com">info@digisone.com</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
