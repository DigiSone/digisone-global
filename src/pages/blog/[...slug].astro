---
import { sanityClient } from 'sanity:client';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
    const posts = await sanityClient.fetch(`
        *[_type == "post" && defined(slug.current)] {
                "slug": slug.current
        }
          `);

            return posts.map((post: { slug: string }) => ({
                  params: { slug: post.slug },
            }));
}

const { slug } = Astro.params;

const post = await sanityClient.fetch(`
  *[_type == "post" && slug.current == $slug][0] {
        title,
            excerpt,
                body,
                    publishedAt,
                        "imageUrl": mainImage.asset->url,
                            "authorName": author->name
  }
  `, { slug });

  if (!post) {
      return Astro.redirect('/404');
  }

  const pageTitle = `${post.title} — ${SITE_TITLE}`;
  ---

  <!doctype html>
  <html lang="en">
    <head>
        <BaseHead title={pageTitle} description={post.excerpt || post.title} />
            <style>
                  .post-container {
                            width: min(100% - 2rem, 720px);
                                    margin: 0 auto;
                                            padding: 2.5rem 0 5rem;
                  }
                        .post-header {
                                  margin-bottom: 2rem;
                        }
                              .post-date {
                                        color: #64748b;
                                                font-size: 0.95rem;
                                                        margin-bottom: 0.6rem;
                              }
                                    .post-title {
                                              font-size: clamp(1.9rem, 5vw, 2.7rem);
                                                      line-height: 1.2;
                                                              margin: 0 0 0.8rem;
                                                                      font-weight: 700;
                                    }
                                          .post-author {
                                                    color: #64748b;
                                                            font-size: 0.95rem;
                                          }
                                                .post-image {
                                                          width: 100%;
                                                                  border-radius: 1rem;
                                                                          margin: 1.8rem 0 2.2rem;
                                                }
                                                      .post-content {
                                                                font-size: 1.125rem;
                                                                        line-height: 1.8;
                                                                                color: #1e293b;
                                                      }
                                                            .post-content p {
                                                                      margin-bottom: 1.4rem;
                                                            }
                                                                  .back-link {
                                                                            display: inline-block;
                                                                                    margin-bottom: 2rem;
                                                                                            color: #2563eb;
                                                                                                    font-weight: 500;
                                                                                                            text-decoration: none;
                                                                  }
                                                                        .back-link:hover {
                                                                                  text-decoration: underline;
                                                                        }
                                                                            </style>
                                                                              </head>
                                                                                <body>
                                                                                    <Header />

                                                                                        <main class="post-container">
                                                                                              <a href="/blog/" class="back-link">← Back to Blog</a>

                                                                                                    <article>
                                                                                                            <header class="post-header">
                                                                                                                      <p class="post-date">
                                                                                                                                  {post.publishedAt 
                                                                                                                                                ? new Date(post.publishedAt).toLocaleDateString('en-US', {
                                                                                                                                                                    year: 'numeric',
                                                                                                                                                                                      month: 'long',
                                                                                                                                                                                                        day: 'numeric',
                                                                                                                                                })
                                                                                                                                                              : 'August 4, 2026'}
                                                                                                                                                                        </p>

                                                                                                                                                                                  <h1 class="post-title">{post.title}</h1>

                                                                                                                                                                                            {post.authorName && (
                                                                                                                                                                                                          <p class="post-author">By {post.authorName}</p>
                                                                                                                                                                                            )}
                                                                                                                                                                                                    </header>

                                                                                                                                                                                                            {post.imageUrl && (
                                                                                                                                                                                                                        <img 
                                                                                                                                                                                                                                    src={post.imageUrl} 
                                                                                                                                                                                                                                                alt={post.title} 
                                                                                                                                                                                                                                                            class="post-image"
                                                                                                                                                                                                                                                                      />
                                                                                                                                                                                                            )}

                                                                                                                                                                                                                    <div class="post-content">
                                                                                                                                                                                                                              {post.excerpt && <p><strong>{post.excerpt}</strong></p>}
                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                  <!-- Yahan baad mein Portable Text aayega -->
                                                                                                                                                                                                                                                            <p>Full article content will appear here once Portable Text is properly set up.</p>
                                                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                                                          </article>
                                                                                                                                                                                                                                                                              </main>

                                                                                                                                                                                                                                                                                  <Footer />
                                                                                                                                                                                                                                                                                    </body>
                                                                                                                                                                                                                                                                                    </html>
                                                                                                                                                                                                            )}
                                                                                                                                                                                            )}
                                                                                                                                                })}
                                                                        }
                                                                  }
                                                            }
                                                      }
                                                }
                                          }
                                    }
                              }
                        }
                  }
  }
  })
            }))
        })
}