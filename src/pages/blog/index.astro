---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function readingTime(body: string | undefined) {
	if (!body) return 1;
	const words = body.trim().split(/\s+/).filter(Boolean).length;
	return Math.max(1, Math.ceil(words / 200));
}

function getAuthor(post: (typeof posts)[number]) {
	const data = post.data as { author?: string };
	return data.author?.trim() || 'DigiSone Global';
}

const title = `Blog — ${SITE_TITLE}`;
const description =
	SITE_DESCRIPTION ||
	'Articles on AI, business strategy, cloud, cybersecurity, and the future of work from DigiSone Global.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="DigiSone Global" description="DigiSone Global delivers premium insights on Artificial Intelligence, business strategy, startups, cybersecurity, cloud, and the future of work."/>
		<style>
			:root {
				--blog-bg: #f1f5f9;
				--blog-surface: #ffffff;
				--blog-text: #0b1220;
				--blog-muted: #64748b;
				--blog-primary: #2563eb;
				--blog-border: rgba(15, 23, 42, 0.08);
				--blog-radius: 1.15rem;
			}

			.blog-page {
				width: min(100% - 2rem, 60rem);
				margin-inline: auto;
				padding: 2rem 0 4rem;
			}

			.blog-hero {
				margin-bottom: 2.25rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid var(--blog-border);
			}

			.blog-hero h1 {
				margin: 0 0 0.5rem;
				font-size: clamp(1.85rem, 4vw, 2.5rem);
				letter-spacing: -0.03em;
				line-height: 1.15;
				color: var(--blog-text);
			}

			.blog-hero p {
				margin: 0;
				max-width: 36rem;
				color: var(--blog-muted);
				font-size: 1.05rem;
				line-height: 1.65;
			}

			.blog-count {
				margin-top: 0.85rem;
				font-size: 0.88rem;
				font-weight: 600;
				color: var(--blog-muted);
			}

			.posts {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 1.25rem;
			}

			.post-card {
				background: var(--blog-surface);
				border: 1px solid var(--blog-border);
				border-radius: var(--blog-radius);
				overflow: hidden;
				transition:
					transform 0.25s ease,
					box-shadow 0.25s ease,
					border-color 0.25s ease;
			}

			.post-card:hover {
				transform: translateY(-3px);
				box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
				border-color: rgba(37, 99, 235, 0.18);
			}

			.post-card a {
				display: grid;
				grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.4fr);
				text-decoration: none;
				color: inherit;
				min-height: 100%;
			}

			.post-card.featured a {
				grid-template-columns: 1fr;
			}

			.post-thumb {
				background: #e2e8f0;
				min-height: 180px;
				aspect-ratio: 16 / 9;
			}

			.post-card.featured .post-thumb {
				min-height: 240px;
			}

			.post-thumb img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				border-radius: 0;
			}

			.post-thumb.placeholder {
				display: flex;
				align-items: center;
				justify-content: center;
				color: var(--blog-muted);
				font-size: 0.85rem;
				font-weight: 600;
				background: linear-gradient(135deg, #e2e8f0, #f1f5f9);
			}

			.post-body {
				padding: 1.25rem 1.35rem 1.4rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
				gap: 0.45rem;
			}

			.post-meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.35rem 0.75rem;
				font-size: 0.82rem;
				color: var(--blog-muted);
				font-weight: 500;
			}

			.post-meta .dot {
				width: 3px;
				height: 3px;
				border-radius: 50%;
				background: #cbd5e1;
			}

			.post-title {
				margin: 0;
				font-size: 1.2rem;
				letter-spacing: -0.02em;
				line-height: 1.3;
				color: var(--blog-text);
			}

			.post-card.featured .post-title {
				font-size: clamp(1.35rem, 3vw, 1.85rem);
			}

			.post-card:hover .post-title {
				color: var(--blog-primary);
			}

			.post-desc {
				margin: 0;
				font-size: 0.95rem;
				line-height: 1.6;
				color: var(--blog-muted);
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.post-author {
				margin-top: 0.35rem;
				font-size: 0.84rem;
				font-weight: 600;
				color: var(--blog-text);
			}

			.post-author span {
				font-weight: 500;
				color: var(--blog-muted);
			}

			.empty {
				text-align: center;
				padding: 3rem 1rem;
				color: var(--blog-muted);
				background: var(--blog-surface);
				border: 1px solid var(--blog-border);
				border-radius: var(--blog-radius);
			}

			@media (max-width: 800px) {
				.post-card a,
				.post-card.featured a {
					grid-template-columns: 1fr;
				}

				.post-thumb,
				.post-card.featured .post-thumb {
					min-height: 180px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="blog-page">
			<header class="blog-hero">
				<h1>Blog</h1>
				<p>
					Practical analysis on AI, strategy, cloud, security, and the future of work — written for
					founders, operators, and technology leaders.
				</p>
				{
					posts.length > 0 && (
						<p class="blog-count">
							{posts.length} article{posts.length === 1 ? '' : 's'}
						</p>
					)
				}
			</header>

			{
				posts.length === 0 ? (
					<div class="empty">
						<p>No articles published yet. Check back soon.</p>
					</div>
				) : (
					<ul class="posts">
						{posts.map((post, index) => {
							const minutes = readingTime(post.body);
							const author = getAuthor(post);
							const isFeatured = index === 0;
							return (
								<li class:list={['post-card', isFeatured && 'featured']}>
									<a href={`/blog/${post.id}/`}>
										{post.data.heroImage ? (
											<div class="post-thumb">
												<Image
													width={isFeatured ? 960 : 640}
													height={isFeatured ? 480 : 360}
													src={post.data.heroImage}
													alt={post.data.title}
													loading={isFeatured ? 'eager' : 'lazy'}
												/>
											</div>
										) : (
											<div class="post-thumb placeholder" aria-hidden="true">
												DigiSone
											</div>
										)}
										<div class="post-body">
											<div class="post-meta">
												<time datetime={post.data.pubDate.toISOString()}>
													<FormattedDate date={post.data.pubDate} />
												</time>
												<span class="dot" aria-hidden="true" />
												<span>
													{minutes} min read
												</span>
											</div>
											<h2 class="post-title">{post.data.title}</h2>
											{post.data.description && <p class="post-desc">{post.data.description}</p>}
											<p class="post-author">
												<span>By</span> {author}
											</p>
										</div>
									</a>
								</li>
							);
						})}
					</ul>
				)
			}
		</main>
		<Footer />
	</body>
</html>
