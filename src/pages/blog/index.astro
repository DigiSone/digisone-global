---
import { sanityClient } from 'sanity:client';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

// ========== यहीं Query इस्तेमाल करो ==========
const posts = await sanityClient.fetch(`
  *[_type == "post"] | order(publishedAt desc) {
    title,
    "slug": slug.current,
    excerpt,
    publishedAt,
    "imageUrl": mainImage.asset->url,
    "imageAlt": mainImage.alt,
    "authorName": author->name,
    "authorImage": author->image.asset->url,
    "categories": categories[]->title,
    "estimatedReadingTime": round(length(pt::text(body)) / 5 / 180),
    featured
  }
`);

const title = `Blog — ${SITE_TITLE}`;
---

const allCategories = Array.from(
  new Set(posts.flatMap((p: any) => p.categories || []).filter(Boolean))
).sort();

function getReadingTime(post: any): string {
  if (post.estimatedReadingTime && post.estimatedReadingTime > 0) {
    return `${post.estimatedReadingTime} min read`;
  }
  const words = (post.excerpt || '').split(/\s+/).length;
  const mins = Math.max(1, Math.ceil(words / 35));
  return `${mins} min read`;
}

const initialCategory = Astro.url.searchParams.get('category') || 'all';
const initialQuery = Astro.url.searchParams.get('q') || '';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={SITE_DESCRIPTION} />
    <style>
      :root {
        --text-primary: #0f172a;
        --text-secondary: #475569;
        --text-muted: #64748b;
        --border: #e2e8f0;
        --border-hover: #cbd5e1;
        --bg-card: #ffffff;
        --accent: #2563eb;
        --accent-soft: #eff6ff;
        --radius: 16px;
      }

      .blog-page {
        width: min(100% - 2.5rem, 820px);
        margin: 0 auto;
        padding: 3.5rem 0 6.5rem;
      }

      .blog-hero {
        margin-bottom: 2.25rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--border);
      }

      .blog-hero .label {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 0.9rem;
      }

      .blog-hero .label::before {
        content: "";
        width: 7px;
        height: 7px;
        background: var(--accent);
        border-radius: 50%;
      }

      .blog-hero h1 {
        font-size: clamp(2.2rem, 5vw, 2.9rem);
        font-weight: 750;
        letter-spacing: -0.035em;
        color: var(--text-primary);
        margin: 0 0 0.8rem;
        line-height: 1.12;
      }

      .blog-hero p {
        font-size: 1.08rem;
        color: var(--text-secondary);
        margin: 0;
        max-width: 38ch;
        line-height: 1.55;
      }

      .controls { margin-bottom: 2rem; }

      .search-wrapper {
        position: relative;
        margin-bottom: 1.25rem;
      }

      .search-input {
        width: 100%;
        padding: 0.85rem 1.1rem 0.85rem 2.9rem;
        font-size: 0.95rem;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: white;
        color: var(--text-primary);
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
      }

      .search-input::placeholder { color: #94a3b8; }

      .search-input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
      }

      .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        pointer-events: none;
        font-size: 1.05rem;
      }

      .filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .filter-btn {
        appearance: none;
        border: 1px solid var(--border);
        background: white;
        color: var(--text-secondary);
        font-size: 0.82rem;
        font-weight: 550;
        padding: 0.4rem 0.95rem;
        border-radius: 999px;
        cursor: pointer;
        transition: all 0.18s ease;
      }

      .filter-btn:hover {
        border-color: #94a3b8;
        color: var(--text-primary);
      }

      .filter-btn.active {
        background: var(--accent);
        border-color: var(--accent);
        color: white;
        box-shadow: 0 4px 12px -2px rgba(37, 99, 235, 0.35);
      }

      .filter-count {
        font-size: 0.82rem;
        color: var(--text-muted);
        margin: 1.1rem 0 1.5rem;
        font-weight: 500;
      }

      .posts {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
      }

      .post-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1),
                    opacity 0.28s ease,
                    transform 0.28s ease;
        opacity: 1;
        transform: translateY(0);
      }

      .post-card.is-hiding {
        opacity: 0;
        transform: translateY(8px);
        pointer-events: none;
      }

      .post-card.is-hidden { display: none; }

      .post-card:hover {
        border-color: var(--border-hover);
        box-shadow: 0 18px 40px -12px rgba(15, 23, 42, 0.1);
        transform: translateY(-3px);
      }

      .post-card a {
        display: grid;
        grid-template-columns: 210px 1fr;
        text-decoration: none;
        color: inherit;
        min-height: 160px;
      }

      .post-image {
        position: relative;
        background: #f1f5f9;
        overflow: hidden;
      }

      .post-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .post-card:hover .post-image img { transform: scale(1.05); }

      .post-image-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
        color: #94a3b8;
        font-size: 1.8rem;
      }

      .post-content {
        padding: 1.5rem 1.7rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .post-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.45rem;
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--text-muted);
        margin-bottom: 0.65rem;
      }

      .post-meta .dot {
        width: 3px;
        height: 3px;
        background: #94a3b8;
        border-radius: 50%;
      }

      .post-title {
        font-size: 1.3rem;
        font-weight: 700;
        letter-spacing: -0.025em;
        color: var(--text-primary);
        margin: 0 0 0.55rem;
        line-height: 1.3;
        transition: color 0.2s ease;
      }

      .post-card:hover .post-title { color: var(--accent); }

      .post-excerpt {
        color: var(--text-secondary);
        font-size: 0.94rem;
        line-height: 1.55;
        margin: 0 0 1rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .post-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: auto;
      }

      .tag {
        display: inline-flex;
        padding: 0.22rem 0.65rem;
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--accent);
        background: var(--accent-soft);
        border-radius: 999px;
        border: 1px solid #dbeafe;
      }

      .empty, .no-results {
        text-align: center;
        padding: 5rem 1.5rem;
        background: var(--bg-card);
        border: 1px dashed var(--border);
        border-radius: var(--radius);
      }

      .empty-icon, .no-results-icon {
        font-size: 2.2rem;
        margin-bottom: 1.1rem;
        opacity: 0.75;
      }

      .empty h3, .no-results h3 {
        font-size: 1.2rem;
        font-weight: 650;
        color: var(--text-primary);
        margin: 0 0 0.45rem;
      }

      .empty p, .no-results p {
        color: var(--text-muted);
        margin: 0;
        font-size: 0.98rem;
      }

      .no-results {
        display: none;
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .no-results.visible {
        display: block;
        opacity: 1;
      }

      @media (max-width: 700px) {
        .blog-page { padding: 2.75rem 0 5rem; }
        .post-card a { grid-template-columns: 1fr; }
        .post-image { height: 200px; }
        .post-content { padding: 1.35rem 1.4rem 1.5rem; }
        .post-title { font-size: 1.18rem; }
      }
    </style>
  </head>
  <body>
    <Header />

    <main class="blog-page">
      <header class="blog-hero">
        <div class="label">Insights</div>
        <h1>Blog</h1>
        <p>Practical analysis on AI, strategy, cloud, security, and the future of work.</p>
      </header>

      {posts.length === 0 ? (
        <div class="empty">
          <div class="empty-icon">📝</div>
          <h3>No articles yet</h3>
          <p>New insights are on the way. Check back soon.</p>
        </div>
      ) : (
        <>
          <div class="controls">
            <div class="search-wrapper">
              <span class="search-icon">⌕</span>
              <input
                type="search"
                id="searchInput"
                class="search-input"
                placeholder="Search articles..."
                value={initialQuery}
                autocomplete="off"
              />
            </div>

            <div class="filter-bar" id="filterBar">
              <button class={`filter-btn ${initialCategory === 'all' ? 'active' : ''}`} data-filter="all">
                All
              </button>
              {allCategories.map((cat) => (
                <button class={`filter-btn ${initialCategory === cat ? 'active' : ''}`} data-filter={cat}>
                  {cat}
                </button>
              ))}
            </div>
          </div>

          <div class="filter-count" id="filterCount">
            Showing {posts.length} article{posts.length !== 1 ? 's' : ''}
          </div>

          <ul class="posts" id="postsList">
            {posts.map((post: any) => (
              <li
                class="post-card"
                data-categories={(post.categories || []).join(',')}
                data-title={(post.title || '').toLowerCase()}
                data-excerpt={(post.excerpt || '').toLowerCase()}
              >
                <a href={`/blog/${post.slug}/`}>
                  <div class="post-image">
                    {post.imageUrl ? (
                      <img
                        src={`${post.imageUrl}?w=480&h=320&fit=crop&auto=format`}
                        alt={post.imageAlt || post.title}
                        loading="lazy"
                        width="210"
                        height="160"
                      />
                    ) : (
                      <div class="post-image-placeholder">✦</div>
                    )}
                  </div>

                  <div class="post-content">
                    <div class="post-meta">
                      <span>
                        {post.publishedAt
                          ? new Date(post.publishedAt).toLocaleDateString('en-US', {
                              year: 'numeric',
                              month: 'short',
                              day: 'numeric',
                            })
                          : 'Recently'}
                      </span>
                      <span class="dot"></span>
                      <span>{getReadingTime(post)}</span>
                      {post.author && (
                        <>
                          <span class="dot"></span>
                          <span>{post.author}</span>
                        </>
                      )}
                    </div>

                    <h2 class="post-title">{post.title}</h2>
                    {post.excerpt && <p class="post-excerpt">{post.excerpt}</p>}

                    {post.categories?.length > 0 && (
                      <div class="post-tags">
                        {post.categories.slice(0, 3).map((cat: string) => (
                          <span class="tag">{cat}</span>
                        ))}
                      </div>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>

          <div class="no-results" id="noResults">
            <div class="no-results-icon">🔍</div>
            <h3>No articles found</h3>
            <p>Try a different search or category.</p>
          </div>
        </>
      )}
    </main>

    <Footer />

    <script>
      const searchInput = document.getElementById('searchInput') as HTMLInputElement;
      const filterButtons = document.querySelectorAll('.filter-btn');
      const postCards = document.querySelectorAll('.post-card');
      const filterCount = document.getElementById('filterCount');
      const noResults = document.getElementById('noResults');
      const postsList = document.getElementById('postsList');

      let currentCategory = new URLSearchParams(window.location.search).get('category') || 'all';
      let currentQuery = new URLSearchParams(window.location.search).get('q') || '';

      function updateURL() {
        const params = new URLSearchParams();
        if (currentCategory !== 'all') params.set('category', currentCategory);
        if (currentQuery.trim()) params.set('q', currentQuery.trim());
        const newUrl = params.toString()
          ? `\( {window.location.pathname}? \){params.toString()}`
          : window.location.pathname;
        window.history.replaceState({}, '', newUrl);
      }

      function applyFilters() {
        const query = currentQuery.toLowerCase().trim();
        let visibleCount = 0;

        postCards.forEach((card) => {
          const categories = card.getAttribute('data-categories') || '';
          const title = card.getAttribute('data-title') || '';
          const excerpt = card.getAttribute('data-excerpt') || '';

          const matchesCategory =
            currentCategory === 'all' || categories.split(',').includes(currentCategory);
          const matchesSearch = !query || title.includes(query) || excerpt.includes(query);
          const shouldShow = matchesCategory && matchesSearch;

          if (shouldShow) {
            card.classList.remove('is-hidden');
            requestAnimationFrame(() => card.classList.remove('is-hiding'));
            visibleCount++;
          } else {
            card.classList.add('is-hiding');
            setTimeout(() => {
              if (card.classList.contains('is-hiding')) card.classList.add('is-hidden');
            }, 280);
          }
        });

        if (filterCount) {
          filterCount.textContent = `Showing \( {visibleCount} article \){visibleCount !== 1 ? 's' : ''}`;
        }

        if (noResults && postsList) {
          if (visibleCount === 0) {
            postsList.style.display = 'none';
            noResults.classList.add('visible');
          } else {
            postsList.style.display = 'flex';
            noResults.classList.remove('visible');
          }
        }
      }

      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterButtons.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          currentCategory = btn.getAttribute('data-filter') || 'all';
          updateURL();
          applyFilters();
        });
      });

      let debounceTimer: number;
      searchInput?.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = window.setTimeout(() => {
          currentQuery = searchInput.value;
          updateURL();
          applyFilters();
        }, 220);
      });

      applyFilters();
    </script>
  </body>
</html>
