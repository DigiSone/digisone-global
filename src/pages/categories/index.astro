---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_DESCRIPTION } from '../../consts';
import { CATEGORIES } from '../../data/categories';
import { getAllPosts, filterPostsForCategory } from '../../lib/posts';

const allPosts = await getAllPosts();

const categoriesWithCount = CATEGORIES.map((cat) => {
  const posts = filterPostsForCategory(allPosts, cat);
  return { ...cat, count: posts.length };
});

const totalArticles = allPosts.length;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Categories — DigiSone Global"
      description="Explore premium insights by topic: AI, business strategy, startups, cybersecurity, cloud, and the future of work."
    />
    <link rel="canonical" href="https://digisone.com/categories/" />
    <style>
      :root {
        --surface: #ffffff;
        --surface-2: #f8fafc;
        --text: #0b1220;
        --muted: #475569;
        --primary: #2563eb;
        --primary-soft: rgba(37, 99, 235, 0.1);
        --border: rgba(15, 23, 42, 0.08);
        --radius: 20px;
        --radius-lg: 28px;
        --shadow-xs: 0 2px 8px rgba(15, 23, 42, 0.04);
        --shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        color: var(--text);
        background: #f1f5f9;
        -webkit-font-smoothing: antialiased;
      }
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        background:
          radial-gradient(ellipse 90% 60% at 10% -15%, rgba(37, 99, 235, 0.14), transparent 55%),
          radial-gradient(ellipse 70% 50% at 95% 5%, rgba(99, 102, 241, 0.1), transparent 50%);
        pointer-events: none;
        z-index: -1;
      }
      main {
        width: 100%;
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 1.5rem 5rem;
      }
      a { color: inherit; text-decoration: none; }
      h1, h2 { margin: 0; letter-spacing: -0.03em; line-height: 1.15; }
      p { margin: 0; line-height: 1.7; }

      .cat-hero {
        padding: 4.5rem 0 2.5rem;
        max-width: 780px;
      }
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.45rem 0.95rem 0.45rem 0.65rem;
        border-radius: 999px;
        background: var(--surface);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-xs);
        font-size: 0.84rem;
        font-weight: 600;
        margin-bottom: 1.35rem;
      }
      .badge .dot {
        width: 8px; height: 8px; border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
      }
      .cat-hero h1 {
        font-size: clamp(2.4rem, 5.5vw, 3.75rem);
        margin-bottom: 1.1rem;
      }
      .cat-hero h1 .gradient {
        background: linear-gradient(120deg, #2563eb, #6366f1 50%, #8b5cf6);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .lead { font-size: 1.1rem; color: var(--muted); max-width: 560px; }
      .cat-stats {
        display: flex; flex-wrap: wrap; gap: 1.75rem 2.25rem;
        margin-top: 2rem; padding-top: 1.5rem;
        border-top: 1px solid var(--border);
      }
      .cat-stat strong { display: block; font-size: 1.35rem; letter-spacing: -0.02em; }
      .cat-stat span { font-size: 0.82rem; color: var(--muted); font-weight: 500; }

      .categories-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.35rem;
        margin-top: 1rem;
      }
      .category-card {
        position: relative;
        display: flex;
        flex-direction: column;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 1.75rem 1.6rem;
        transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.25s ease;
        overflow: hidden;
        height: 100%;
      }
      .category-card::before {
        content: '';
        position: absolute; top: 0; left: 0; right: 0; height: 3px;
        background: var(--cat-color, var(--primary));
        opacity: 0; transition: opacity 0.25s ease;
      }
      .category-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow);
        border-color: rgba(37, 99, 235, 0.14);
      }
      .category-card:hover::before { opacity: 1; }
      .category-top {
        display: flex; align-items: flex-start; justify-content: space-between;
        gap: 1rem; margin-bottom: 1.1rem;
      }
      .category-icon {
        width: 48px; height: 48px; border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem;
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.1), rgba(99, 102, 241, 0.1));
        flex-shrink: 0;
      }
      .category-count {
        font-size: 0.78rem; font-weight: 600; color: var(--muted);
        background: var(--surface-2); padding: 0.3rem 0.65rem; border-radius: 8px;
      }
      .category-card h2 { font-size: 1.25rem; margin-bottom: 0.35rem; }
      .category-card h2 a:hover { color: var(--primary); }
      .category-short {
        font-size: 0.88rem; font-weight: 600; color: var(--primary); margin-bottom: 0.75rem;
      }
      .category-desc {
        color: var(--muted); font-size: 0.94rem; line-height: 1.65;
        flex-grow: 1; margin-bottom: 1.2rem;
      }
      .topic-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.25rem; }
      .topic-tag {
        font-size: 0.75rem; font-weight: 600; color: var(--muted);
        background: var(--surface-2); border: 1px solid var(--border);
        padding: 0.28rem 0.6rem; border-radius: 6px;
        transition: color 0.15s, border-color 0.15s, background 0.15s;
      }
      a.topic-tag:hover {
        color: var(--primary); border-color: rgba(37, 99, 235, 0.25);
        background: var(--primary-soft);
      }
      .category-footer {
        padding-top: 1rem; border-top: 1px solid var(--border); margin-top: auto;
      }
      .category-link {
        font-size: 0.9rem; font-weight: 600; color: var(--primary);
        display: inline-flex; align-items: center; gap: 0.4rem;
        transition: gap 0.25s var(--ease);
      }
      .category-card:hover .category-link { gap: 0.65rem; }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section class="cat-hero">
        <div class="badge">
          <span class="dot"></span>
          Knowledge Map
        </div>
        <h1>Explore by <span class="gradient">domain</span></h1>
        <p class="lead">
          Focused collections on AI, strategy, startups, security, cloud, and the future of work —
          written for founders, operators, and technology leaders.
        </p>
        <div class="cat-stats">
          <div class="cat-stat">
            <strong>{CATEGORIES.length}</strong>
            <span>Core categories</span>
          </div>
          <div class="cat-stat">
            <strong>{totalArticles}+</strong>
            <span>Articles published</span>
          </div>
          <div class="cat-stat">
            <strong>Weekly</strong>
            <span>New insights</span>
          </div>
        </div>
      </section>

      <section class="categories-grid" aria-label="All categories">
        {
          categoriesWithCount.map((cat) => (
            <article class="category-card" style={`--cat-color: ${cat.color}`}>
              <div class="category-top">
                <div class="category-icon">{cat.icon}</div>
                <span class="category-count">
                  {cat.count === 0 ? 'Explore' : cat.count === 1 ? '1 article' : `${cat.count} articles`}
                </span>
              </div>
              <h2>
                <a href={`/categories/${cat.slug}/`}>{cat.name}</a>
              </h2>
              <p class="category-short">{cat.short}</p>
              <p class="category-desc">{cat.description}</p>
              <div class="topic-tags">
                {cat.topics.map((t) => (
                  <a class="topic-tag" href={`/categories/\( {cat.slug}/ \){t.slug}/`}>
                    {t.name}
                  </a>
                ))}
              </div>
              <div class="category-footer">
                <a class="category-link" href={`/categories/${cat.slug}/`}>
                  View collection <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))
        }
      </section>
    </main>
    <Footer />
  </body>
</html>
