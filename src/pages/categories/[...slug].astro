---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {
  CATEGORIES,
  getCategoryBySlug,
  getTopic,
} from '../../data/categories';
import {
  getAllPosts,
  filterPostsForCategory,
  formatDate,
  type UnifiedPost,
} from '../../lib/posts';

export async function getStaticPaths() {
  const paths: { params: { slug: string } }[] = [];

  for (const cat of CATEGORIES) {
    // Main category: /categories/artificial-intelligence/
    paths.push({ params: { slug: cat.slug } });

    // Subcategories: /categories/artificial-intelligence/ai-agents/
    for (const topic of cat.topics) {
      paths.push({ params: { slug: `\( {cat.slug}/ \){topic.slug}` } });
    }
  }

  return paths;
}

const slugParam = Astro.params.slug || '';
const parts = slugParam.split('/').filter(Boolean);
const categorySlug = parts[0] || '';
const topicSlug = parts[1];

const category = getCategoryBySlug(categorySlug);

if (!category) {
  return Astro.redirect('/categories/');
}

const topic = topicSlug ? getTopic(categorySlug, topicSlug) : undefined;

// If someone hits a bad topic slug, soft-redirect to parent category
if (topicSlug && !topic) {
  return Astro.redirect(`/categories/${categorySlug}/`);
}

const allPosts = await getAllPosts();
const posts = filterPostsForCategory(allPosts, category, topicSlug);

const pageTitle = topic
  ? `${topic.name} — ${category.name} — DigiSone Global`
  : `${category.name} — DigiSone Global`;

const pageDescription = topic
  ? `Articles on ${topic.name} within ${category.name}. ${category.description}`
  : category.description;

const canonical = topic
  ? `https://digisone.com/categories/\( {category.slug}/ \){topic.slug}/`
  : `https://digisone.com/categories/${category.slug}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
    <link rel="canonical" href={canonical} />
    <style>
      :root {
        --surface: #ffffff;
        --surface-2: #f8fafc;
        --text: #0b1220;
        --muted: #475569;
        --primary: #2563eb;
        --primary-soft: rgba(37, 99, 235, 0.1);
        --border: rgba(15, 23, 42, 0.08);
        --radius: 16px;
        --radius-lg: 24px;
        --shadow: 0 18px 40px -12px rgba(15, 23, 42, 0.1);
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
        --cat-color: {category.color};
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        color: var(--text);
        background: #f1f5f9;
        -webkit-font-smoothing: antialiased;
      }
      body::before {
        content: '';
        position: fixed; inset: 0;
        background:
          radial-gradient(ellipse 80% 50% at 0% 0%, color-mix(in srgb, var(--cat-color) 18%, transparent), transparent 55%),
          radial-gradient(ellipse 60% 40% at 100% 10%, rgba(99, 102, 241, 0.08), transparent 50%);
        pointer-events: none; z-index: -1;
      }
      main {
        width: min(100% - 2.5rem, 900px);
        margin: 0 auto;
        padding: 3rem 0 5.5rem;
      }
      a { color: inherit; text-decoration: none; }
      h1, h2 { margin: 0; letter-spacing: -0.03em; }

      .breadcrumb {
        display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem;
        font-size: 0.84rem; color: var(--muted); margin-bottom: 1.75rem;
      }
      .breadcrumb a:hover { color: var(--primary); }
      .breadcrumb .sep { opacity: 0.45; }

      .hero {
        margin-bottom: 2.5rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--border);
      }
      .hero-icon {
        width: 56px; height: 56px; border-radius: 16px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.6rem; margin-bottom: 1.25rem;
        background: linear-gradient(135deg, color-mix(in srgb, var(--cat-color) 16%, white), color-mix(in srgb, var(--cat-color) 8%, white));
        border: 1px solid color-mix(in srgb, var(--cat-color) 20%, transparent);
      }
      .hero h1 {
        font-size: clamp(2rem, 4.5vw, 2.75rem);
        font-weight: 750; line-height: 1.15; margin-bottom: 0.75rem;
      }
      .hero .lead {
        font-size: 1.05rem; color: var(--muted); line-height: 1.65; max-width: 640px;
      }
      .hero-meta {
        display: flex; flex-wrap: wrap; gap: 0.75rem 1.25rem;
        margin-top: 1.25rem; font-size: 0.88rem; color: var(--muted); font-weight: 500;
      }

      .topics {
        display: flex; flex-wrap: wrap; gap: 0.5rem;
        margin-bottom: 2.5rem;
      }
      .topic-chip {
        font-size: 0.8rem; font-weight: 600;
        padding: 0.4rem 0.85rem; border-radius: 999px;
        background: var(--surface); border: 1px solid var(--border);
        color: var(--muted); transition: all 0.2s ease;
      }
      .topic-chip:hover, .topic-chip.active {
        color: var(--primary);
        border-color: rgba(37, 99, 235, 0.3);
        background: var(--primary-soft);
      }

      .posts { display: flex; flex-direction: column; gap: 1.15rem; }
      .post-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        transition: transform 0.28s var(--ease), box-shadow 0.28s var(--ease), border-color 0.2s;
      }
      .post-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow);
        border-color: #cbd5e1;
      }
      .post-card a {
        display: grid;
        grid-template-columns: 200px 1fr;
        min-height: 150px;
      }
      .post-image {
        background: #e2e8f0; overflow: hidden; position: relative;
      }
      .post-image img {
        width: 100%; height: 100%; object-fit: cover;
        transition: transform 0.45s var(--ease);
      }
      .post-card:hover .post-image img { transform: scale(1.05); }
      .post-image.placeholder {
        display: flex; align-items: center; justify-content: center;
        font-size: 2rem; opacity: 0.4;
      }
      .post-body {
        padding: 1.35rem 1.5rem;
        display: flex; flex-direction: column; justify-content: center;
      }
      .post-meta {
        display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem;
        font-size: 0.8rem; color: var(--muted); font-weight: 500; margin-bottom: 0.5rem;
      }
      .post-meta .dot { width: 3px; height: 3px; border-radius: 50%; background: #94a3b8; }
      .source-badge {
        font-size: 0.68rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.04em; padding: 0.15rem 0.45rem; border-radius: 4px;
        background: #f1f5f9; color: #64748b;
      }
      .post-title {
        font-size: 1.2rem; font-weight: 700; line-height: 1.3;
        margin: 0 0 0.45rem; color: var(--text);
      }
      .post-card:hover .post-title { color: var(--primary); }
      .post-excerpt {
        font-size: 0.92rem; color: var(--muted); line-height: 1.55;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
      }

      .empty {
        text-align: center;
        padding: 4rem 1.5rem;
        background: var(--surface);
        border: 1px dashed var(--border);
        border-radius: var(--radius-lg);
        color: var(--muted);
      }
      .empty a { color: var(--primary); font-weight: 600; }

      @media (max-width: 640px) {
        .post-card a { grid-template-columns: 1fr; }
        .post-image { height: 180px; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <a href="/categories/">Categories</a>
        <span class="sep">/</span>
        {
          topic ? (
            <>
              <a href={`/categories/${category.slug}/`}>{category.name}</a>
              <span class="sep">/</span>
              <span>{topic.name}</span>
            </>
          ) : (
            <span>{category.name}</span>
          )
        }
      </nav>

      <header class="hero">
        <div class="hero-icon">{category.icon}</div>
        <h1>{topic ? topic.name : category.name}</h1>
        <p class="lead">
          {topic
            ? `Curated writing on ${topic.name} inside ${category.name}.`
            : category.description}
        </p>
        <div class="hero-meta">
          <span>{posts.length} {posts.length === 1 ? 'article' : 'articles'}</span>
          <span>·</span>
          <span>{category.short}</span>
        </div>
      </header>

      {
        !topic && category.topics.length > 0 && (
          <div class="topics" aria-label="Sub-topics">
            <a class="topic-chip active" href={`/categories/${category.slug}/`}>
              All
            </a>
            {category.topics.map((t) => (
              <a class="topic-chip" href={`/categories/\( {category.slug}/ \){t.slug}/`}>
                {t.name}
              </a>
            ))}
          </div>
        )
      }

      {
        topic && (
          <div class="topics">
            <a class="topic-chip" href={`/categories/${category.slug}/`}>
              ← All {category.name}
            </a>
          </div>
        )
      }

      {
        posts.length === 0 ? (
          <div class="empty">
            <p>No articles in this collection yet.</p>
            <p style="margin-top: 0.75rem;">
              <a href="/categories/">Browse other categories</a>
              {' · '}
              <a href="/blog/">View all articles</a>
            </p>
          </div>
        ) : (
          <div class="posts">
            {posts.map((post: UnifiedPost) => (
              <article class="post-card">
                <a href={post.href}>
                  <div class={`post-image ${post.imageUrl ? '' : 'placeholder'}`}>
                    {post.imageUrl ? (
                      <img
                        src={post.imageUrl}
                        alt={post.imageAlt || post.title}
                        loading="lazy"
                        width="200"
                        height="150"
                      />
                    ) : (
                      <span>{category.icon}</span>
                    )}
                  </div>
                  <div class="post-body">
                    <div class="post-meta">
                      <time datetime={post.publishedAt.toISOString()}>
                        {formatDate(post.publishedAt)}
                      </time>
                      <span class="dot" />
                      <span>{post.readingTime}</span>
                      {post.source === 'markdown' && (
                        <>
                          <span class="dot" />
                          <span class="source-badge">Archive</span>
                        </>
                      )}
                    </div>
                    <h2 class="post-title">{post.title}</h2>
                    {post.excerpt && <p class="post-excerpt">{post.excerpt}</p>}
                  </div>
                </a>
              </article>
            ))}
          </div>
        )
      }
    </main>
    <Footer />
  </body>
</html>
