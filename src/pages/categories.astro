---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');

function countByKeyword(keyword: string) {
	const lower = keyword.toLowerCase();
	return posts.filter((p) => {
		const title = (p.data.title || '').toLowerCase();
		const desc = (p.data.description || '').toLowerCase();
		return title.includes(lower) || desc.includes(lower);
	}).length;
}

function formatCount(count: number) {
	if (count <= 0) return 'Explore';
	if (count === 1) return '1 article';
	return count + ' articles';
}

const categories = [
	{
		slug: 'artificial-intelligence',
		name: 'Artificial Intelligence',
		icon: '🤖',
		short: 'AI Models, Agents & Automation',
		description:
			'From foundation models and agents to enterprise adoption and governance — deep analysis on how AI is reshaping products, work, and strategy.',
		topics: ['Large Language Models', 'AI Agents', 'Automation', 'Responsible AI'],
		color: '#2563eb',
		keyword: 'artificial',
	},
	{
		slug: 'business-strategy',
		name: 'Business Strategy',
		icon: '📈',
		short: 'Strategy, Leadership & Growth',
		description:
			'Frameworks, leadership lessons, and strategic insights for operators and executives navigating competitive markets and digital transformation.',
		topics: ['Competitive Strategy', 'Leadership', 'Digital Transformation', 'Operations'],
		color: '#0ea5e9',
		keyword: 'business',
	},
	{
		slug: 'startups',
		name: 'Startups',
		icon: '🚀',
		short: 'Funding, Product & Growth',
		description:
			'Practical playbooks for founders — fundraising, product-market fit, scaling teams, and building durable companies in a noisy landscape.',
		topics: ['Fundraising', 'Product-Market Fit', 'Growth', 'Scaling'],
		color: '#8b5cf6',
		keyword: 'startup',
	},
	{
		slug: 'cybersecurity',
		name: 'Cybersecurity',
		icon: '🔒',
		short: 'Security, Privacy & Risk',
		description:
			'Threats, architecture patterns, zero-trust, privacy, and the operational reality of defending modern cloud and AI-powered systems.',
		topics: ['Zero Trust', 'Cloud Security', 'Privacy', 'Secure Architecture'],
		color: '#ef4444',
		keyword: 'security',
	},
	{
		slug: 'cloud-computing',
		name: 'Cloud Computing',
		icon: '☁️',
		short: 'AWS, Azure, GCP & Platforms',
		description:
			'Architecture, cost, reliability, and platform strategy across the major clouds — plus the patterns that actually work at scale.',
		topics: ['AWS', 'Azure', 'GCP', 'Architecture'],
		color: '#06b6d4',
		keyword: 'cloud',
	},
	{
		slug: 'future-of-work',
		name: 'Future of Work',
		icon: '🌐',
		short: 'Teams, Tools & Culture',
		description:
			'How AI, remote work, and new tooling are changing roles, productivity, and organizational design — with grounded takeaways.',
		topics: ['Remote Work', 'AI-Augmented Roles', 'Productivity', 'Culture'],
		color: '#10b981',
		keyword: 'work',
	},
	{
		slug: 'creator-economy',
		name: 'Creator Economy',
		icon: '🎥',
		short: 'Content, Audience & Monetization',
		description:
			'Building audiences, monetizing expertise, and the platforms and models powering the next generation of independent creators and media.',
		topics: ['Audience Growth', 'Monetization', 'Platforms', 'Content Strategy'],
		color: '#f59e0b',
		keyword: 'creator',
	},
	{
		slug: 'digital-transformation',
		name: 'Digital Transformation',
		icon: '⚙️',
		short: 'Technology & Organizational Change',
		description:
			'How established organizations adopt new technology, modernize systems, and change operating models without losing momentum.',
		topics: ['Modernization', 'Change Management', 'Legacy Systems', 'ROI'],
		color: '#6366f1',
		keyword: 'transformation',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Categories — DigiSone Global" description={SITE_DESCRIPTION} />
		<style>
			:root {
				--surface: #ffffff;
				--surface-2: #f8fafc;
				--text: #0b1220;
				--muted: #475569;
				--primary: #2563eb;
				--primary-soft: rgba(37, 99, 235, 0.1);
				--border: rgba(15, 23, 42, 0.08);
				--radius: 20px;
				--radius-lg: 28px;
				--radius-xl: 36px;
				--shadow-xs: 0 2px 8px rgba(15, 23, 42, 0.04);
				--shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
				--shadow-lg: 0 32px 80px rgba(15, 23, 42, 0.12);
				--font-sans: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
				--ease: cubic-bezier(0.22, 1, 0.36, 1);
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				margin: 0;
				font-family: var(--font-sans);
				color: var(--text);
				background: #f1f5f9;
				-webkit-font-smoothing: antialiased;
				overflow-x: hidden;
			}

			body::before {
				content: '';
				position: fixed;
				inset: 0;
				background:
					radial-gradient(ellipse 90% 60% at 10% -15%, rgba(37, 99, 235, 0.14), transparent 55%),
					radial-gradient(ellipse 70% 50% at 95% 5%, rgba(99, 102, 241, 0.1), transparent 50%);
				pointer-events: none;
				z-index: -1;
			}

			main {
				width: 100%;
				max-width: 1240px;
				margin: 0 auto;
				padding: 0 1.5rem;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			h1,
			h2 {
				margin: 0;
				letter-spacing: -0.03em;
				line-height: 1.15;
			}

			p {
				margin: 0;
				line-height: 1.7;
			}

			.section {
				margin: 5rem 0;
			}

			.cat-hero {
				padding: 4.5rem 0 2.5rem;
				max-width: 780px;
			}

			.badge {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.45rem 0.95rem 0.45rem 0.65rem;
				border-radius: 999px;
				background: var(--surface);
				border: 1px solid var(--border);
				box-shadow: var(--shadow-xs);
				font-size: 0.84rem;
				font-weight: 600;
				margin-bottom: 1.35rem;
			}

			.badge .dot {
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: #22c55e;
				box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
			}

			.cat-hero h1 {
				font-size: clamp(2.4rem, 5.5vw, 3.75rem);
				margin-bottom: 1.1rem;
			}

			.cat-hero h1 .gradient {
				background: linear-gradient(120deg, #2563eb, #6366f1 50%, #8b5cf6);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}

			.lead {
				font-size: 1.1rem;
				color: var(--muted);
				max-width: 560px;
			}

			.cat-stats {
				display: flex;
				flex-wrap: wrap;
				gap: 1.75rem 2.25rem;
				margin-top: 2rem;
				padding-top: 1.5rem;
				border-top: 1px solid var(--border);
			}

			.cat-stat strong {
				display: block;
				font-size: 1.35rem;
				letter-spacing: -0.02em;
			}

			.cat-stat span {
				font-size: 0.82rem;
				color: var(--muted);
				font-weight: 500;
			}

			.categories-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
				gap: 1.35rem;
			}

			.category-card {
				position: relative;
				display: flex;
				flex-direction: column;
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				padding: 1.75rem 1.6rem;
				box-shadow: var(--shadow-xs);
				transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.25s ease;
				overflow: hidden;
				height: 100%;
			}

			.category-card::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				height: 3px;
				background: var(--cat-color, var(--primary));
				opacity: 0;
				transition: opacity 0.25s ease;
			}

			.category-card:hover {
				transform: translateY(-5px);
				box-shadow: var(--shadow);
				border-color: rgba(37, 99, 235, 0.14);
			}

			.category-card:hover::before {
				opacity: 1;
			}

			.category-top {
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1.1rem;
			}

			.category-icon {
				width: 48px;
				height: 48px;
				border-radius: 14px;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 1.4rem;
				background: linear-gradient(135deg, rgba(37, 99, 235, 0.1), rgba(99, 102, 241, 0.1));
				flex-shrink: 0;
			}

			.category-count {
				font-size: 0.78rem;
				font-weight: 600;
				color: var(--muted);
				background: var(--surface-2);
				padding: 0.3rem 0.65rem;
				border-radius: 8px;
				white-space: nowrap;
			}

			.category-card h2 {
				font-size: 1.25rem;
				margin-bottom: 0.35rem;
			}

			.category-card h2 a:hover {
				color: var(--primary);
			}

			.category-short {
				font-size: 0.88rem;
				font-weight: 600;
				color: var(--primary);
				margin-bottom: 0.75rem;
			}

			.category-desc {
				color: var(--muted);
				font-size: 0.94rem;
				line-height: 1.65;
				flex-grow: 1;
				margin-bottom: 1.2rem;
			}

			.topic-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-bottom: 1.25rem;
			}

			.topic-tag {
				font-size: 0.75rem;
				font-weight: 600;
				color: var(--muted);
				background: var(--surface-2);
				border: 1px solid var(--border);
				padding: 0.28rem 0.6rem;
				border-radius: 6px;
				transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
			}

			a.topic-tag:hover {
				color: var(--primary);
				border-color: rgba(37, 99, 235, 0.25);
				background: var(--primary-soft);
			}

			.category-footer {
				padding-top: 1rem;
				border-top: 1px solid var(--border);
				margin-top: auto;
			}

			.category-link {
				font-size: 0.9rem;
				font-weight: 600;
				color: var(--primary);
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				transition: gap 0.25s var(--ease);
			}

			.category-card:hover .category-link {
				gap: 0.6rem;
			}

			.topics-strip {
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius-xl);
				padding: 2.25rem 2rem;
				box-shadow: var(--shadow-xs);
			}

			.topics-strip h2 {
				font-size: 1.4rem;
				margin-bottom: 0.4rem;
			}

			.topics-strip > p {
				color: var(--muted);
				margin-bottom: 1.5rem;
			}

			.all-topics {
				display: flex;
				flex-wrap: wrap;
				gap: 0.55rem;
			}

			.all-topics a {
				font-size: 0.85rem;
				font-weight: 600;
				padding: 0.45rem 0.9rem;
				border-radius: 999px;
				background: var(--surface-2);
				border: 1px solid var(--border);
				color: var(--text);
				transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s var(--ease);
			}

			.all-topics a:hover {
				background: var(--primary-soft);
				border-color: rgba(37, 99, 235, 0.2);
				color: var(--primary);
				transform: translateY(-2px);
			}

			.cta {
				position: relative;
				padding: 3.75rem 2.5rem;
				border-radius: var(--radius-xl);
				text-align: center;
				background: linear-gradient(150deg, #0b1220 0%, #1e293b 50%, #0f172a 100%);
				color: #fff;
				box-shadow: var(--shadow-lg);
				overflow: hidden;
			}

			.cta-inner {
				position: relative;
				z-index: 1;
			}

			.cta h2 {
				font-size: clamp(1.7rem, 3.5vw, 2.4rem);
				margin-bottom: 0.75rem;
			}

			.cta p {
				max-width: 460px;
				margin: 0 auto 1.75rem;
				color: rgba(255, 255, 255, 0.72);
			}

			.cta-buttons {
				display: flex;
				gap: 0.85rem;
				justify-content: center;
				flex-wrap: wrap;
			}

			.btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-height: 2.85rem;
				padding: 0.75rem 1.35rem;
				border-radius: 14px;
				font-weight: 600;
				font-size: 0.95rem;
				border: none;
				transition: transform 0.25s var(--ease);
			}

			.btn:hover {
				transform: translateY(-2px);
			}

			.btn-primary {
				background: #fff;
				color: #0b1220;
			}

			.btn-secondary {
				background: rgba(255, 255, 255, 0.08);
				border: 1px solid rgba(255, 255, 255, 0.15);
				color: #fff;
			}

			@media (max-width: 768px) {
				main {
					padding: 0 1.15rem;
				}

				.cat-hero {
					padding: 3rem 0 1.75rem;
				}

				.categories-grid {
					grid-template-columns: 1fr;
				}

				.topics-strip {
					padding: 1.75rem 1.35rem;
				}

				.cta {
					padding: 2.75rem 1.35rem;
				}

				.cta-buttons {
					flex-direction: column;
				}

				.btn {
					width: 100%;
				}

				.section {
					margin: 3.75rem 0;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="cat-hero">
				<div class="badge">
					<span class="dot" aria-hidden="true"></span>
					Explore by topic
				</div>
				<h1>
					Categories that<br />
					<span class="gradient">map the future</span>
				</h1>
				<p class="lead">
					Dive into focused collections on AI, business strategy, startups, security, cloud, and the
					future of work — written for founders, operators, and technology leaders.
				</p>
				<div class="cat-stats">
					<div class="cat-stat">
						<strong>{categories.length}</strong>
						<span>Core categories</span>
					</div>
					<div class="cat-stat">
						<strong>{posts.length}+</strong>
						<span>Articles published</span>
					</div>
					<div class="cat-stat">
						<strong>Weekly</strong>
						<span>New insights</span>
					</div>
				</div>
			</section>

			<section class="section" style="margin-top: 1rem;">
				<div class="categories-grid">
					{
						categories.map((cat) => {
							const count = countByKeyword(cat.keyword);
							return (
								<article class="category-card" style={`--cat-color: ${cat.color}`}>
									<div class="category-top">
										<a href={`/categories/${cat.slug}`} class="category-icon" aria-label={cat.name}>
											{cat.icon}
										</a>
										<span class="category-count">{formatCount(count)}</span>
									</div>

									<h2>
										<a href={`/categories/${cat.slug}`}>{cat.name}</a>
									</h2>

									<div class="category-short">
										<a href={`/categories/${cat.slug}`}>{cat.short}</a>
									</div>

									<p class="category-desc">{cat.description}</p>

									<div class="topic-tags">
										{cat.topics.map((topic) => (
											<a class="topic-tag" href={`/blog?q=${encodeURIComponent(topic)}`}>
												{topic}
											</a>
										))}
									</div>

									<div class="category-footer">
										<a class="category-link" href={`/categories/${cat.slug}`}>
											View category
											<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
												<path
													d="M3 8h10M9 4l4 4-4 4"
													stroke="currentColor"
													stroke-width="1.75"
													stroke-linecap="round"
													stroke-linejoin="round"
												/>
											</svg>
										</a>
									</div>
								</article>
							);
						})
					}
				</div>
			</section>

			<section class="section">
				<div class="topics-strip">
					<h2>Browse by topic</h2>
					<p>Jump straight into the themes we cover most often.</p>
					<div class="all-topics">
						{
							[
								'AI Agents',
								'Large Language Models',
								'Enterprise Automation',
								'Fundraising',
								'Product-Market Fit',
								'Zero Trust',
								'Cloud Architecture',
								'AWS',
								'Azure',
								'GCP',
								'Remote Work',
								'Digital Transformation',
								'Leadership',
								'Cybersecurity',
								'Creator Economy',
								'Privacy',
								'Growth Strategy',
							].map((topic) => (
								<a href={`/blog?q=${encodeURIComponent(topic)}`}>{topic}</a>
							))
						}
					</div>
				</div>
			</section>

			<section class="section">
				<div class="cta">
					<div class="cta-inner">
						<h2>Never miss a new insight</h2>
						<p>
							Get the weekly technology briefing — curated analysis on AI, strategy, security, and
							the future of work.
						</p>
						<div class="cta-buttons">
							<a href="/subscribe" class="btn btn-primary">Subscribe to Briefing</a>
							<a href="/blog" class="btn btn-secondary">Browse all articles</a>
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
