---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');

function countByKeyword(keyword: string) {
  const lower = keyword.toLowerCase();
  return posts.filter((p) => {
    const title = (p.data.title || '').toLowerCase();
    const desc = (p.data.description || '').toLowerCase();
    return title.includes(lower) || desc.includes(lower);
  }).length;
}

const categories = [
  {
    slug: 'artificial-intelligence',
    name: 'Artificial Intelligence',
    icon: '🤖',
    short: 'AI Models, Agents & Automation',
    description:
      'From foundation models and agents to enterprise adoption and governance — deep analysis on how AI is reshaping products, work, and strategy.',
    topics: ['Large Language Models', 'AI Agents', 'Automation', 'Responsible AI', 'Enterprise AI'],
    color: '#2563eb',
  },
  {
    slug: 'business',
    name: 'Business Strategy',
    icon: '📈',
    short: 'Strategy, Leadership & Growth',
    description:
      'Frameworks, leadership lessons, and strategic insights for operators and executives navigating competitive markets and digital transformation.',
    topics: ['Competitive Strategy', 'Leadership', 'Digital Transformation', 'Operations', 'Go-to-Market'],
    color: '#0ea5e9',
  },
  {
    slug: 'startups',
    name: 'Startups',
    icon: '🚀',
    short: 'Funding, Product & Growth',
    description:
      'Practical playbooks for founders — fundraising, product-market fit, scaling teams, and building durable companies in a noisy landscape.',
    topics: ['Fundraising', 'Product-Market Fit', 'Growth', 'Founder Lessons', 'Scaling'],
    color: '#8b5cf6',
  },
  {
    slug: 'cybersecurity',
    name: 'Cybersecurity',
    icon: '🔒',
    short: 'Security, Privacy & Risk',
    description:
      'Threats, architecture patterns, zero-trust, privacy, and the operational reality of defending modern cloud and AI-powered systems.',
    topics: ['Zero Trust', 'Cloud Security', 'Privacy', 'Threat Intelligence', 'Secure Architecture'],
    color: '#ef4444',
  },
  {
    slug: 'cloud',
    name: 'Cloud Computing',
    icon: '☁️',
    short: 'AWS, Azure, GCP & Platforms',
    description:
      'Architecture, cost, reliability, and platform strategy across the major clouds — plus the patterns that actually work at scale.',
    topics: ['AWS', 'Azure', 'GCP', 'Architecture', 'Platform Engineering'],
    color: '#06b6d4',
  },
  {
    slug: 'future-of-work',
    name: 'Future of Work',
    icon: '🌐',
    short: 'Teams, Tools & Culture',
    description:
      'How AI, remote work, and new tooling are changing roles, productivity, and organizational design — with grounded takeaways.',
    topics: ['Remote Work', 'AI-Augmented Roles', 'Productivity', 'Culture', 'Talent'],
    color: '#10b981',
  },
  {
    slug: 'creator-economy',
    name: 'Creator Economy',
    icon: '🎥',
    short: 'Content, Audience & Monetization',
    description:
      'Building audiences, monetizing expertise, and the platforms and models powering the next generation of independent creators and media.',
    topics: ['Audience Growth', 'Monetization', 'Platforms', 'Content Strategy', 'Personal Brand'],
    color: '#f59e0b',
  },
  {
    slug: 'digital-transformation',
    name: 'Digital Transformation',
    icon: '⚙️',
    short: 'Technology & Organizational Change',
    description:
      'How established organizations adopt new technology, modernize systems, and change operating models without losing momentum.',
    topics: ['Modernization', 'Change Management', 'Legacy Systems', 'Operating Models', 'ROI'],
    color: '#6366f1',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Categories — DigiSone Global" description={SITE_DESCRIPTION} />
    <!-- fonts + styles: tumhara existing CSS same rehne do -->
    <style>
      /* ... apna pura pehle wala CSS yahan paste rakho ... */

      /* topics ab links hain */
      .topic-tag {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--muted);
        background: var(--surface-2);
        border: 1px solid var(--border);
        padding: 0.28rem 0.6rem;
        border-radius: 6px;
        transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
      }
      a.topic-tag:hover {
        color: var(--primary);
        border-color: rgba(37, 99, 235, 0.25);
        background: var(--primary-soft);
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section class="cat-hero">
        <div class="badge">
          <span class="dot"></span>
          Explore by topic
        </div>
        <h1>
          Categories that<br />
          <span class="gradient">map the future</span>
        </h1>
        <p class="lead">
          Dive into focused collections on AI, business strategy, startups,
          security, cloud, and the future of work — written for founders,
          operators, and technology leaders.
        </p>
        <div class="cat-stats">
          <div class="cat-stat">
            <strong>{categories.length}</strong>
            <span>Core categories</span>
          </div>
          <div class="cat-stat">
            <strong>{posts.length}+</strong>
            <span>Articles published</span>
          </div>
          <div class="cat-stat">
            <strong>Weekly</strong>
            <span>New insights</span>
          </div>
        </div>
      </section>

      <section class="section" style="margin-top: 1rem;">
        <div class="categories-grid">
          {categories.map((cat) => {
            const count = countByKeyword(cat.name.split(' ')[0]);
            return (
              <article class="category-card" style={`--cat-color: ${cat.color}`}>
                <div class="category-top">
                  <a href={`/categories/${cat.slug}`} class="category-icon" aria-label={cat.name}>
                    {cat.icon}
                  </a>
                  <span class="category-count">
                    {count > 0 ? `\( {count} article \){count === 1 ? '' : 's'}` : 'Explore'}
                  </span>
                </div>

                <h2>
                  <a href={`/categories/${cat.slug}`}>{cat.name}</a>
                </h2>
                <div class="category-short">
                  <a href={`/categories/${cat.slug}`}>{cat.short}</a>
                </div>
                <p class="category-desc">{cat.description}</p>

                <div class="topic-tags">
                  {cat.topics.slice(0, 4).map((t) => (
                    <a
                      class="topic-tag"
                      href={`/blog?q=${encodeURIComponent(t)}`}
                    >
                      {t}
                    </a>
                  ))}
                </div>

                <div class="category-footer">
                  <a class="category-link" href={`/categories/${cat.slug}`}>
                    View category
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <section class="section">
        <div class="topics-strip">
          <h2>Browse by topic</h2>
          <p>Jump straight into the themes we cover most often.</p>
          <div class="all-topics">
            {[
              'AI Agents',
              'Large Language Models',
              'Enterprise Automation',
              'Fundraising',
              'Product-Market Fit',
              'Zero Trust',
              'Cloud Architecture',
              'AWS',
              'Azure',
              'GCP',
              'Remote Work',
              'Digital Transformation',
              'Leadership',
              'Cybersecurity',
              'Creator Economy',
              'Platform Engineering',
              'Privacy',
              'Growth Strategy',
            ].map((topic) => (
              <a href={`/blog?q=${encodeURIComponent(topic)}`}>{topic}</a>
            ))}
          </div>
        </div>
      </section>

      <section class="section">
        <div class="cta">
          <div class="cta-inner">
            <h2>Never miss a new insight</h2>
            <p>
              Get the weekly technology briefing — curated analysis on AI,
              strategy, security, and the future of work.
            </p>
            <div class="cta-buttons">
              <a href="/subscribe" class="btn btn-primary">Subscribe to Briefing</a>
              <a href="/blog" class="btn btn-secondary">Browse all articles</a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
