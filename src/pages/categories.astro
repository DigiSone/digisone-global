---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { getCollection } from 'astro:content';

const allCategories = [
  {
    slug: 'artificial-intelligence',
    name: 'Artificial Intelligence',
    icon: '🤖',
    short: 'AI Models, Agents & Automation',
    description:
      'From foundation models and agents to enterprise adoption and governance — deep analysis on how AI is reshaping products, work, and strategy.',
    topics: ['Large Language Models', 'AI Agents', 'Automation', 'Responsible AI', 'Enterprise AI'],
    keywords: ['artificial intelligence', 'ai', 'llm', 'agent', 'automation'],
    color: '#2563eb',
  },
  {
    slug: 'business',
    name: 'Business Strategy',
    icon: '📈',
    short: 'Strategy, Leadership & Growth',
    description:
      'Frameworks, leadership lessons, and strategic insights for operators and executives navigating competitive markets and digital transformation.',
    topics: ['Competitive Strategy', 'Leadership', 'Digital Transformation', 'Operations', 'Go-to-Market'],
    keywords: ['business', 'strategy', 'leadership'],
    color: '#0ea5e9',
  },
  {
    slug: 'startups',
    name: 'Startups',
    icon: '🚀',
    short: 'Funding, Product & Growth',
    description:
      'Practical playbooks for founders — fundraising, product-market fit, scaling teams, and building durable companies.',
    topics: ['Fundraising', 'Product-Market Fit', 'Growth', 'Founder Lessons', 'Scaling'],
    keywords: ['startup', 'founder', 'fundraising', 'growth'],
    color: '#8b5cf6',
  },
  {
    slug: 'cybersecurity',
    name: 'Cybersecurity',
    icon: '🔒',
    short: 'Security, Privacy & Risk',
    description:
      'Threats, architecture patterns, zero-trust, privacy, and defending modern cloud and AI-powered systems.',
    topics: ['Zero Trust', 'Cloud Security', 'Privacy', 'Threat Intelligence', 'Secure Architecture'],
    keywords: ['cyber', 'security', 'privacy', 'threat'],
    color: '#ef4444',
  },
  {
    slug: 'cloud',
    name: 'Cloud Computing',
    icon: '☁️',
    short: 'AWS, Azure, GCP & Platforms',
    description:
      'Architecture, cost, reliability, and platform strategy across the major clouds.',
    topics: ['AWS', 'Azure', 'GCP', 'Architecture', 'Platform Engineering'],
    keywords: ['cloud', 'aws', 'azure', 'gcp'],
    color: '#06b6d4',
  },
  {
    slug: 'future-of-work',
    name: 'Future of Work',
    icon: '🌐',
    short: 'Teams, Tools & Culture',
    description:
      'How AI, remote work, and new tooling are changing roles, productivity, and organizational design.',
    topics: ['Remote Work', 'AI-Augmented Roles', 'Productivity', 'Culture', 'Talent'],
    keywords: ['future of work', 'remote', 'productivity', 'talent'],
    color: '#10b981',
  },
  {
    slug: 'creator-economy',
    name: 'Creator Economy',
    icon: '🎥',
    short: 'Content, Audience & Monetization',
    description:
      'Building audiences, monetizing expertise, and platforms powering independent creators.',
    topics: ['Audience Growth', 'Monetization', 'Platforms', 'Content Strategy', 'Personal Brand'],
    keywords: ['creator', 'content', 'monetization', 'audience'],
    color: '#f59e0b',
  },
  {
    slug: 'digital-transformation',
    name: 'Digital Transformation',
    icon: '⚙️',
    short: 'Technology & Organizational Change',
    description:
      'How organizations adopt new technology, modernize systems, and change operating models.',
    topics: ['Modernization', 'Change Management', 'Legacy Systems', 'Operating Models', 'ROI'],
    keywords: ['digital transformation', 'modernization', 'legacy'],
    color: '#6366f1',
  },
];

export function getStaticPaths() {
  return allCategories.map((cat) => ({
    params: { slug: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const posts = await getCollection('blog');

const related = posts
  .filter((p) => {
    const hay = `${p.data.title} ${p.data.description}`.toLowerCase();
    return category.keywords.some((k: string) => hay.includes(k.toLowerCase()));
  })
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = `${category.name} — DigiSone Global`;
const description = category.description;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      :root {
        --surface: #fff;
        --text: #0b1220;
        --muted: #475569;
        --primary: #2563eb;
        --border: rgba(15, 23, 42, 0.08);
        --radius: 1.25rem;
        --bg: #f1f5f9;
        --font: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      }
      body {
        margin: 0;
        font-family: var(--font);
        background: var(--bg);
        color: var(--text);
      }
      main {
        width: min(100% - 2rem, 52rem);
        margin-inline: auto;
        padding: 2.5rem 0 4rem;
      }
      a { color: var(--primary); text-decoration: none; }
      h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); letter-spacing: -0.03em; margin: 0 0 0.5rem; }
      .short { color: var(--primary); font-weight: 600; margin-bottom: 0.85rem; }
      .lead { color: var(--muted); line-height: 1.7; margin-bottom: 1.5rem; }
      .topics { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; }
      .topics a {
        font-size: 0.82rem; font-weight: 600;
        padding: 0.35rem 0.75rem; border-radius: 999px;
        background: #fff; border: 1px solid var(--border); color: var(--text);
      }
      .topics a:hover { border-color: rgba(37,99,235,.3); color: var(--primary); }
      .list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.85rem; }
      .list a {
        display: block; background: #fff; border: 1px solid var(--border);
        border-radius: var(--radius); padding: 1.1rem 1.2rem; color: inherit;
      }
      .list a:hover { border-color: rgba(37,99,235,.25); }
      .list h2 { margin: 0 0 0.35rem; font-size: 1.05rem; }
      .list p { margin: 0; color: var(--muted); font-size: 0.92rem; line-height: 1.55; }
      .list time { font-size: 0.8rem; color: var(--muted); }
      .back { display: inline-block; margin-bottom: 1.25rem; font-weight: 600; font-size: 0.92rem; }
      .empty { color: var(--muted); padding: 1rem 0; }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <a class="back" href="/categories">← All categories</a>
      <p style="font-size: 1.75rem; margin: 0 0 0.5rem;">{category.icon}</p>
      <h1>{category.name}</h1>
      <p class="short">{category.short}</p>
      <p class="lead">{category.description}</p>

      <div class="topics" aria-label="Topics in this category">
        {category.topics.map((t: string) => (
          <a href={`/blog?q=${encodeURIComponent(t)}`}>{t}</a>
        ))}
      </div>

      <h2 style="font-size: 1.15rem; margin-bottom: 0.85rem;">
        Related articles ({related.length})
      </h2>

      {related.length > 0 ? (
        <ul class="list">
          {related.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">No matching articles yet. More coming soon.</p>
      )}
    </main>
    <Footer />
  </body>
</html>
