---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');

// Helper: count posts that mention a category keyword in title/description/tags (simple heuristic)
function countByKeyword(keyword: string) {
  const lower = keyword.toLowerCase();
  return posts.filter((p) => {
    const title = (p.data.title || '').toLowerCase();
    const desc = (p.data.description || '').toLowerCase();
    const tags = (p.data.tags || []).join(' ').toLowerCase();
    return title.includes(lower) || desc.includes(lower) || tags.includes(lower);
  }).length;
}

const categories = [
  {
    slug: 'artificial-intelligence',
    name: 'Artificial Intelligence',
    icon: '🤖',
    short: 'AI Models, Agents & Automation',
    description:
      'From foundation models and agents to enterprise adoption and governance — deep analysis on how AI is reshaping products, work, and strategy.',
    topics: ['Large Language Models', 'AI Agents', 'Automation', 'Responsible AI', 'Enterprise AI'],
    color: '#2563eb',
  },
  {
    slug: 'business',
    name: 'Business Strategy',
    icon: '📈',
    short: 'Strategy, Leadership & Growth',
    description:
      'Frameworks, leadership lessons, and strategic insights for operators and executives navigating competitive markets and digital transformation.',
    topics: ['Competitive Strategy', 'Leadership', 'Digital Transformation', 'Operations', 'Go-to-Market'],
    color: '#0ea5e9',
  },
  {
    slug: 'startups',
    name: 'Startups',
    icon: '🚀',
    short: 'Funding, Product & Growth',
    description:
      'Practical playbooks for founders — fundraising, product-market fit, scaling teams, and building durable companies in a noisy landscape.',
    topics: ['Fundraising', 'Product-Market Fit', 'Growth', 'Founder Lessons', 'Scaling'],
    color: '#8b5cf6',
  },
  {
    slug: 'cybersecurity',
    name: 'Cybersecurity',
    icon: '🔒',
    short: 'Security, Privacy & Risk',
    description:
      'Threats, architecture patterns, zero-trust, privacy, and the operational reality of defending modern cloud and AI-powered systems.',
    topics: ['Zero Trust', 'Cloud Security', 'Privacy', 'Threat Intelligence', 'Secure Architecture'],
    color: '#ef4444',
  },
  {
    slug: 'cloud',
    name: 'Cloud Computing',
    icon: '☁️',
    short: 'AWS, Azure, GCP & Platforms',
    description:
      'Architecture, cost, reliability, and platform strategy across the major clouds — plus the patterns that actually work at scale.',
    topics: ['AWS', 'Azure', 'GCP', 'Architecture', 'Platform Engineering'],
    color: '#06b6d4',
  },
  {
    slug: 'future-of-work',
    name: 'Future of Work',
    icon: '🌐',
    short: 'Teams, Tools & Culture',
    description:
      'How AI, remote work, and new tooling are changing roles, productivity, and organizational design — with grounded takeaways.',
    topics: ['Remote Work', 'AI-Augmented Roles', 'Productivity', 'Culture', 'Talent'],
    color: '#10b981',
  },
  {
    slug: 'creator-economy',
    name: 'Creator Economy',
    icon: '🎥',
    short: 'Content, Audience & Monetization',
    description:
      'Building audiences, monetizing expertise, and the platforms and models powering the next generation of independent creators and media.',
    topics: ['Audience Growth', 'Monetization', 'Platforms', 'Content Strategy', 'Personal Brand'],
    color: '#f59e0b',
  },
  {
    slug: 'digital-transformation',
    name: 'Digital Transformation',
    icon: '⚙️',
    short: 'Technology & Organizational Change',
    description:
      'How established organizations adopt new technology, modernize systems, and change operating models without losing momentum.',
    topics: ['Modernization', 'Change Management', 'Legacy Systems', 'Operating Models', 'ROI'],
    color: '#6366f1',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Categories — DigiSone Global" description={SITE_DESCRIPTION} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --surface: #ffffff;
        --surface-2: #f8fafc;
        --text: #0b1220;
        --muted: #64748b;
        --muted-2: #94a3b8;
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --primary-soft: rgba(37, 99, 235, 0.1);
        --accent: #6366f1;
        --border: rgba(15, 23, 42, 0.07);
        --border-strong: rgba(15, 23, 42, 0.12);
        --radius: 20px;
        --radius-lg: 28px;
        --radius-xl: 36px;
        --shadow-xs: 0 2px 8px rgba(15, 23, 42, 0.04);
        --shadow-sm: 0 8px 24px rgba(15, 23, 42, 0.05);
        --shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
        --shadow-lg: 0 32px 80px rgba(15, 23, 42, 0.12);
        --font-sans: "Inter", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        --font-display: "Space Grotesk", "Inter", system-ui, sans-serif;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--text);
        background: #f1f5f9;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        background:
          radial-gradient(ellipse 90% 60% at 10% -15%, rgba(37, 99, 235, 0.16), transparent 55%),
          radial-gradient(ellipse 70% 50% at 95% 5%, rgba(99, 102, 241, 0.12), transparent 50%),
          radial-gradient(ellipse 50% 40% at 50% 110%, rgba(37, 99, 235, 0.06), transparent 60%);
        pointer-events: none;
        z-index: -1;
      }

      main {
        width: 100%;
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      h1, h2, h3 {
        font-family: var(--font-display);
        font-weight: 700;
        letter-spacing: -0.04em;
        margin: 0;
      }

      p {
        line-height: 1.7;
        margin: 0;
      }

      .section {
        margin: 5.5rem 0;
      }

      /* ========== HERO ========== */
      .cat-hero {
        padding: 5rem 0 3rem;
        max-width: 780px;
      }

      .cat-hero .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.5rem 1.05rem 0.5rem 0.7rem;
        border-radius: 999px;
        background: var(--surface);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-xs);
        font-size: 0.84rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
      }

      .cat-hero .badge .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.22);
      }

      .cat-hero h1 {
        font-size: clamp(2.6rem, 6vw, 4.2rem);
        line-height: 1.05;
        letter-spacing: -0.05em;
        margin-bottom: 1.25rem;
      }

      .cat-hero h1 .gradient {
        background: linear-gradient(120deg, #2563eb 0%, #6366f1 45%, #8b5cf6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .cat-hero .lead {
        font-size: 1.15rem;
        color: var(--muted);
        max-width: 580px;
        line-height: 1.8;
      }

      .cat-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem 2.5rem;
        margin-top: 2.25rem;
        padding-top: 1.75rem;
        border-top: 1px solid var(--border);
      }

      .cat-stat strong {
        font-family: var(--font-display);
        font-size: 1.4rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        display: block;
      }

      .cat-stat span {
        font-size: 0.82rem;
        color: var(--muted);
        font-weight: 500;
      }

      /* ========== CATEGORY GRID ========== */
      .categories-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 1.5rem;
      }

      .category-card {
        position: relative;
        display: flex;
        flex-direction: column;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 2rem 1.85rem;
        box-shadow: var(--shadow-xs);
        transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.3s ease;
        overflow: hidden;
        height: 100%;
      }

      .category-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: var(--cat-color, var(--primary));
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .category-card:hover {
        transform: translateY(-7px);
        box-shadow: var(--shadow);
        border-color: rgba(37, 99, 235, 0.14);
      }

      .category-card:hover::before {
        opacity: 1;
      }

      .category-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.25rem;
      }

      .category-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.1), rgba(99, 102, 241, 0.1));
        flex-shrink: 0;
      }

      .category-count {
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--muted);
        background: var(--surface-2);
        padding: 0.3rem 0.65rem;
        border-radius: 8px;
        white-space: nowrap;
      }

      .category-card h2 {
        font-size: 1.35rem;
        margin-bottom: 0.4rem;
        letter-spacing: -0.03em;
      }

      .category-short {
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--primary);
        margin-bottom: 0.85rem;
      }

      .category-desc {
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.65;
        flex-grow: 1;
        margin-bottom: 1.35rem;
      }

      .topic-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-bottom: 1.5rem;
      }

      .topic-tag {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--muted);
        background: var(--surface-2);
        border: 1px solid var(--border);
        padding: 0.28rem 0.6rem;
        border-radius: 6px;
      }

      .category-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 1.15rem;
        border-top: 1px solid var(--border);
        margin-top: auto;
      }

      .category-link {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--primary);
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: gap 0.3s var(--ease);
      }

      .category-card:hover .category-link {
        gap: 0.65rem;
      }

      /* ========== ALL TOPICS STRIP ========== */
      .topics-strip {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        padding: 2.5rem 2.25rem;
        box-shadow: var(--shadow-xs);
      }

      .topics-strip h2 {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
      }

      .topics-strip > p {
        color: var(--muted);
        margin-bottom: 1.75rem;
        font-size: 1rem;
      }

      .all-topics {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
      }

      .all-topics a {
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.5rem 0.95rem;
        border-radius: 999px;
        background: var(--surface-2);
        border: 1px solid var(--border);
        color: var(--text);
        transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s var(--ease);
      }

      .all-topics a:hover {
        background: var(--primary-soft);
        border-color: rgba(37, 99, 235, 0.2);
        color: var(--primary);
        transform: translateY(-2px);
      }

      /* ========== CTA ========== */
      .cta {
        position: relative;
        padding: 4.5rem 3.25rem;
        border-radius: var(--radius-xl);
        text-align: center;
        background: linear-gradient(150deg, #0b1220 0%, #1e293b 45%, #0f172a 100%);
        color: white;
        box-shadow: var(--shadow-lg);
        overflow: hidden;
      }

      .cta::before {
        content: "";
        position: absolute;
        top: -45%;
        left: -25%;
        width: 70%;
        height: 90%;
        background: radial-gradient(circle, rgba(37, 99, 235, 0.28), transparent 68%);
        pointer-events: none;
      }

      .cta::after {
        content: "";
        position: absolute;
        bottom: -35%;
        right: -20%;
        width: 55%;
        height: 75%;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.22), transparent 68%);
        pointer-events: none;
      }

      .cta-inner {
        position: relative;
        z-index: 1;
      }

      .cta h2 {
        font-size: clamp(1.85rem, 4vw, 2.65rem);
        margin-bottom: 0.85rem;
        letter-spacing: -0.045em;
      }

      .cta p {
        max-width: 480px;
        margin: 0 auto 2rem;
        color: rgba(255, 255, 255, 0.7);
        font-size: 1.05rem;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.95rem 1.55rem;
        border-radius: 14px;
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: -0.01em;
        transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
        border: none;
        cursor: pointer;
        font-family: inherit;
      }

      .btn:hover {
        transform: translateY(-3px);
      }

      .btn-primary {
        background: white;
        color: #0b1220;
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.25);
      }

      .btn-primary:hover {
        box-shadow: 0 14px 36px rgba(0, 0, 0, 0.35);
      }

      .btn-secondary {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: white;
      }

      .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.14);
      }

      .cta-buttons {
        display: flex;
        gap: 0.9rem;
        justify-content: center;
        flex-wrap: wrap;
      }

      /* ========== RESPONSIVE ========== */
      @media (max-width: 768px) {
        main {
          padding: 0 1.15rem;
        }

        .cat-hero {
          padding: 3.5rem 0 2rem;
        }

        .cat-hero h1 {
          font-size: clamp(2.25rem, 9vw, 3.2rem);
        }

        .categories-grid {
          grid-template-columns: 1fr;
        }

        .topics-strip {
          padding: 1.85rem 1.5rem;
        }

        .cta {
          padding: 3.25rem 1.5rem;
        }

        .cta-buttons {
          flex-direction: column;
        }

        .btn {
          width: 100%;
        }

        .section {
          margin: 4.25rem 0;
        }
      }

      @media (max-width: 480px) {
        .category-card {
          padding: 1.6rem 1.35rem;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <!-- Hero -->
      <section class="cat-hero">
        <div class="badge">
          <span class="dot"></span>
          Explore by topic
        </div>
        <h1>
          Categories that<br />
          <span class="gradient">map the future</span>
        </h1>
        <p class="lead">
          Dive into focused collections on AI, business strategy, startups,
          security, cloud, and the future of work — written for founders,
          operators, and technology leaders.
        </p>
        <div class="cat-stats">
          <div class="cat-stat">
            <strong>{categories.length}</strong>
            <span>Core categories</span>
          </div>
          <div class="cat-stat">
            <strong>{posts.length}+</strong>
            <span>Articles published</span>
          </div>
          <div class="cat-stat">
            <strong>Weekly</strong>
            <span>New insights</span>
          </div>
        </div>
      </section>

      <!-- Categories grid -->
      <section class="section" style="margin-top: 1rem;">
        <div class="categories-grid">
          {categories.map((cat) => {
            const count = countByKeyword(cat.name.split(' ')[0]);
            return (
              <a
                href={`/blog?category=${cat.slug}`}
                class="category-card"
                style={`--cat-color: ${cat.color}`}
              >
                <div class="category-top">
                  <div class="category-icon">{cat.icon}</div>
                  <span class="category-count">
                    {count > 0 ? `\( {count} article \){count === 1 ? '' : 's'}` : 'Explore'}
                  </span>
                </div>
                <h2>{cat.name}</h2>
                <div class="category-short">{cat.short}</div>
                <p class="category-desc">{cat.description}</p>
                <div class="topic-tags">
                  {cat.topics.slice(0, 4).map((t) => (
                    <span class="topic-tag">{t}</span>
                  ))}
                </div>
                <div class="category-footer">
                  <span class="category-link">
                    View articles
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </section>

      <!-- All topics -->
      <section class="section">
        <div class="topics-strip">
          <h2>Browse by topic</h2>
          <p>Jump straight into the themes we cover most often.</p>
          <div class="all-topics">
            {[
              'AI Agents',
              'Large Language Models',
              'Enterprise Automation',
              'Fundraising',
              'Product-Market Fit',
              'Zero Trust',
              'Cloud Architecture',
              'AWS',
              'Azure',
              'GCP',
              'Remote Work',
              'Digital Transformation',
              'Leadership',
              'Cybersecurity',
              'Creator Economy',
              'Platform Engineering',
              'Privacy',
              'Growth Strategy',
            ].map((topic) => (
              <a href={`/blog?q=${encodeURIComponent(topic)}`}>{topic}</a>
            ))}
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="section">
        <div class="cta">
          <div class="cta-inner">
            <h2>Never miss a new insight</h2>
            <p>
              Get the weekly technology briefing — curated analysis on AI,
              strategy, security, and the future of work.
            </p>
            <div class="cta-buttons">
              <a href="/#newsletter" class="btn btn-primary">
                Subscribe to Briefing
              </a>
              <a href="/blog" class="btn btn-secondary">
                Browse all articles
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
