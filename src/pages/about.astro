---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="About — DigiSone Global" description={SITE_DESCRIPTION} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --surface: #ffffff;
        --surface-2: #f8fafc;
        --surface-glass: rgba(255, 255, 255, 0.65);
        --text: #0b1220;
        --muted: #64748b;
        --muted-2: #94a3b8;
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --primary-soft: rgba(37, 99, 235, 0.1);
        --accent: #6366f1;
        --violet: #8b5cf6;
        --border: rgba(15, 23, 42, 0.07);
        --border-strong: rgba(15, 23, 42, 0.12);
        --radius: 20px;
        --radius-lg: 28px;
        --radius-xl: 36px;
        --shadow-xs: 0 2px 8px rgba(15, 23, 42, 0.04);
        --shadow-sm: 0 8px 24px rgba(15, 23, 42, 0.05);
        --shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
        --shadow-lg: 0 32px 80px rgba(15, 23, 42, 0.12);
        --font-sans: "Inter", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        --font-display: "Space Grotesk", "Inter", system-ui, sans-serif;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--text);
        background: #f1f5f9;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        background:
          radial-gradient(ellipse 90% 60% at 10% -15%, rgba(37, 99, 235, 0.16), transparent 55%),
          radial-gradient(ellipse 70% 50% at 95% 5%, rgba(99, 102, 241, 0.12), transparent 50%),
          radial-gradient(ellipse 50% 40% at 50% 110%, rgba(37, 99, 235, 0.06), transparent 60%);
        pointer-events: none;
        z-index: -1;
      }

      main {
        width: 100%;
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      h1, h2, h3 {
        font-family: var(--font-display);
        font-weight: 700;
        letter-spacing: -0.04em;
        margin: 0;
      }

      p {
        line-height: 1.75;
        margin: 0;
      }

      .section {
        margin: 6.5rem 0;
      }

      .section-header {
        max-width: 680px;
        margin-bottom: 2.75rem;
      }

      .section-label {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--primary);
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.09em;
        margin-bottom: 0.85rem;
      }

      .section-title {
        font-size: clamp(1.9rem, 3.6vw, 2.85rem);
        letter-spacing: -0.045em;
        margin-bottom: 0.9rem;
      }

      .section-desc {
        font-size: 1.1rem;
        color: var(--muted);
      }

      /* ========== HERO ========== */
      .about-hero {
        padding: 5rem 0 3.5rem;
        max-width: 820px;
      }

      .about-hero .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.5rem 1.05rem 0.5rem 0.7rem;
        border-radius: 999px;
        background: var(--surface);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-xs);
        font-size: 0.84rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
      }

      .about-hero .badge .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.22);
      }

      .about-hero h1 {
        font-size: clamp(2.7rem, 6.5vw, 4.4rem);
        line-height: 1.05;
        letter-spacing: -0.05em;
        margin-bottom: 1.4rem;
      }

      .about-hero h1 .gradient {
        background: linear-gradient(120deg, #2563eb 0%, #6366f1 45%, #8b5cf6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .about-hero .lead {
        font-size: 1.2rem;
        color: var(--muted);
        max-width: 640px;
        line-height: 1.8;
      }

      /* ========== MISSION ========== */
      .mission-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
      }

      .mission-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 2.4rem 2.1rem;
        box-shadow: var(--shadow-xs);
        transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
      }

      .mission-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow);
      }

      .mission-card.primary {
        background: linear-gradient(145deg, #0b1220 0%, #1e293b 100%);
        color: white;
        border-color: transparent;
      }

      .mission-card.primary p {
        color: rgba(255, 255, 255, 0.72);
      }

      .mission-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        margin-bottom: 1.35rem;
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.12), rgba(99, 102, 241, 0.12));
      }

      .mission-card.primary .mission-icon {
        background: rgba(255, 255, 255, 0.1);
      }

      .mission-card h3 {
        font-size: 1.35rem;
        margin-bottom: 0.75rem;
      }

      .mission-card p {
        color: var(--muted);
        font-size: 1.02rem;
      }

      /* ========== FOCUS AREAS ========== */
      .focus-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.35rem;
      }

      .focus-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.85rem;
        box-shadow: var(--shadow-xs);
        transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s ease;
        position: relative;
        overflow: hidden;
      }

      .focus-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--primary), var(--accent));
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .focus-card:hover {
        transform: translateY(-6px);
        box-shadow: var(--shadow);
        border-color: rgba(37, 99, 235, 0.14);
      }

      .focus-card:hover::before {
        opacity: 1;
      }

      .focus-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        margin-bottom: 1.1rem;
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.1), rgba(99, 102, 241, 0.1));
      }

      .focus-card h3 {
        font-size: 1.15rem;
        margin-bottom: 0.5rem;
      }

      .focus-card p {
        color: var(--muted);
        font-size: 0.95rem;
      }

      /* ========== WHO FOR ========== */
      .audience-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1.25rem;
      }

      .audience-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.75rem 1.5rem;
        box-shadow: var(--shadow-xs);
        text-align: center;
        transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
      }

      .audience-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-sm);
      }

      .audience-card .emoji {
        font-size: 1.85rem;
        margin-bottom: 0.9rem;
      }

      .audience-card h3 {
        font-size: 1.05rem;
        margin-bottom: 0.4rem;
      }

      .audience-card p {
        font-size: 0.88rem;
        color: var(--muted);
      }

      /* ========== VALUES ========== */
      .values-list {
        display: flex;
        flex-direction: column;
        gap: 1.15rem;
      }

      .value-item {
        display: grid;
        grid-template-columns: 64px 1fr;
        gap: 1.35rem;
        align-items: start;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.6rem 1.75rem;
        box-shadow: var(--shadow-xs);
        transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
      }

      .value-item:hover {
        transform: translateX(6px);
        box-shadow: var(--shadow-sm);
      }

      .value-num {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: var(--primary-soft);
        color: var(--primary);
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .value-item h3 {
        font-size: 1.15rem;
        margin-bottom: 0.4rem;
      }

      .value-item p {
        color: var(--muted);
        font-size: 0.98rem;
      }

      /* ========== STORY ========== */
      .story {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        padding: 3.25rem 3rem;
        box-shadow: var(--shadow);
        position: relative;
        overflow: hidden;
      }

      .story::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 5px;
        height: 100%;
        background: linear-gradient(180deg, #2563eb, #6366f1, #8b5cf6);
      }

      .story p {
        font-size: 1.12rem;
        color: var(--muted);
        max-width: 780px;
      }

      .story p + p {
        margin-top: 1.25rem;
      }

      /* ========== CTA ========== */
      .cta {
        position: relative;
        padding: 4.75rem 3.25rem;
        border-radius: var(--radius-xl);
        text-align: center;
        background: linear-gradient(150deg, #0b1220 0%, #1e293b 45%, #0f172a 100%);
        color: white;
        box-shadow: var(--shadow-lg);
        overflow: hidden;
      }

      .cta::before {
        content: "";
        position: absolute;
        top: -45%;
        left: -25%;
        width: 70%;
        height: 90%;
        background: radial-gradient(circle, rgba(37, 99, 235, 0.28), transparent 68%);
        pointer-events: none;
      }

      .cta::after {
        content: "";
        position: absolute;
        bottom: -35%;
        right: -20%;
        width: 55%;
        height: 75%;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.22), transparent 68%);
        pointer-events: none;
      }

      .cta-inner {
        position: relative;
        z-index: 1;
      }

      .cta h2 {
        font-size: clamp(1.85rem, 4vw, 2.75rem);
        margin-bottom: 0.9rem;
        letter-spacing: -0.045em;
      }

      .cta p {
        max-width: 500px;
        margin: 0 auto 2rem;
        color: rgba(255, 255, 255, 0.7);
        font-size: 1.08rem;
      }

      .cta-buttons {
        display: flex;
        gap: 0.9rem;
        justify-content: center;
        flex-wrap: wrap;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.95rem 1.55rem;
        border-radius: 14px;
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: -0.01em;
        transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
        border: none;
        cursor: pointer;
        font-family: inherit;
      }

      .btn:hover {
        transform: translateY(-3px);
      }

      .btn-primary {
        background: white;
        color: #0b1220;
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.25);
      }

      .btn-primary:hover {
        box-shadow: 0 14px 36px rgba(0, 0, 0, 0.35);
      }

      .btn-secondary {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: white;
      }

      .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.14);
      }

      /* ========== RESPONSIVE ========== */
      @media (max-width: 992px) {
        .mission-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 768px) {
        main {
          padding: 0 1.15rem;
        }

        .section {
          margin: 4.5rem 0;
        }

        .about-hero {
          padding: 3.5rem 0 2.5rem;
        }

        .about-hero h1 {
          font-size: clamp(2.3rem, 9vw, 3.2rem);
        }

        .story {
          padding: 2.25rem 1.65rem;
        }

        .cta {
          padding: 3.25rem 1.5rem;
        }

        .cta-buttons {
          flex-direction: column;
        }

        .btn {
          width: 100%;
        }

        .value-item {
          grid-template-columns: 1fr;
          gap: 0.9rem;
        }
      }

      @media (max-width: 480px) {
        .focus-grid,
        .audience-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <!-- Hero -->
      <section class="about-hero">
        <div class="badge">
          <span class="dot"></span>
          About DigiSone Global
        </div>
        <h1>
          Clarity for the<br />
          <span class="gradient">next era of technology</span>
        </h1>
        <p class="lead">
          DigiSone Global is an independent publication delivering premium insights
          on Artificial Intelligence, business strategy, startups, cybersecurity,
          cloud, and the future of work — built for founders, operators, and
          technology leaders who need signal, not noise.
        </p>
      </section>

      <!-- Mission & Vision -->
      <section class="section">
        <div class="section-header">
          <div class="section-label">Purpose</div>
          <h2 class="section-title">Mission & Vision</h2>
          <p class="section-desc">
            We exist to help ambitious professionals understand what’s changing —
            and what to do about it.
          </p>
        </div>
        <div class="mission-grid">
          <div class="mission-card primary">
            <div class="mission-icon">🎯</div>
            <h3>Our Mission</h3>
            <p>
              To deliver sharp, practical analysis on technology and business
              so leaders can make better decisions in a rapidly shifting world.
            </p>
          </div>
          <div class="mission-card">
            <div class="mission-icon">🔭</div>
            <h3>Our Vision</h3>
            <p>
              A global community of builders and decision-makers who stay ahead
              of change with clarity, depth, and actionable insight.
            </p>
          </div>
        </div>
      </section>

      <!-- What we cover -->
      <section class="section">
        <div class="section-header">
          <div class="section-label">Coverage</div>
          <h2 class="section-title">What We Write About</h2>
          <p class="section-desc">
            Focused topics. Serious depth. No fluff.
          </p>
        </div>
        <div class="focus-grid">
          <div class="focus-card">
            <div class="focus-icon">🤖</div>
            <h3>Artificial Intelligence</h3>
            <p>Models, agents, automation, and the real-world impact of AI systems.</p>
          </div>
          <div class="focus-card">
            <div class="focus-icon">📈</div>
            <h3>Business Strategy</h3>
            <p>Leadership, growth, competitive advantage, and digital transformation.</p>
          </div>
          <div class="focus-card">
            <div class="focus-icon">🚀</div>
            <h3>Startups</h3>
            <p>Funding, product-market fit, scaling, and founder playbooks.</p>
          </div>
          <div class="focus-card">
            <div class="focus-icon">🔒</div>
            <h3>Cybersecurity</h3>
            <p>Threats, privacy, zero-trust, and protecting modern infrastructure.</p>
          </div>
          <div class="focus-card">
            <div class="focus-icon">☁️</div>
            <h3>Cloud & Infrastructure</h3>
            <p>AWS, Azure, GCP, architecture patterns, and platform strategy.</p>
          </div>
          <div class="focus-card">
            <div class="focus-icon">🌐</div>
            <h3>Future of Work</h3>
            <p>Remote teams, AI-augmented roles, productivity, and culture shifts.</p>
          </div>
        </div>
      </section>

      <!-- Who it's for -->
      <section class="section">
        <div class="section-header">
          <div class="section-label">Audience</div>
          <h2 class="section-title">Built For</h2>
          <p class="section-desc">
            People who build, lead, and decide.
          </p>
        </div>
        <div class="audience-grid">
          <div class="audience-card">
            <div class="emoji">👨‍💼</div>
            <h3>Founders & Operators</h3>
            <p>Running products, teams, and companies at speed.</p>
          </div>
          <div class="audience-card">
            <div class="emoji">👩‍💻</div>
            <h3>Technology Leaders</h3>
            <p>CTOs, eng managers, and architects shaping systems.</p>
          </div>
          <div class="audience-card">
            <div class="emoji">📊</div>
            <h3>Strategy & Product</h3>
            <p>People turning market signals into decisions.</p>
          </div>
          <div class="audience-card">
            <div class="emoji">🎓</div>
            <h3>Curious Professionals</h3>
            <p>Anyone serious about staying sharp on tech & business.</p>
          </div>
        </div>
      </section>

      <!-- Values -->
      <section class="section">
        <div class="section-header">
          <div class="section-label">Principles</div>
          <h2 class="section-title">How We Work</h2>
          <p class="section-desc">
            The standards behind every piece we publish.
          </p>
        </div>
        <div class="values-list">
          <div class="value-item">
            <div class="value-num">01</div>
            <div>
              <h3>Depth over noise</h3>
              <p>
                We skip the headline cycle. Every article aims for real analysis,
                frameworks, and takeaways you can use.
              </p>
            </div>
          </div>
          <div class="value-item">
            <div class="value-num">02</div>
            <div>
              <h3>Independent by design</h3>
              <p>
                No corporate agenda. We write what we believe is useful —
                not what serves a vendor narrative.
              </p>
            </div>
          </div>
          <div class="value-item">
            <div class="value-num">03</div>
            <div>
              <h3>Actionable by default</h3>
              <p>
                Insight without next steps is incomplete. We prioritize clarity
                and practical application.
              </p>
            </div>
          </div>
          <div class="value-item">
            <div class="value-num">04</div>
            <div>
              <h3>Respect for the reader</h3>
              <p>
                Your time is limited. We write tightly, design cleanly, and
                avoid filler.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Story -->
      <section class="section">
        <div class="section-header">
          <div class="section-label">Origin</div>
          <h2 class="section-title">Why DigiSone Global Exists</h2>
        </div>
        <div class="story">
          <p>
            Technology is moving faster than most organizations can absorb.
            AI, cloud platforms, security threats, and new business models
            collide every week — yet most coverage stays surface-level or
            driven by hype.
          </p>
          <p>
            DigiSone Global was created to cut through that. We focus on the
            intersection of technology and business: what is changing, why it
            matters, and how leaders can respond with clarity.
          </p>
          <p>
            Whether you are shipping product, scaling a company, or setting
            strategy, our goal is simple — help you stay informed, sharp, and
            ready for what comes next.
          </p>
        </div>
      </section>

      <!-- CTA -->
      <section class="section">
        <div class="cta">
          <div class="cta-inner">
            <h2>Stay ahead of the curve</h2>
            <p>
              Read the latest insights or join the weekly briefing for
              curated analysis on AI, strategy, and digital transformation.
            </p>
            <div class="cta-buttons">
              <a href="/blog" class="btn btn-primary">
                Explore Articles
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              <a href="/#newsletter" class="btn btn-secondary">
                Get Weekly Briefing
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
