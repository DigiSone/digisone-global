---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<html lang="en">
  <head>
    <BaseHead title={`Page Not Found — ${SITE_TITLE}`} description="The page you are looking for does not exist." />
    <meta name="robots" content="noindex, follow" />
  </head>
  <body>
    <Header />
    <main style="min-height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 2rem;">
      <div>
        <h1>404</h1>
        <p>This page does not exist.</p>
        <a href="/" class="c-btn c-btn-primary">← Back to Home</a>
      </div>
    </main>
    <Footer />
  </body>
</html>
