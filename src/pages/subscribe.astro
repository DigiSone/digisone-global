---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const title = `Subscribe — ${SITE_TITLE}`;
const description =
	'Subscribe to the DigiSone Global weekly technology briefing. Insights on AI, business strategy, cybersecurity, cloud and the future of work — from info@digisone.com.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			:root {
				--bg: #f1f5f9;
				--surface: #ffffff;
				--text: #0b1220;
				--muted: #475569;
				--muted-2: #64748b;
				--primary: #2563eb;
				--primary-dark: #1d4ed8;
				--primary-soft: rgba(37, 99, 235, 0.1);
				--border: rgba(15, 23, 42, 0.08);
				--radius: 1.25rem;
				--radius-lg: 1.75rem;
				--shadow: 0 1rem 2.5rem rgba(15, 23, 42, 0.08);
				--shadow-lg: 0 1.5rem 3rem rgba(15, 23, 42, 0.12);
				--font: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
				--ease: cubic-bezier(0.22, 1, 0.36, 1);
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				margin: 0;
				font-family: var(--font);
				color: var(--text);
				background: var(--bg);
				-webkit-font-smoothing: antialiased;
			}

			body::before {
				content: '';
				position: fixed;
				inset: 0;
				z-index: -1;
				pointer-events: none;
				background:
					radial-gradient(ellipse 80% 50% at 10% -10%, rgba(37, 99, 235, 0.14), transparent 55%),
					radial-gradient(ellipse 60% 40% at 92% 0%, rgba(99, 102, 241, 0.1), transparent 50%);
			}

			main {
				width: min(100% - 2rem, 72rem);
				margin-inline: auto;
				padding-block: 2.75rem 4.5rem;
			}

			a {
				color: var(--primary);
				text-decoration: none;
			}

			a:hover {
				color: var(--primary-dark);
			}

			h1,
			h2,
			h3 {
				margin: 0;
				letter-spacing: -0.03em;
				line-height: 1.15;
			}

			p {
				margin: 0;
				line-height: 1.7;
			}

			.layout {
				display: grid;
				grid-template-columns: 1.05fr 0.95fr;
				gap: 2rem;
				align-items: start;
			}

			/* Left copy */
			.intro .badge {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				padding: 0.4rem 0.9rem;
				border-radius: 999px;
				background: var(--surface);
				border: 1px solid var(--border);
				font-size: 0.8rem;
				font-weight: 600;
				margin-bottom: 1.15rem;
				box-shadow: 0 0.15rem 0.5rem rgba(15, 23, 42, 0.04);
			}

			.intro .dot {
				width: 0.45rem;
				height: 0.45rem;
				border-radius: 50%;
				background: #22c55e;
				box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
			}

			.intro h1 {
				font-size: clamp(2rem, 4.5vw, 3.1rem);
				margin-bottom: 1rem;
				max-width: 12ch;
			}

			.intro h1 span {
				background: linear-gradient(120deg, #2563eb, #6366f1 50%, #8b5cf6);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}

			.intro-lead {
				color: var(--muted);
				font-size: 1.08rem;
				max-width: 34rem;
				margin-bottom: 1.5rem;
			}

			.points {
				display: grid;
				gap: 0.85rem;
				margin-bottom: 1.75rem;
			}

			.point {
				display: flex;
				gap: 0.75rem;
				align-items: flex-start;
			}

			.point-icon {
				width: 2rem;
				height: 2rem;
				border-radius: 0.6rem;
				display: grid;
				place-items: center;
				flex-shrink: 0;
				background: var(--primary-soft);
				color: var(--primary);
				font-size: 0.85rem;
				font-weight: 700;
			}

			.point strong {
				display: block;
				font-size: 0.95rem;
				margin-bottom: 0.15rem;
			}

			.point span {
				font-size: 0.88rem;
				color: var(--muted);
			}

			.contact-panel {
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 1.15rem 1.2rem;
				box-shadow: 0 0.2rem 0.75rem rgba(15, 23, 42, 0.04);
			}

			.contact-panel h2 {
				font-size: 0.8rem;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: var(--muted);
				margin-bottom: 0.55rem;
			}

			.contact-panel p {
				font-size: 0.92rem;
				color: var(--muted);
				margin-bottom: 0.65rem;
			}

			.contact-mail {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				font-weight: 700;
				font-size: 1rem;
				color: var(--primary);
			}

			.contact-mail:hover {
				color: var(--primary-dark);
			}

			/* Form card */
			.card {
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow);
				padding: clamp(1.5rem, 3vw, 2.25rem);
			}

			.card h2 {
				font-size: 1.25rem;
				margin-bottom: 0.35rem;
			}

			.card-intro {
				color: var(--muted);
				font-size: 0.95rem;
				margin-bottom: 1.35rem;
			}

			.msg {
				display: none;
				margin-bottom: 1rem;
				padding: 0.85rem 1rem;
				border-radius: 0.75rem;
				font-size: 0.92rem;
				font-weight: 500;
			}

			.msg.show {
				display: block;
			}

			.msg.ok {
				background: #ecfdf5;
				color: #065f46;
				border: 1px solid #a7f3d0;
			}

			.msg.err {
				background: #fef2f2;
				color: #991b1b;
				border: 1px solid #fecaca;
			}

			.form {
				display: grid;
				gap: 1rem;
			}

			.label {
				display: grid;
				gap: 0.4rem;
				font-size: 0.88rem;
				font-weight: 600;
			}

			.input {
				min-height: 2.9rem;
				padding: 0.75rem 0.95rem;
				border-radius: 0.75rem;
				border: 1px solid var(--border);
				background: #f8fafc;
				color: var(--text);
				font: inherit;
				width: 100%;
				transition: border-color 0.15s ease, background 0.15s ease;
			}

			.input::placeholder {
				color: var(--muted-2);
			}

			.input:focus {
				outline: 2px solid #93c5fd;
				outline-offset: 1px;
				background: #fff;
				border-color: rgba(37, 99, 235, 0.35);
			}

			.btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.45rem;
				min-height: 2.9rem;
				padding: 0.75rem 1.25rem;
				border: none;
				border-radius: 0.75rem;
				background: linear-gradient(135deg, #2563eb, #1d4ed8);
				color: #fff;
				font-weight: 700;
				font: inherit;
				cursor: pointer;
				box-shadow: 0 0.5rem 1.25rem rgba(37, 99, 235, 0.3);
				transition: transform 0.2s var(--ease), box-shadow 0.2s ease;
			}

			.btn:hover {
				transform: translateY(-2px);
				box-shadow: 0 0.75rem 1.5rem rgba(37, 99, 235, 0.4);
			}

			.btn:disabled {
				opacity: 0.7;
				cursor: not-allowed;
				transform: none;
			}

			.btn:focus-visible {
				outline: 2px solid var(--primary);
				outline-offset: 2px;
			}

			.note {
				margin-top: 0.9rem;
				font-size: 0.82rem;
				color: var(--muted);
				text-align: center;
			}

			.trust-row {
				margin-top: 1.35rem;
				padding-top: 1.15rem;
				border-top: 1px solid var(--border);
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 0.75rem;
				text-align: center;
			}

			.trust-row strong {
				display: block;
				font-size: 0.95rem;
			}

			.trust-row span {
				font-size: 0.75rem;
				color: var(--muted);
			}

			.back-wrap {
				margin-top: 1.75rem;
				text-align: center;
			}

			.back {
				font-size: 0.92rem;
				font-weight: 600;
			}

			@media (max-width: 860px) {
				.layout {
					grid-template-columns: 1fr;
					gap: 1.5rem;
				}

				.intro h1 {
					max-width: none;
				}

				.trust-row {
					grid-template-columns: 1fr;
					text-align: left;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="layout">
				<!-- Left: value + contact -->
				<section class="intro" aria-label="Newsletter introduction">
					<div class="badge">
						<span class="dot" aria-hidden="true"></span>
						Weekly technology briefing
					</div>
					<h1>Stay ahead with <span>DigiSone Global</span></h1>
					<p class="intro-lead">
						Actionable insights on Artificial Intelligence, business strategy, cybersecurity, cloud
						and the future of work — written for founders, operators and technology leaders.
					</p>

					<div class="points">
						<div class="point">
							<div class="point-icon" aria-hidden="true">1</div>
							<div>
								<strong>Signal, not noise</strong>
								<span>Curated analysis instead of endless headlines.</span>
							</div>
						</div>
						<div class="point">
							<div class="point-icon" aria-hidden="true">2</div>
							<div>
								<strong>Built for professionals</strong>
								<span>AI, strategy, security and digital growth in one briefing.</span>
							</div>
						</div>
						<div class="point">
							<div class="point-icon" aria-hidden="true">3</div>
							<div>
								<strong>From our desk to yours</strong>
								<span>Mail comes from our official address — info@digisone.com.</span>
							</div>
						</div>
					</div>

					<div class="contact-panel">
						<h2>Conversation & support</h2>
						<p>
							Questions about the briefing, partnerships, or your subscription? Email us directly —
							we read and reply from our business inbox.
						</p>
						<a class="contact-mail" href="mailto:info@digisone.com">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<path
									d="M4 6h16v12H4V6z"
									stroke="currentColor"
									stroke-width="1.75"
									stroke-linejoin="round"></path>
								<path
									d="M4 7l8 6 8-6"
									stroke="currentColor"
									stroke-width="1.75"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
							info@digisone.com
						</a>
					</div>
				</section>

				<!-- Right: form -->
				<section class="card" aria-label="Subscribe form">
					<h2>Subscribe free</h2>
					<p class="card-intro">
						Join the list. We’ll send the weekly briefing from
						<strong>info@digisone.com</strong>.
					</p>

					<div id="form-msg" class="msg" role="status" aria-live="polite"></div>

					<form class="form" id="subscribe-form">
						<label class="label" for="email">
							Email address
							<input
								class="input"
								id="email"
								name="email"
								type="email"
								autocomplete="email"
								required
								placeholder="you@company.com"
							/>
						</label>

						<label class="label" for="name">
							Name
							<span style="font-weight: 500; color: var(--muted-2)">(optional)</span>
							<input
								class="input"
								id="name"
								name="name"
								type="text"
								autocomplete="name"
								placeholder="Your name"
							/>
						</label>

						<button class="btn" id="submit-btn" type="submit">
							Subscribe to briefing
							<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
								<path
									d="M3 8h10M9 4l4 4-4 4"
									stroke="currentColor"
									stroke-width="1.75"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</button>
					</form>

					<p class="note">
						No spam. Unsubscribe anytime. Your email stays with DigiSone Global — we don’t sell
						lists.
					</p>

					<div class="trust-row" aria-label="Promises">
						<div>
							<strong>Weekly</strong>
							<span>One briefing</span>
						</div>
						<div>
							<strong>Official</strong>
							<span>info@digisone.com</span>
						</div>
						<div>
							<strong>Private</strong>
							<span>No resale</span>
						</div>
					</div>
				</section>
			</div>

			<p class="back-wrap">
				<a class="back" href="/">← Back to home</a>
			</p>
		</main>
		<Footer />

		<script>
			const form = document.getElementById('subscribe-form');
			const msg = document.getElementById('form-msg');
			const btn = document.getElementById('submit-btn');

			form?.addEventListener('submit', async (e) => {
				e.preventDefault();
				if (!form || !msg || !btn) return;

				msg.className = 'msg';
				msg.textContent = '';
				btn.setAttribute('disabled', 'true');
				btn.textContent = 'Subscribing…';

				const data = new FormData(form);
				const payload = {
					email: String(data.get('email') || ''),
					name: String(data.get('name') || ''),
				};

				try {
					const res = await fetch('/api/subscribe', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(payload),
					});

					const json = await res.json().catch(() => ({}));

					if (!res.ok || !json.ok) {
						msg.className = 'msg show err';
						msg.textContent =
							json.error ||
							'Could not subscribe right now. Email info@digisone.com and we will add you.';
						return;
					}

					msg.className = 'msg show ok';
					msg.textContent =
						json.message ||
						'Subscribed. Watch your inbox for mail from info@digisone.com.';

					if (json.status === 'created') form.reset();
				} catch {
					msg.className = 'msg show err';
					msg.textContent =
						'Network error. Please try again or write to info@digisone.com.';
				} finally {
					btn.removeAttribute('disabled');
					btn.innerHTML =
						'Subscribe to briefing <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
				}
			});
		</script>
	</body>
</html>
