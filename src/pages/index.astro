---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script src="https://cdn.tailwindcss.com"></script>
	</head>
	<body class="bg-[#0a0c14] text-slate-200 font-sans antialiased overflow-x-hidden">

		<!-- Dynamic Background -->
		<div class="fixed inset-0 bg-[radial-gradient(at_top_right,#4f46e520_0%,transparent_50%)] pointer-events-none"></div>
		<div class="fixed inset-0 bg-[radial-gradient(at_bottom_left,#7c3aed20_0%,transparent_50%)] pointer-events-none"></div>

		<!-- Header -->
		<div class="sticky top-0 z-50 backdrop-blur-2xl bg-[#0a0c14]/90 border-b border-white/5">
			<Header />
		</div>

		<main class="relative max-w-6xl mx-auto px-6 pt-20 pb-24">

			<!-- Hero -->
			<section class="min-h-[85vh] flex items-center">
				<div class="max-w-4xl">
					<div class="inline-flex items-center gap-3 px-5 py-2 rounded-3xl bg-white/5 border border-white/10 text-sm mb-6">
						<div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></div>
						<span class="uppercase tracking-[2px] text-emerald-400 text-xs font-medium">Enterprise Intelligence Platform</span>
					</div>

					<h1 class="text-6xl md:text-7xl lg:text-[5.2rem] font-bold tracking-tighter leading-none text-white mb-8">
					The Future of<br>
					<span class="bg-gradient-to-r from-indigo-300 via-violet-300 to-cyan-200 bg-clip-text text-transparent">Digital Knowledge</span>
					</h1>

					<p class="text-xl text-slate-400 max-w-2xl leading-relaxed">
						DigiSone Global delivers premium, actionable intelligence on Artificial Intelligence, Technology Strategy, Digital Transformation and Business Innovation.
					</p>

					<div class="flex flex-wrap gap-5 mt-12">
						<a href="#topics" class="px-10 py-5 bg-white text-black rounded-2xl font-semibold text-lg hover:bg-white/90 transition-all active:scale-95">
							Explore Knowledge Hub
						</a>
						<a href="#" class="px-10 py-5 border border-white/30 hover:border-white/70 rounded-2xl font-medium transition-all">
							Watch 2-min Intro
						</a>
					</div>

					<div class="mt-16 flex items-center gap-8 text-sm text-slate-400">
						<div>Trusted by professionals at</div>
						<div class="flex gap-8 opacity-75">
							<span class="font-medium">Google</span>
							<span class="font-medium">Microsoft</span>
							<span class="font-medium">Amazon</span>
						</div>
					</div>
				</div>
			</section>

			<!-- Trust + Stats Bar -->
			<div class="border-y border-white/10 py-8 flex flex-wrap justify-between items-center gap-8 text-sm">
				<div class="flex items-center gap-8">
					<div>4.98 <span class="text-amber-400">★</span></div>
					<div>28,450+ Professionals</div>
					<div>142 Countries</div>
				</div>
				<div class="text-emerald-400 font-medium">Featured in Forbes • TechCrunch • YourStory</div>
			</div>

			<!-- Core Purpose -->
			<section class="py-24 grid md:grid-cols-12 gap-16 items-center">
				<div class="md:col-span-5">
					<div class="sticky top-28">
						<span class="text-xs uppercase tracking-widest text-violet-400 font-semibold">Our Philosophy</span>
						<h2 class="text-5xl font-bold leading-none tracking-tighter text-white mt-6">
							Knowledge should be<br>beautiful and useful.
						</h2>
					</div>
				</div>
				<div class="md:col-span-7 space-y-8">
					<div class="bg-white/5 border border-white/10 rounded-3xl p-10">
						<p class="text-lg leading-relaxed text-slate-300">
							We don’t just publish content. We engineer clarity. Every article, guide, and insight is crafted to help you make better decisions, faster — whether you’re a founder, developer, marketer, or executive.
						</p>
					</div>
				</div>
			</section>

			<!-- Topics -->
			<section id="topics" class="py-16">
				<div class="text-center mb-12">
					<h2 class="text-4xl font-bold tracking-tight">Knowledge Domains</h2>
					<p class="text-slate-400 mt-3">Deep, practical intelligence across the most important areas of technology and business</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					{[
						{ icon: "🚀", title: "Emerging Technology", desc: "AI, Quantum, Blockchain, Spatial Computing" },
						{ icon: "🧠", title: "Artificial Intelligence", desc: "LLMs, Agents, Automation & Ethics" },
						{ icon: "💻", title: "Modern Development", desc: "Full-stack, Performance & Developer Experience" },
						{ icon: "📈", title: "Growth & Marketing", desc: "SEO, Content Systems & Demand Generation" },
						{ icon: "🏗️", title: "Business Strategy", desc: "Scaling, Leadership & Organizational Design" },
						{ icon: "⚡", title: "High Performance", desc: "Productivity, Systems & Personal Mastery" }
					].map((item) => (
						<div class="group p-8 bg-white/[0.03] hover:bg-white/[0.06] border border-transparent hover:border-white/10 rounded-3xl transition-all duration-500 hover:-translate-y-2">
							<div class="text-5xl mb-6 opacity-80 group-hover:opacity-100 transition-opacity">{item.icon}</div>
							<h3 class="text-2xl font-semibold text-white mb-3">{item.title}</h3>
							<p class="text-slate-400">{item.desc}</p>
							<div class="mt-8 text-xs uppercase tracking-widest text-indigo-400 font-medium inline-flex items-center gap-2">
								Explore →
							</div>
						</div>
					))}
				</div>
			</section>

			<!-- Final Enterprise CTA -->
			<section class="bg-gradient-to-br from-white/5 to-transparent border border-white/10 rounded-3xl p-16 text-center">
				<h2 class="text-4xl font-bold mb-6">Ready to elevate your thinking?</h2>
				<p class="text-slate-400 max-w-md mx-auto mb-10">
					Join thousands of forward-thinking professionals who read DigiSone Global every week.
				</p>
				<button onclick="alert('Newsletter signup coming soon ✨')" 
					class="px-12 py-6 bg-gradient-to-r from-indigo-500 to-violet-600 text-white text-lg font-semibold rounded-2xl hover:brightness-110 transition-all">
					Subscribe to Weekly Intelligence
				</button>
			</section>

		</main>

		<!-- Footer -->
		<div class="border-t border-white/5 bg-black/40">
			<Footer />
		</div>

		<script>
			// Subtle scroll progress (optional enterprise polish)
			window.addEventListener('scroll', () => {
				const scroll = window.scrollY;
				document.documentElement.style.setProperty('--scroll', Math.min(scroll / 500, 1));
			});
		</script>
	</body>
</html>
