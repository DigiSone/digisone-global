
---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');

const sortedPosts = posts.sort(
	(a, b) =>
		new Date(b.data.pubDate).getTime() -
		new Date(a.data.pubDate).getTime()
);

const featuredPost = sortedPosts[0];
const latestPosts = sortedPosts.slice(1, 7);
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead
		title="DigiSone Global"
		description={SITE_DESCRIPTION}
	/>

	<style>
		:root {
			--surface: #ffffff;
			--surface-alt: #f8fafc;

			--text: #0f172a;
			--muted: #64748b;

			--primary: #2563eb;
			--primary-dark: #1d4ed8;

			--border: #e5e7eb;

			--radius: 24px;

			--shadow:
				0 20px 50px rgba(15, 23, 42, 0.08);
		}

		html {
			scroll-behavior: smooth;
		}

		body {
			margin: 0;
			color: var(--text);
			background:
				radial-gradient(
					circle at top left,
					rgba(37,99,235,.08),
					transparent 40%
				),
				radial-gradient(
					circle at top right,
					rgba(79,70,229,.08),
					transparent 40%
				),
				#f8fafc;
		}

		main {
	width: 100%;
	max-width: 1400px;
	margin: 0 auto;
	padding: 0 1.25rem;
	box-sizing: border-box;
}

		a {
			color: inherit;
			text-decoration: none;
		}

		h1,
		h2,
		h3 {
			font-weight: 800;
			letter-spacing: -0.03em;
		}

		p {
			line-height: 1.8;
		}

		.section {
			margin: 7rem 0;
		}

		.section-title {
			font-size: clamp(2rem, 4vw, 3rem);
			margin-bottom: 2rem;
		}

	.hero {
	padding: 4rem 0;
	display: grid;
	grid-template-columns: minmax(0,1.2fr) minmax(0,.8fr);
	gap: 2rem;
	align-items: center;
}

		.hero-badge {
			display: inline-flex;
			align-items: center;
			gap: .5rem;
			padding: 10px 18px;
			border-radius: 999px;
			background: white;
			border: 1px solid var(--border);
			box-shadow: var(--shadow);
			font-size: .9rem;
			font-weight: 600;
		}

		.hero h1 {
			font-size: clamp(3.5rem, 8vw, 6rem);
			line-height: .95;
			margin: 1.5rem 0;
		}

		.hero p {
			font-size: 1.2rem;
			color: var(--muted);
			max-width: 700px;
		}

		.hero-buttons {
	display: flex;
	gap: 1rem;
	margin-top: 2rem;
	flex-wrap: wrap;
}

.hero-buttons a {
	flex: 0 0 auto;
}

		.btn {
			padding: 14px 24px;
			border-radius: 14px;
			font-weight: 700;
			display: inline-block;
			transition: .3s;
		}

		.btn:hover {
			transform: translateY(-3px);
		}

		.btn-primary {
			background: var(--primary);
			color: white;
		}

		.btn-primary:hover {
			background: var(--primary-dark);
		}

		.btn-secondary {
			background: white;
			border: 1px solid var(--border);
		}

		.hero-card {
			background: rgba(255,255,255,.8);
			backdrop-filter: blur(20px);
			border-radius: 28px;
			padding: 2rem;
			border: 1px solid rgba(255,255,255,.5);
			box-shadow: var(--shadow);
		}

		.hero-card ul {
			padding-left: 1.2rem;
			line-height: 2;
			color: var(--muted);
		}

		.featured {
			background: white;
			border-radius: 32px;
			overflow: hidden;
			border: 1px solid var(--border);
			box-shadow: var(--shadow);
		}

	.featured-image {
	height: clamp(250px, 45vw, 520px);
			background-size: cover;
			background-position: center;
			background-repeat: no-repeat;
			background-color: #2563eb;
		}

		.featured-content {
			padding: 3rem;
		}

		.featured-label {
			color: var(--primary);
			font-size: .9rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 1px;
		}

		.featured-meta {
			color: var(--muted);
			font-size: .95rem;
			margin-top: .75rem;
		}

		.featured h2 {
			font-size: clamp(2rem,4vw,3.5rem);
			line-height: 1.1;
			margin: 1rem 0;
		}

		.featured p {
			color: var(--muted);
			max-width: 850px;
		}

		.grid {
	display: grid;
	grid-template-columns:
		repeat(auto-fit,minmax(320px,1fr));
	gap: 2rem;
	margin-top: 2rem;
	align-items: stretch;
}
}

		.card {
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	height: 100%;
	padding: 2rem;
	border-radius: 24px;
	background: white;
	border: 1px solid var(--border);
	box-shadow: var(--shadow);
	transition: .3s;
}

		.card::before {
			content: "";
			position: absolute;
			inset: 0;
			background:
				linear-gradient(
					180deg,
					transparent,
					rgba(37,99,235,.03)
				);
			opacity: 0;
			transition: .3s;
		}

		.card:hover {
			transform: translateY(-8px);
		}

		.card:hover::before {
			opacity: 1;
		}

		.card-meta {
			font-size: .85rem;
			color: var(--muted);
			margin-bottom: .5rem;
		}

		.category-tag {
			color: var(--primary);
			font-size: .85rem;
			font-weight: 700;
			text-transform: uppercase;
		}

		.card p {
			color: var(--muted);
		}

		.categories {
			display: grid;
			grid-template-columns:
				repeat(auto-fit,minmax(250px,1fr));
			gap: 1.25rem;
		}

		.category {
			background: white;
			padding: 2rem;
			border-radius: 24px;
			border: 1px solid var(--border);
			box-shadow: var(--shadow);
		}

		.category-icon {
			font-size: 2rem;
			margin-bottom: 1rem;
		}

		.newsletter {
			padding: 5rem 3rem;
			border-radius: 32px;
			text-align: center;
			background:
				linear-gradient(
					135deg,
					#0f172a,
					#1e293b
				);
			color: white;
			box-shadow: var(--shadow);
		}

	.newsletter h2 {
	color: #ffffff;
	font-size: clamp(2rem,5vw,4rem);
	margin-bottom: 1rem;
}

		.newsletter p {
			max-width: 700px;
			margin: auto;
			color: rgba(255,255,255,.8);
		}

		.newsletter-form {
			display: flex;
			gap: 1rem;
			max-width: 650px;
			margin: 2rem auto 0;
			flex-wrap: wrap;
		}

		.newsletter-form input {
			flex: 1;
			padding: 16px;
			border-radius: 12px;
			border: 1px solid rgba(255,255,255,.15);
			background: rgba(255,255,255,.1);
			color: white;
		}

		.newsletter-form input::placeholder {
			color: rgba(255,255,255,.6);
		}

		.newsletter-form button {
			padding: 16px 24px;
			border: none;
			border-radius: 12px;
			background: white;
			color: #0f172a;
			font-weight: 700;
			cursor: pointer;
		}

	@media (max-width: 992px) {

	.hero {
		grid-template-columns: 1fr;
	}

	.featured-content {
		padding: 2rem;
	}
}

@media (max-width: 768px) {

	main {
		padding: 0 1rem;
	}

	.section {
		margin: 4rem 0;
	}

	.hero {
		padding: 2rem 0;
		gap: 1.5rem;
	}

	.hero h1 {
		font-size: clamp(2.5rem, 10vw, 4rem);
	}

	.hero p {
		font-size: 1rem;
	}

	.hero-buttons {
		flex-direction: column;
	}

	.btn {
		width: 100%;
		text-align: center;
		box-sizing: border-box;
	}

	.featured-content {
		padding: 1.5rem;
	}

	.grid {
		grid-template-columns: 1fr;
	}

	.categories {
		grid-template-columns: 1fr;
	}

	.newsletter {
		padding: 2rem 1.25rem;
	}

	.newsletter-form {
		flex-direction: column;
	}

	.newsletter-form input,
	.newsletter-form button {
		width: 100%;
		box-sizing: border-box;
	}
}

@media (max-width: 480px) {

	.hero-badge {
		font-size: .8rem;
	}

	.hero h1 {
		font-size: 2.3rem;
	}

	.section-title {
		font-size: 1.8rem;
	}

.section .card {
	min-height: 220px;
}


	.card,
	.category {
		padding: 1.25rem;
	}
}
	</style>
</head>

<body>

<Header />

<main>

	<section class="hero">

		<div>

			<div class="hero-badge">
				🚀 Trusted by founders, operators & technology leaders
			</div>

			<h1>
				The Future of Technology,
				Business & AI.
			</h1>

			<p>
				DigiSone Global delivers premium insights on Artificial Intelligence,
				Business Strategy, Startups, Cybersecurity, Cloud Computing,
				Digital Transformation and the Future of Work.
			</p>

			<div class="hero-buttons">

				<a href="/blog" class="btn btn-primary">
					Read Latest Insights
				</a>

				<a href="#newsletter" class="btn btn-secondary">
					Get Weekly Briefing
				</a>

			</div>

		</div>

		<div class="hero-card">

			<h3>Trending Topics</h3>

			<ul>
				<li>AI Agents & Autonomous Systems</li>
				<li>Enterprise Automation</li>
				<li>Future of Work</li>
				<li>Cybersecurity & Privacy</li>
				<li>Cloud Infrastructure</li>
				<li>Startup Growth Strategies</li>
			</ul>

		</div>

	</section>

{featuredPost && (

<section class="featured">

	<a
		href={`/blog/${featuredPost.slug}/`}
		style="display:block;"
	>

		<div
			class="featured-image"
			style={`background-image:url(${featuredPost.data.heroImage || ''})`}
		></div>

		<div class="featured-content">

			<div class="featured-label">
				Featured Story
			</div>

			<div class="featured-meta">
				{new Date(featuredPost.data.pubDate).toLocaleDateString()}
			</div>

			<h2>
				{featuredPost.data.title}
			</h2>

			<p>
				{featuredPost.data.description}
			</p>

			<div class="btn btn-primary">
				Read Article
			</div>

		</div>

	</a>

</section>

)}

	<section class="section">

		<h2 class="section-title">
			Latest Articles
		</h2>

		<div class="grid">

			{latestPosts.map((post) => (

				<a
					href={`/blog/${post.slug}/`}
					class="card"
				>

					<div class="category-tag">
						Article
					</div>

					<div class="card-meta">
						5 min read
					</div>

					<h3>
						{post.data.title}
					</h3>

					<p>
						{post.data.description}
					</p>

				</a>

			))}

		</div>

	</section>

	<section class="section">

		<h2 class="section-title">
			Explore Categories
		</h2>

		<div class="categories">

			<div class="category">
				<div class="category-icon">🤖</div>
				<h3>Artificial Intelligence</h3>
				<p>AI Models, Agents & Automation</p>
			</div>

			<div class="category">
				<div class="category-icon">📈</div>
				<h3>Business</h3>
				<p>Strategy & Leadership</p>
			</div>

			<div class="category">
				<div class="category-icon">🚀</div>
				<h3>Startups</h3>
				<p>Funding & Growth</p>
			</div>

			<div class="category">
				<div class="category-icon">🔒</div>
				<h3>Cybersecurity</h3>
				<p>Security & Privacy</p>
			</div>

			<div class="category">
				<div class="category-icon">☁️</div>
				<h3>Cloud</h3>
				<p>AWS, Azure & GCP</p>
			</div>

			<div class="category">
				<div class="category-icon">🎥</div>
				<h3>Creator Economy</h3>
				<p>Content & Monetization</p>
			</div>

		</div>

	</section>

	<section class="section">
		<h2 class="section-title">
			Why Professionals Read DigiSone Global
		</h2>

		<div class="grid">

			<div class="card">
				<h3>Deep Analysis</h3>
				<p>
					Practical insights beyond headlines and breaking news.
				</p>
			</div>

			<div class="card">
				<h3>Expert Perspectives</h3>
				<p>
					Technology, leadership and innovation from industry experts.
				</p>
			</div>

			<div class="card">
				<h3>Actionable Takeaways</h3>
				<p>
					Frameworks, lessons and strategies you can apply immediately.
				</p>
			</div>

		</div>

	</section>

	<section
		id="newsletter"
		class="section"
	>

		<div class="newsletter">

			<h2>
				Get the Weekly Technology Briefing
			</h2>

			<p>
				Actionable insights on AI, business strategy,
				cybersecurity and digital transformation.
			</p>

			<form class="newsletter-form">

				<input
					type="email"
					placeholder="Enter your email address"
				/>

				<button>
					Subscribe
				</button>

			</form>

		</div>

	</section>

</main>

<Footer />

</body>
</html>
