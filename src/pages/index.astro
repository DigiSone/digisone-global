---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate));

const featured = sortedPosts[0];
const latest = sortedPosts.slice(1, 7);
const trending = sortedPosts.slice(0, 4);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
	<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	<meta name="keywords" content="Technology, AI, Startups, Digital Transformation, Innovation" />
	<style>
		.hero-bg {
			background: linear-gradient(180deg, rgba(10,12,20,0.85) 30%, rgba(10,12,20,0.95) 80%), 
					  url('https://picsum.photos/id/1015/2000/1200') center/cover no-repeat;
		}
		.card-hover {
			transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		}
		.card-hover:hover {
			transform: translateY(-12px) scale(1.02);
			box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.4);
		}
	</style>
</head>
<body class="bg-[#05060f] text-slate-200 font-sans antialiased">

	<!-- Navigation -->
	<header class="sticky top-0 z-50 border-b border-white/5 bg-[#05060f]/90 backdrop-blur-2xl">
		<Header />
	</header>

	<!-- HERO -->
	<section class="hero-bg min-h-screen flex items-center relative">
		<div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#05060f]/70 to-[#05060f]"></div>
		
		<div class="relative max-w-5xl mx-auto px-6 pt-20">
			{featured && (
				<div class="max-w-3xl">
					<div class="flex items-center gap-3 text-sm uppercase tracking-[3px] text-emerald-400 mb-6">
						<div class="w-px h-3 bg-emerald-400"></div>
						EXCLUSIVE FEATURE
					</div>
					<a href={`/blog/${featured.slug}`} class="block group">
						<h1 class="text-6xl md:text-7xl font-bold tracking-tighter leading-none text-white group-hover:text-indigo-200 transition-colors">
							{featured.data.title}
						</h1>
					</a>
					<p class="mt-6 text-xl text-slate-300 max-w-2xl">
						{featured.data.description}
					</p>
					<div class="mt-10 flex items-center gap-6">
						<a href={`/blog/${featured.slug}`} 
						   class="inline-flex items-center px-10 py-5 bg-white text-black rounded-2xl font-semibold text-lg hover:bg-indigo-500 hover:text-white transition-all">
							Read In-Depth Analysis
						</a>
						<div class="text-sm">
							<p class="font-medium">{featured.data.author}</p>
							<p class="text-slate-400 text-xs">
								{new Date(featured.data.pubDate).toLocaleDateString('en-GB', {day:'numeric', month:'long', year:'numeric'})}
							</p>
						</div>
					</div>
				</div>
			)}
		</div>

		<div class="absolute bottom-12 left-1/2 flex flex-col items-center">
			<div class="text-xs tracking-widest opacity-60 mb-3">SCROLL TO DISCOVER</div>
			<div class="w-px h-12 bg-gradient-to-b from-transparent via-slate-400 to-transparent"></div>
		</div>
	</section>

	<div class="max-w-7xl mx-auto px-6 -mt-12 relative z-10">

		<!-- Stats -->
		<div class="grid grid-cols-3 md:grid-cols-6 gap-6 bg-[#0a0c17] border border-white/5 rounded-3xl p-8 mb-20">
			<div class="text-center"><div class="text-4xl font-semibold text-white">142k</div><div class="text-xs uppercase tracking-widest text-slate-500">Monthly Readers</div></div>
			<div class="text-center"><div class="text-4xl font-semibold text-white">380</div><div class="text-xs uppercase tracking-widest text-slate-500">In-Depth Reports</div></div>
			<div class="text-center"><div class="text-4xl font-semibold text-white">94</div><div class="text-xs uppercase tracking-widest text-slate-500">Countries</div></div>
			<div class="text-center"><div class="text-4xl font-semibold text-white">4.98</div><div class="text-xs uppercase tracking-widest text-amber-400">Average Rating</div></div>
		</div>

		<!-- Latest Articles -->
		<section class="mb-24">
			<div class="flex justify-between items-baseline mb-10">
				<h2 class="text-4xl font-bold tracking-tight">Latest Intelligence</h2>
				<a href="/blog" class="text-indigo-400 hover:text-white text-sm font-medium">All Stories →</a>
			</div>

			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				{latest.map(post => (
					<article class="card-hover bg-[#0f1322] border border-white/5 rounded-3xl overflow-hidden group">
						<img src={post.data.image || `https://picsum.photos/id/${80 + Math.floor(Math.random()*40)}/800/450`} 
							 class="w-full h-52 object-cover" alt={post.data.title} />
						<div class="p-7">
							<div class="text-xs uppercase text-violet-400 mb-3">{post.data.category}</div>
							<a href={`/blog/${post.slug}`} class="block text-xl font-semibold leading-tight group-hover:text-indigo-300 transition-colors line-clamp-3">
								{post.data.title}
							</a>
							<p class="text-slate-400 text-sm mt-4 line-clamp-2">{post.data.description}</p>
							<div class="mt-6 text-xs flex justify-between text-slate-500">
								<span>{post.data.author}</span>
								<span>{new Date(post.data.pubDate).toLocaleDateString('en-US', {month:'short', day:'numeric'})}</span>
							</div>
						</div>
					</article>
				))}
			</div>
		</section>

		<div class="grid lg:grid-cols-12 gap-12">

			<!-- Trending -->
			<section class="lg:col-span-5">
				<h3 class="uppercase text-xs tracking-[2px] text-rose-400 font-semibold mb-8">Trending Now</h3>
				<div class="space-y-8">
					{trending.map((post, i) => (
						<a href={`/blog/${post.slug}`} class="flex gap-6 group">
							<div class="text-5xl font-bold text-white/10 group-hover:text-white/30 transition-colors">{(i+1).toString().padStart(2,'0')}</div>
							<div class="flex-1">
								<h4 class="font-medium leading-tight group-hover:text-white/80">{post.data.title}</h4>
								<p class="text-xs text-slate-500 mt-3">{post.data.author}</p>
							</div>
						</a>
					))}
				</div>
			</section>

			<!-- Newsletter + Categories -->
			<div class="lg:col-span-7 space-y-8">

				<!-- Newsletter -->
				<div class="bg-gradient-to-br from-indigo-600/10 to-violet-600/10 border border-white/10 rounded-3xl p-12">
					<div class="max-w-md">
						<h3 class="text-3xl font-semibold">Stay Ahead of the Curve</h3>
						<p class="mt-3 text-slate-400">Premium weekly digest of the most important tech and business stories.</p>
						<div class="mt-8 flex gap-3">
							<input type="email" placeholder="your@email.com" 
								class="flex-1 bg-white/5 border border-white/20 rounded-2xl px-6 py-5 focus:outline-none focus:border-indigo-400" />
							<button class="px-10 bg-white text-black font-semibold rounded-2xl hover:bg-indigo-400 hover:text-white transition-all">Join</button>
						</div>
					</div>
				</div>

				<!-- Categories -->
				<div>
					<h3 class="uppercase text-xs tracking-widest mb-6 text-slate-400">Topics</h3>
					<div class="flex flex-wrap gap-3">
						{["AI & Machine Learning", "Enterprise Software", "Venture Capital", "Cybersecurity", "Future of Work", "Semiconductors", "SaaS", "Web3"].map(cat => (
							<span class="px-6 py-3 bg-white/5 hover:bg-white/10 border border-white/10 rounded-3xl text-sm transition-all cursor-pointer hover:border-indigo-400">
								{cat}
							</span>
						))}
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Final CTA -->
	<section class="mt-32 bg-gradient-to-r from-indigo-500/10 via-violet-500/10 to-transparent border-y border-white/5 py-20 text-center">
		<p class="text-2xl font-light max-w-2xl mx-auto">
			High-signal intelligence for those who shape tomorrow.
		</p>
		<button class="mt-10 px-14 py-6 bg-white text-black text-lg font-semibold rounded-3xl hover:scale-105 transition-transform">
			Become a Premium Member
		</button>
	</section>

	<Footer />
</body>
</html>
