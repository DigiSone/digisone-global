---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');

const sortedPosts = posts.sort(
	(a, b) =>
		new Date(b.data.pubDate).getTime() -
		new Date(a.data.pubDate).getTime()
);

const featuredPost = sortedPosts[0];
const latestPosts = sortedPosts.slice(1, 7);
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead
		title="DigiSone Global"
		description={SITE_DESCRIPTION}
	/>

	<style>
		:root {
			--bg: #fafafa;
			--surface: #ffffff;
			--surface-alt: #f6f8fb;

			--text: #0f172a;
			--muted: #64748b;

			--primary: #2563eb;
			--border: #e5e7eb;

			--radius: 24px;

			--shadow:
				0 10px 40px rgba(15, 23, 42, 0.06);
		}

		body {
			margin: 0;
			background: var(--bg);
			color: var(--text);
		}

		main {
			max-width: 1400px;
			margin: auto;
			padding: 2rem;
		}

		a {
			color: inherit;
			text-decoration: none;
		}

		.hero {
			padding: 5rem 0;
			display: grid;
			grid-template-columns: 1.2fr .8fr;
			gap: 3rem;
			align-items: center;
		}

		.hero h1 {
			font-size: clamp(3rem, 8vw, 5.5rem);
			line-height: 1;
			margin-bottom: 1rem;
			letter-spacing: -2px;
		}

		.hero p {
			font-size: 1.2rem;
			color: var(--muted);
			line-height: 1.8;
			max-width: 650px;
		}

		.hero-buttons {
			display: flex;
			gap: 1rem;
			margin-top: 2rem;
			flex-wrap: wrap;
		}

		.btn {
			padding: 14px 22px;
			border-radius: 14px;
			font-weight: 600;
			display: inline-block;
		}

		.btn-primary {
			background: var(--primary);
			color: white;
		}

		.btn-secondary {
			border: 1px solid var(--border);
			background: white;
		}

		.hero-card {
			background: white;
			border-radius: var(--radius);
			padding: 2rem;
			border: 1px solid var(--border);
			box-shadow: var(--shadow);
		}

		.section {
			margin: 6rem 0;
		}

		.section-title {
			font-size: 2rem;
			margin-bottom: 2rem;
		}

		.featured {
			background: white;
			border-radius: 32px;
			overflow: hidden;
			border: 1px solid var(--border);
			box-shadow: var(--shadow);
		}

		.featured-image {
			height: 420px;
			background: linear-gradient(
				135deg,
				#2563eb,
				#4f46e5
			);
		}

		.featured-content {
			padding: 2rem;
		}

		.featured-label {
			color: var(--primary);
			font-weight: 700;
			font-size: .9rem;
			text-transform: uppercase;
			letter-spacing: 1px;
		}

		.featured h2 {
			font-size: 2.5rem;
			margin: 1rem 0;
			line-height: 1.1;
		}

		.featured p {
			color: var(--muted);
		}

		.grid {
			display: grid;
			grid-template-columns: repeat(auto-fit,minmax(300px,1fr));
			gap: 1.5rem;
		}

		.card {
			background: white;
			border: 1px solid var(--border);
			border-radius: 24px;
			padding: 1.5rem;
			transition: .3s;
			box-shadow: var(--shadow);
		}

		.card:hover {
			transform: translateY(-8px);
		}

		.card h3 {
			margin-top: .5rem;
			line-height: 1.3;
		}

		.card p {
			color: var(--muted);
		}

		.category-tag {
			color: var(--primary);
			font-size: .85rem;
			font-weight: 700;
			text-transform: uppercase;
		}

		.categories {
			display: grid;
			grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
			gap: 1rem;
		}

		.category {
			background: white;
			padding: 2rem;
			border-radius: 20px;
			border: 1px solid var(--border);
			box-shadow: var(--shadow);
		}

		.newsletter {
			background: white;
			border-radius: 32px;
			padding: 4rem;
			text-align: center;
			border: 1px solid var(--border);
			box-shadow: var(--shadow);
		}

		.newsletter h2 {
			font-size: 3rem;
			margin-bottom: 1rem;
		}

		.newsletter p {
			color: var(--muted);
			max-width: 700px;
			margin: auto;
		}

		.newsletter-form {
			margin-top: 2rem;
			display: flex;
			max-width: 650px;
			margin-inline: auto;
			gap: 1rem;
			flex-wrap: wrap;
		}

		.newsletter-form input {
			flex: 1;
			padding: 16px;
			border-radius: 12px;
			border: 1px solid var(--border);
		}

		.newsletter-form button {
			padding: 16px 24px;
			border: none;
			border-radius: 12px;
			background: var(--primary);
			color: white;
			font-weight: 600;
		}

		.stats {
			display: grid;
			grid-template-columns: repeat(4,1fr);
			gap: 1rem;
		}

		.stat {
			background: white;
			padding: 2rem;
			text-align: center;
			border-radius: 20px;
			border: 1px solid var(--border);
			box-shadow: var(--shadow);
		}

		.stat h3 {
			font-size: 2rem;
			color: var(--primary);
			margin: 0;
		}

		.stat p {
			color: var(--muted);
		}

		@media(max-width:900px){
			.hero{
				grid-template-columns:1fr;
			}

			.stats{
				grid-template-columns:1fr 1fr;
			}
		}

		@media(max-width:600px){
			.stats{
				grid-template-columns:1fr;
			}

			.newsletter{
				padding:2rem;
			}
		}
	</style>
</head>

<body>

<Header />

<main>

	<section class="hero">

		<div>
			<h1>
				Technology Insights
				For The Modern World.
			</h1>

			<p>
				DigiSone Global is a premium publication covering
				Artificial Intelligence, Business Strategy,
				Startups, Cybersecurity, Cloud Computing,
				Creator Economy and Enterprise Innovation.
			</p>

			<div class="hero-buttons">
				<a href="/blog" class="btn btn-primary">
					Explore Articles
				</a>

				<a href="#newsletter" class="btn btn-secondary">
					Join Newsletter
				</a>
			</div>
		</div>

		<div class="hero-card">
			<h3>Trending Topics</h3>

			<ul>
				<li>AI Agents</li>
				<li>Enterprise Automation</li>
				<li>Future of Work</li>
				<li>Cybersecurity</li>
				<li>Cloud Infrastructure</li>
			</ul>
		</div>

	</section>

	{featuredPost && (
		<section class="featured">

			<div class="featured-image"></div>

			<div class="featured-content">

				<div class="featured-label">
					Featured Story
				</div>

				<h2>{featuredPost.data.title}</h2>

				<p>{featuredPost.data.description}</p>

				<a class="btn btn-primary" href={`/blog/${featuredPost.slug}/`}>
					Read Article
				</a>

			</div>

		</section>
	)}

	<section class="section">

		<h2 class="section-title">
			Latest Articles
		</h2>

		<div class="grid">

			{latestPosts.map((post) => (
				<a href={`/blog/${post.slug}/`} class="card">

					<div class="category-tag">
						Article
					</div>

					<h3>{post.data.title}</h3>

					<p>{post.data.description}</p>

				</a>
			))}

		</div>

	</section>

	<section class="section">

		<h2 class="section-title">
			Explore Categories
		</h2>

		<div class="categories">

			<div class="category">
				<h3>Artificial Intelligence</h3>
				<p>AI, LLMs & Agents</p>
			</div>

			<div class="category">
				<h3>Business</h3>
				<p>Strategy & Leadership</p>
			</div>

			<div class="category">
				<h3>Startups</h3>
				<p>Funding & Growth</p>
			</div>

			<div class="category">
				<h3>Cybersecurity</h3>
				<p>Security & Privacy</p>
			</div>

			<div class="category">
				<h3>Cloud</h3>
				<p>AWS, Azure & GCP</p>
			</div>

			<div class="category">
				<h3>Creators</h3>
				<p>Content & Monetization</p>
			</div>

		</div>

	</section>

	<section id="newsletter" class="section">

		<div class="newsletter">

			<h2>
				Stay Ahead of Technology.
			</h2>

			<p>
				Join professionals, founders and decision-makers
				reading DigiSone Global every week.
			</p>

			<form class="newsletter-form">

				<input
					type="email"
					placeholder="Enter your email"
				/>

				<button>
					Subscribe
				</button>

			</form>

		</div>

	</section>

	<section class="section">

		<div class="stats">

			<div class="stat">
				<h3>250K+</h3>
				<p>Monthly Readers</p>
			</div>

			<div class="stat">
				<h3>50+</h3>
				<p>Countries</p>
			</div>

			<div class="stat">
				<h3>1000+</h3>
				<p>Articles</p>
			</div>

			<div class="stat">
				<h3>500+</h3>
				<p>Newsletters</p>
			</div>

		</div>

	</section>

</main>

<Footer />

</body>
</html>
