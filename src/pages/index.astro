---
import { Image } from 'astro:assets';
// 1. Sanity client for fetching blog posts
import { sanityClient } from 'sanity:client';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// 2. Fetching published posts from Sanity with safe image projection
const posts = await sanityClient.fetch(`
  *[_type == "post" && defined(slug.current)] | order(_createdAt desc) {
    _id,
    title,
    slug,
    excerpt,
    _createdAt,
    "imageUrl": mainImage.asset->url
  }
`);

const featuredPost = posts[0];
const latestPosts = posts.slice(1, 7);

const trendingTopics = [
	'⚡ Next-Gen AI & Autonomous Agents',
	'🚀 Modern Frontend & Astro Architecture',
	'💡 Scaling Micro-SaaS Startups',
	'🛡️ Cybersecurity in the AI Era',
	'☁️ Cloud Infrastructure & DevOps',
	'🔥 Deep Work & Creator Economy',
];

const categories = [
	{ icon: '🤖', title: 'Artificial Intelligence', desc: 'Models, Agents & Smart Workflows', href: '/categories/artificial-intelligence/' },
	{ icon: '📈', title: 'Business & Growth', desc: 'Startup Strategies & Scaling', href: '/categories/business-strategy/' },
	{ icon: '🚀', title: 'Tech & Products', desc: 'Software, Code & Architecture', href: '/categories/startups/' },
	{ icon: '🔒', title: 'Cybersecurity', desc: 'Data Privacy & Cryptography', href: '/categories/cybersecurity/' },
	{ icon: '☁️', title: 'Cloud & DevOps', desc: 'AWS, GCP & Global Scale', href: '/categories/cloud-computing/' },
	{ icon: '🌐', title: 'Digital Culture', desc: 'Future of Work & Teams', href: '/categories/future-of-work/' },
];

const socialLinks = [
	{ 
		platform: 'Twitter / X', 
		handle: '@digisoneglobal', 
		href: 'https://twitter.com', 
		svg: '<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>' 
	},
	{ 
		platform: 'LinkedIn', 
		handle: '@digisoneglobal', 
		href: 'https://linkedin.com', 
		svg: '<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>' 
	},
