<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DigiSone • Premium Tech News</title>
  <meta name="description" content="Breaking tech news, AI, startups, hardware &amp; more." />
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
  <style>
    .hero-bg {
      background: linear-gradient(rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0.85)), url('https://picsum.photos/id/1015/2000/1200') center/cover no-repeat;
    }
    .article-card {
      transition: all 0.3s ease;
    }
    .article-card:hover {
      transform: translateY(-6px);
    }
    .nav-link {
      position: relative;
    }
    .nav-link:after {
      content: '';
      position: absolute;
      bottom: -4px;
      left: 0;
      width: 0;
      height: 2px;
      background: #22d3ee;
      transition: width 0.3s;
    }
    .nav-link:hover:after {
      width: 100%;
    }
  </style>
</head>
<body class="bg-zinc-950 text-zinc-200">

  <!-- Top Live Bar -->
  <div class="bg-black py-2.5 text-xs border-b border-zinc-800">
    <div class="max-w-screen-2xl mx-auto px-5 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-emerald-400 flex items-center gap-1 font-medium">
          <i class="fa-solid fa-bolt"></i> LIVE
        </span>
        <span class="hidden sm:inline">OpenAI o3 model rumored for December • 2m ago</span>
      </div>
    </div>
  </div>

  <!-- Header -->
  <header class="sticky top-0 z-50 bg-zinc-950 border-b border-zinc-800">
    <div class="max-w-screen-2xl mx-auto px-5">
      <div class="flex items-center justify-between h-16">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 bg-gradient-to-br from-cyan-400 to-violet-600 rounded-2xl flex items-center justify-center text-xl font-bold">D</div>
          <span class="text-3xl font-semibold tracking-tighter">DigiSone</span>
        </div>

        <nav class="hidden md:flex items-center gap-7 text-sm font-medium">
          <a href="#" class="nav-link">Latest</a>
          <a href="#" class="nav-link">AI</a>
          <a href="#" class="nav-link">Startups</a>
          <a href="#" class="nav-link">Hardware</a>
          <a href="#" class="nav-link">Security</a>
        </nav>

        <div class="flex items-center gap-4">
          <div class="relative hidden md:block">
            <input type="text" id="searchInput"
                   class="bg-zinc-900 border border-zinc-700 w-72 focus:w-80 transition-all rounded-full pl-10 py-2.5 text-sm focus:outline-none focus:border-cyan-400"
                   placeholder="Search DigiSone..." />
            <i class="fa-solid fa-magnifying-glass absolute left-4 top-3 text-zinc-500"></i>
          </div>
          <button class="bg-white text-black px-6 py-2.5 rounded-2xl font-semibold text-sm hover:bg-cyan-300 transition-colors">
            Subscribe
          </button>
          <button class="md:hidden text-2xl" id="menuBtn">
            <i class="fa-solid fa-bars"></i>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Hero -->
  <section class="hero-bg min-h-[90vh] flex items-center relative">
    <div class="max-w-screen-2xl mx-auto px-5 pt-12">
      <div class="max-w-xl">
        <div class="inline-block bg-white/10 backdrop-blur-md px-5 py-2 rounded-full text-xs mb-6 border border-white/30">
          BREAKING • Anthropic
        </div>
        <h1 class="text-5xl md:text-6xl font-bold leading-none tracking-tighter mb-6">
          Claude 4 shatters benchmarks —<br>Is this the end of GPT dominance?
        </h1>
        <p class="text-lg text-zinc-300 mb-8">
          Anthropic's latest model demonstrates unprecedented reasoning capabilities.
        </p>
        <div class="flex flex-wrap items-center gap-6">
          <a href="#" class="bg-white text-black px-8 py-4 rounded-2xl font-semibold inline-flex items-center gap-3 hover:scale-105 transition-transform">
            Read Full Story <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
        <div class="mt-10 flex items-center gap-4 text-sm">
          <img src="https://picsum.photos/id/64/48/48" class="w-10 h-10 rounded-full" alt="">
          <div>
            <p>Sarah Chen</p>
            <p class="text-xs text-zinc-400">2 hours ago • 12 min read</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <main class="max-w-screen-2xl mx-auto px-5 py-12">
    <div class="grid md:grid-cols-12 gap-10">
      <!-- Left Feed -->
      <div class="md:col-span-8 space-y-12">

        <div class="flex items-center justify-between">
          <h2 class="text-3xl font-semibold">Latest Stories</h2>
          <a href="#" class="text-cyan-400 text-sm flex items-center gap-2">View All →</a>
        </div>

        <!-- Article Cards -->
        <div class="space-y-10">
          <div class="grid md:grid-cols-5 gap-6 article-card">
            <div class="md:col-span-3">
              <img src="https://picsum.photos/id/201/800/500" class="w-full aspect-video object-cover rounded-3xl" alt="">
            </div>
            <div class="md:col-span-2 flex flex-col justify-center">
              <span class="text-xs uppercase tracking-widest text-violet-400">Hardware</span>
              <h3 class="text-xl font-semibold mt-3 leading-tight">Apple M5 chip expected with massive GPU upgrade</h3>
              <p class="text-zinc-400 text-sm mt-3">Expected to power next-gen Mac Pro and MacBooks.</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Sidebar -->
      <aside class="md:col-span-4">
        <div class="bg-zinc-900 rounded-3xl p-8 sticky top-6">
          <h3 class="font-semibold text-lg mb-6">Stay Updated</h3>
          <div class="space-y-6">
            <div class="text-sm">
              <p class="font-medium">Nvidia Blackwell GPUs sold out instantly</p>
              <p class="text-xs text-zinc-500 mt-1">3h ago</p>
            </div>
            <div class="text-sm">
              <p class="font-medium">Tesla Optimus Gen 2 spotted in factory</p>
              <p class="text-xs text-zinc-500 mt-1">Yesterday</p>
            </div>
          </div>
          <button class="mt-10 w-full bg-white text-black py-4 rounded-2xl font-semibold">Subscribe to Newsletter</button>
        </div>
      </aside>
    </div>
  </main>

  <script>
    // Simple mobile menu toggle (you can expand later)
    document.getElementById('menuBtn').addEventListener('click', () => {
      alert('Mobile menu coming soon! 🔥');
    });

    // Search input focus effect
    const search = document.getElementById('searchInput');
    search.addEventListener('focus', () => search.parentElement.classList.add('ring-2', 'ring-cyan-400'));
    search.addEventListener('blur', () => search.parentElement.classList.remove('ring-2', 'ring-cyan-400'));
  </script>
</body>
</html>
