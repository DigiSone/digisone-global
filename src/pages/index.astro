---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => 
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const featuredPost = sortedPosts[0];
const latestPosts = sortedPosts.slice(1, 7);
const trendingPosts = sortedPosts.slice(0, 5);

// Featured Categories (you can expand this)
const categories = [
  { name: "Artificial Intelligence", slug: "ai", count: 24 },
  { name: "Startups & VC", slug: "startups", count: 18 },
  { name: "Enterprise Tech", slug: "enterprise", count: 15 },
  { name: "Cybersecurity", slug: "security", count: 12 },
  { name: "Hardware & Gadgets", slug: "hardware", count: 9 },
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead 
			title={SITE_TITLE} 
			description={SITE_DESCRIPTION} 
		/>
		<meta name="author" content="DigiSone Global" />
		<link rel="canonical" href="https://yourdomain.com/" />
	</head>
	<body class="bg-[#0a0c14] text-slate-200 font-sans antialiased">
		
		<!-- Header -->
		<div class="sticky top-0 z-50 backdrop-blur-xl bg-[#0a0c14]/95 border-b border-white/5">
			<Header />
		</div>

		<main class="max-w-7xl mx-auto px-6 pt-12 pb-24">

			<!-- Hero / Featured Article -->
			{featuredPost && (
				<section class="mb-24">
					<div class="grid md:grid-cols-12 gap-12 items-center">
						<div class="md:col-span-7">
							<div class="inline-flex items-center gap-2 text-xs uppercase tracking-widest text-emerald-400 mb-4">
								<span class="h-px w-6 bg-emerald-400"></span>
								Featured Story
							</div>
							<a href={`/blog/${featuredPost.slug}`} class="group">
								<h1 class="text-5xl md:text-6xl font-bold leading-none tracking-tighter text-white group-hover:text-indigo-300 transition-colors">
									{featuredPost.data.title}
								</h1>
							</a>
							<p class="mt-6 text-lg text-slate-400 max-w-2xl">
								{featuredPost.data.description}
							</p>
							<div class="flex items-center gap-4 mt-8">
								<div class="flex items-center gap-3">
									<div class="w-9 h-9 bg-slate-700 rounded-full overflow-hidden">
										<img src={featuredPost.data.authorImage || "/default-author.jpg"} alt={featuredPost.data.author} class="w-full h-full object-cover" />
									</div>
									<div>
										<p class="font-medium">{featuredPost.data.author}</p>
										<p class="text-xs text-slate-500">
											{new Intl.DateTimeFormat('en-US', { dateStyle: 'long' }).format(new Date(featuredPost.data.pubDate))}
										</p>
									</div>
								</div>
								<a href={`/blog/${featuredPost.slug}`} 
									class="ml-auto md:ml-0 px-8 py-4 bg-white text-black font-semibold rounded-2xl hover:bg-indigo-400 hover:text-white transition-all">
									Read Full Analysis →
								</a>
							</div>
						</div>
						<div class="md:col-span-5">
							<img src={featuredPost.data.image || 'https://picsum.photos/id/1015/1200/800'} 
								 alt={featuredPost.data.title}
								 class="w-full aspect-[16/10] object-cover rounded-3xl shadow-2xl" />
						</div>
					</div>
				</section>
			)}

			<div class="grid lg:grid-cols-12 gap-12">

				<!-- Latest Articles -->
				<section class="lg:col-span-8 space-y-16">
					<div class="flex items-end justify-between">
						<h2 class="text-3xl font-semibold tracking-tight">Latest Intelligence</h2>
						<a href="/blog" class="text-indigo-400 hover:text-indigo-300 text-sm font-medium flex items-center gap-2">
							View All Articles →
						</a>
					</div>

					<div class="space-y-12">
						{latestPosts.map((post) => (
							<article class="group grid md:grid-cols-12 gap-8">
								<div class="md:col-span-5">
									<a href={`/blog/${post.slug}`}>
										<img src={post.data.image || `https://picsum.photos/id/${Math.floor(Math.random()*100)}/800/500`} 
											 alt={post.data.title}
											 class="w-full aspect-video object-cover rounded-2xl transition-transform group-hover:scale-105 duration-500" />
									</a>
								</div>
								<div class="md:col-span-7 flex flex-col">
									<div class="uppercase text-xs tracking-widest text-violet-400 mb-3">
										{post.data.category || 'Technology'}
									</div>
									<a href={`/blog/${post.slug}`} class="text-2xl font-semibold leading-tight group-hover:text-white/80 transition-colors">
										{post.data.title}
									</a>
									<p class="mt-4 text-slate-400 line-clamp-3">
										{post.data.description}
									</p>
									<div class="mt-auto pt-6 text-sm text-slate-500 flex items-center gap-4">
										<span>{post.data.author}</span>
										<span>•</span>
										<time>{new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</time>
									</div>
								</div>
							</article>
						))}
					</div>
				</section>

				<!-- Sidebar -->
				<aside class="lg:col-span-4 space-y-12">

					<!-- Trending -->
					<section>
						<h3 class="uppercase text-xs tracking-[1px] font-semibold text-amber-400 mb-6 flex items-center gap-2">
							🔥 Trending This Week
						</h3>
						<div class="space-y-6">
							{trendingPosts.map((post, index) => (
								<a href={`/blog/${post.slug}`} class="flex gap-4 group">
									<span class="text-4xl font-bold text-white/10 group-hover:text-white/30 transition-colors">{(index+1).toString().padStart(2, '0')}</span>
									<div>
										<p class="font-medium leading-tight line-clamp-2 group-hover:text-indigo-300 transition-colors">
											{post.data.title}
										</p>
										<p class="text-xs text-slate-500 mt-2">{post.data.author}</p>
									</div>
								</a>
							))}
						</div>
					</section>

					<!-- Newsletter CTA -->
					<div class="bg-gradient-to-br from-indigo-500/10 to-violet-500/10 border border-white/10 rounded-3xl p-8">
						<h3 class="text-xl font-semibold">Weekly Intelligence Brief</h3>
						<p class="text-slate-400 text-sm mt-2">Curated insights from the frontiers of technology. Delivered every Sunday.</p>
						<form class="mt-6">
							<input type="email" placeholder="your@work.email" 
								class="w-full bg-white/5 border border-white/20 rounded-2xl px-5 py-4 focus:outline-none focus:border-indigo-400 text-sm" required />
							<button type="submit"
								class="mt-4 w-full bg-white text-black font-semibold py-4 rounded-2xl hover:bg-indigo-400 hover:text-white transition-all">
								Subscribe Free
							</button>
						</form>
					</div>

					<!-- Categories -->
					<section>
						<h3 class="uppercase text-xs tracking-widest font-medium mb-5">Explore Topics</h3>
						<div class="grid grid-cols-2 gap-3">
							{categories.map(cat => (
								<a href={`/blog?category=${cat.slug}`} 
									class="bg-white/5 hover:bg-white/10 border border-white/10 rounded-2xl px-5 py-4 text-sm transition-all hover:border-indigo-400/50">
									{cat.name}
									<span class="text-xs text-slate-500 block mt-0.5">{cat.count} articles</span>
								</a>
							))}
						</div>
					</section>

				</aside>
			</div>

			<!-- Author Spotlight -->
			<section class="mt-28 border-t border-white/10 pt-16">
				<div class="max-w-md mx-auto text-center">
					<div class="mx-auto w-28 h-28 bg-gradient-to-br from-indigo-400 to-violet-500 rounded-3xl overflow-hidden mb-6">
						<img src="/author-spotlight.jpg" alt="Featured Author" class="w-full h-full object-cover" />
					</div>
					<p class="text-sm uppercase tracking-widest text-slate-400">Author Spotlight</p>
					<h3 class="text-2xl font-semibold mt-2">Dr. Priya Sharma</h3>
					<p class="text-slate-400 mt-1">AI Ethics &amp; Future of Work</p>
					<p class="text-sm text-slate-500 mt-6">
						"Technology should amplify human potential, not replace it."
					</p>
				</div>
			</section>

		</main>

		<!-- Footer -->
		<Footer />
	</body>
</html>
