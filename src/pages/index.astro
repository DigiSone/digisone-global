---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

// Fetch & sort posts (newest first)
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPost = posts[0];
const latestPosts = posts.slice(1, 7);

const pageTitle = `${SITE_TITLE} — Technology, Business & AI Insights`;
const pageDescription =
	SITE_DESCRIPTION ||
	'DigiSone delivers premium insights on AI, business strategy, startups, cybersecurity, cloud and the future of work.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			:root {
				--bg: #f1f5f9;
				--surface: #ffffff;
				--text: #0b1220;
				--muted: #64748b;
				--primary: #2563eb;
				--primary-dark: #1d4ed8;
				--accent: #6366f1;
				--border: rgba(15, 23, 42, 0.08);
				--radius: 20px;
				--radius-lg: 28px;
				--shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
				--font: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				margin: 0;
				font-family: var(--font);
				color: var(--text);
				background: var(--bg);
				-webkit-font-smoothing: antialiased;
			}

			/* Ambient background — pure CSS, no paint cost spikes */
			body::before {
				content: '';
				position: fixed;
				inset: 0;
				z-index: -1;
				pointer-events: none;
				background:
					radial-gradient(ellipse 80% 50% at 10% -10%, rgba(37, 99, 235, 0.12), transparent 55%),
					radial-gradient(ellipse 60% 40% at 90% 0%, rgba(99, 102, 241, 0.1), transparent 50%);
			}

			main {
				width: min(100% - 2rem, 1120px);
				margin-inline: auto;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			h1,
			h2,
			h3 {
				margin: 0;
				letter-spacing: -0.03em;
				line-height: 1.15;
			}

			p {
				margin: 0;
				line-height: 1.7;
			}

			.section {
				margin: clamp(3.5rem, 8vw, 6rem) 0;
				content-visibility: auto;
				contain-intrinsic-size: 800px;
			}

			.section-header {
				display: flex;
				align-items: end;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1.75rem;
				flex-wrap: wrap;
			}

			.section-title {
				font-size: clamp(1.6rem, 3vw, 2.25rem);
			}

			.section-link {
				font-size: 0.95rem;
				font-weight: 600;
				color: var(--primary);
			}

			.section-link:hover {
				color: var(--primary-dark);
			}

			/* ——— Hero ——— */
			.hero {
				display: grid;
				grid-template-columns: 1.15fr 0.85fr;
				gap: 2.5rem;
				align-items: center;
				padding: clamp(2.5rem, 6vw, 4.5rem) 0 2rem;
			}

			.hero-badge {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.45rem 0.95rem;
				border-radius: 999px;
				background: var(--surface);
				border: 1px solid var(--border);
				font-size: 0.85rem;
				font-weight: 600;
				margin-bottom: 1.25rem;
			}

			.hero-badge .dot {
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: #22c55e;
				box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
			}

			.hero h1 {
				font-size: clamp(2.4rem, 6vw, 3.75rem);
				margin-bottom: 1rem;
			}

			.hero h1 .gradient {
				background: linear-gradient(120deg, #2563eb, #6366f1 50%, #8b5cf6);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}

			.hero-lead {
				font-size: clamp(1rem, 2vw, 1.15rem);
				color: var(--muted);
				max-width: 34rem;
				margin-bottom: 1.75rem;
			}

			.hero-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
			}

			.btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.4rem;
				padding: 0.85rem 1.35rem;
				border-radius: 12px;
				font-weight: 600;
				font-size: 0.95rem;
				border: none;
				cursor: pointer;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}

			.btn:hover {
				transform: translateY(-2px);
			}

			.btn:focus-visible {
				outline: 2px solid var(--primary);
				outline-offset: 2px;
			}

			.btn-primary {
				background: linear-gradient(135deg, #2563eb, #1d4ed8);
				color: #fff;
				box-shadow: 0 8px 22px rgba(37, 99, 235, 0.35);
			}

			.btn-secondary {
				background: var(--surface);
				color: var(--text);
				border: 1px solid var(--border);
			}

			.hero-card {
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				padding: 1.5rem;
				box-shadow: var(--shadow);
			}

			.hero-card h2 {
				font-size: 1rem;
				margin-bottom: 1rem;
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			.live-pill {
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				color: #15803d;
				background: rgba(34, 197, 94, 0.12);
				padding: 0.25rem 0.5rem;
				border-radius: 6px;
			}

			.hero-card ol {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 0.35rem;
			}

			.hero-card li {
				display: flex;
				align-items: center;
				gap: 0.7rem;
				padding: 0.5rem 0.55rem;
				border-radius: 10px;
				color: var(--muted);
				font-size: 0.92rem;
				font-weight: 500;
			}

			.hero-card li:hover {
				background: rgba(37, 99, 235, 0.06);
				color: var(--primary);
			}

			.hero-card .num {
				width: 1.5rem;
				height: 1.5rem;
				border-radius: 7px;
				background: rgba(37, 99, 235, 0.1);
				color: var(--primary);
				font-size: 0.72rem;
				font-weight: 700;
				display: grid;
				place-items: center;
				flex-shrink: 0;
			}

			/* ——— Featured ——— */
			.featured {
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				overflow: hidden;
				box-shadow: var(--shadow);
			}

			.featured a {
				display: grid;
				grid-template-columns: 1.1fr 1fr;
				min-height: 22rem;
			}

			.featured-media {
				background: linear-gradient(145deg, #1e3a8a, #312e81);
				min-height: 16rem;
				aspect-ratio: 16 / 10;
			}

			.featured-media img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}

			.featured-body {
				padding: clamp(1.5rem, 3vw, 2.5rem);
				display: flex;
				flex-direction: column;
				justify-content: center;
			}

			.eyebrow {
				font-size: 0.78rem;
				font-weight: 700;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: var(--primary);
				margin-bottom: 0.6rem;
			}

			.meta {
				font-size: 0.88rem;
				color: var(--muted);
				margin-bottom: 0.75rem;
			}

			.featured h2 {
				font-size: clamp(1.4rem, 2.8vw, 2rem);
				margin-bottom: 0.75rem;
			}

			.featured p {
				color: var(--muted);
				margin-bottom: 1.25rem;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			/* ——— Post grid ——— */
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(16.5rem, 1fr));
				gap: 1.25rem;
			}

			.card {
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 1.35rem;
				display: flex;
				flex-direction: column;
				min-height: 14rem;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}

			.card:hover {
				transform: translateY(-4px);
				box-shadow: var(--shadow);
			}

			.card:focus-within {
				outline: 2px solid var(--primary);
				outline-offset: 2px;
			}

			.card-top {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 0.85rem;
				gap: 0.5rem;
			}

			.tag {
				font-size: 0.72rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				color: var(--primary);
				background: rgba(37, 99, 235, 0.1);
				padding: 0.25rem 0.5rem;
				border-radius: 6px;
			}

			.card h3 {
				font-size: 1.1rem;
				margin-bottom: 0.5rem;
			}

			.card p {
				color: var(--muted);
				font-size: 0.92rem;
				flex: 1;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.card-footer {
				margin-top: 1rem;
				padding-top: 0.85rem;
				border-top: 1px solid var(--border);
				font-size: 0.88rem;
				font-weight: 600;
				color: var(--primary);
			}

			/* ——— Newsletter ——— */
			.newsletter {
				background: linear-gradient(150deg, #0b1220, #1e293b 45%, #0f172a);
				color: #fff;
				border-radius: var(--radius-lg);
				padding: clamp(2rem, 5vw, 3.5rem);
				text-align: center;
				box-shadow: var(--shadow);
			}

			.newsletter h2 {
				font-size: clamp(1.6rem, 3.5vw, 2.4rem);
				margin-bottom: 0.65rem;
			}

			.newsletter p {
				color: rgba(255, 255, 255, 0.72);
				max-width: 32rem;
				margin: 0 auto 1.5rem;
			}

			.newsletter-form {
				display: flex;
				flex-wrap: wrap;
				gap: 0.65rem;
				justify-content: center;
				max-width: 28rem;
				margin: 0 auto;
			}

			.newsletter-form input {
				flex: 1 1 12rem;
				min-height: 3rem;
				padding: 0.85rem 1rem;
				border-radius: 12px;
				border: 1px solid rgba(255, 255, 255, 0.14);
				background: rgba(255, 255, 255, 0.08);
				color: #fff;
				font: inherit;
			}

			.newsletter-form input::placeholder {
				color: rgba(255, 255, 255, 0.45);
			}

			.newsletter-form input:focus {
				outline: 2px solid #93c5fd;
				outline-offset: 1px;
			}

			.newsletter-form button {
				min-height: 3rem;
				padding: 0.85rem 1.25rem;
				border: none;
				border-radius: 12px;
				background: #fff;
				color: #0b1220;
				font-weight: 700;
				font: inherit;
				cursor: pointer;
			}

			.newsletter-form button:hover {
				transform: translateY(-1px);
			}

			.newsletter-note {
				margin-top: 0.85rem;
				font-size: 0.8rem;
				color: rgba(255, 255, 255, 0.4);
			}

			/* ——— Empty state ——— */
			.empty {
				background: var(--surface);
				border: 1px dashed var(--border);
				border-radius: var(--radius);
				padding: 2rem;
				text-align: center;
				color: var(--muted);
			}

			/* ——— Responsive ——— */
			@media (max-width: 900px) {
				.hero {
					grid-template-columns: 1fr;
					gap: 1.75rem;
				}

				.featured a {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 600px) {
				main {
					width: min(100% - 1.5rem, 1120px);
				}

				.hero-actions {
					flex-direction: column;
				}

				.btn {
					width: 100%;
				}

				.newsletter-form {
					flex-direction: column;
				}

				.newsletter-form input,
				.newsletter-form button {
					width: 100%;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<!-- Hero -->
			<section class="hero" aria-label="Introduction">
				<div>
					<div class="hero-badge">
						<span class="dot" aria-hidden="true"></span>
						Trusted by founders, operators & technology leaders
					</div>
					<h1>
						The Future of<br />
						<span class="gradient">Technology, Business & AI</span>
					</h1>
					<p class="hero-lead">
						DigiSone delivers premium insights on Artificial Intelligence, business strategy,
						startups, cybersecurity, cloud computing and the future of work.
					</p>
					<div class="hero-actions">
						<a class="btn btn-primary" href="/blog">Read Latest Insights</a>
						<a class="btn btn-secondary" href="#newsletter">Get Weekly Briefing</a>
					</div>
				</div>

				<aside class="hero-card" aria-label="Trending topics">
					<h2>
						Trending Topics
						<span class="live-pill">Live</span>
					</h2>
					<ol>
						<li><span class="num">01</span> AI Agents & Autonomous Systems</li>
						<li><span class="num">02</span> Enterprise Automation</li>
						<li><span class="num">03</span> Future of Work</li>
						<li><span class="num">04</span> Cybersecurity & Privacy</li>
						<li><span class="num">05</span> Cloud Infrastructure</li>
						<li><span class="num">06</span> Startup Growth Strategies</li>
					</ol>
				</aside>
			</section>

			<!-- Featured -->
			{
				featuredPost && (
					<section class="section featured" aria-label="Featured article">
						<a href={`/blog/${featuredPost.id}/`} aria-label={`Read featured: ${featuredPost.data.title}`}>
							<div class="featured-media">
								{/* Optional image: add when asset exists; keeps layout stable either way */}
							</div>
							<div class="featured-body">
								<div class="eyebrow">Featured Story</div>
								<div class="meta">
									<time datetime={featuredPost.data.pubDate.toISOString()}>
										{featuredPost.data.pubDate.toLocaleDateString('en-US', {
											year: 'numeric',
											month: 'long',
											day: 'numeric',
										})}
									</time>
								</div>
								<h2>{featuredPost.data.title}</h2>
								<p>{featuredPost.data.description}</p>
								<span class="btn btn-primary">Read Article</span>
							</div>
						</a>
					</section>
				)
			}

			<!-- Latest -->
			<section class="section" aria-label="Latest articles">
				<div class="section-header">
					<h2 class="section-title">Latest Insights</h2>
					<a class="section-link" href="/blog">View all</a>
				</div>

				{
					latestPosts.length > 0 ? (
						<div class="grid">
							{latestPosts.map((post) => (
								<article class="card">
									<a href={`/blog/${post.id}/`} aria-label={post.data.title}>
										<div class="card-top">
											<span class="tag">Article</span>
											<span class="meta">
												<time datetime={post.data.pubDate.toISOString()}>
													{post.data.pubDate.toLocaleDateString('en-US', {
														month: 'short',
														day: 'numeric',
														year: 'numeric',
													})}
												</time>
											</span>
										</div>
										<h3>{post.data.title}</h3>
										<p>{post.data.description}</p>
										<div class="card-footer">Read more →</div>
									</a>
								</article>
							))}
						</div>
					) : (
						<div class="empty">
							<p>No additional articles yet. Check back soon.</p>
						</div>
					)
				}
			</section>

			<!-- Newsletter -->
			<section class="section" id="newsletter" aria-label="Newsletter signup">
				<div class="newsletter">
					<h2>Get the Weekly Technology Briefing</h2>
					<p>
						Actionable insights on AI, business strategy, cybersecurity and digital transformation —
						delivered every week.
					</p>
					<form class="newsletter-form" action="#" method="post" aria-label="Subscribe to newsletter">
						<label for="email" class="sr-only" style="position:absolute;left:-9999px"
							>Email address</label
						>
						<input
							id="email"
							name="email"
							type="email"
							autocomplete="email"
							required
							placeholder="Enter your email address"
						/>
						<button type="submit">Subscribe</button>
					</form>
					<p class="newsletter-note">No spam. Unsubscribe anytime.</p>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
