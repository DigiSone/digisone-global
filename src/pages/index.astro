---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) =>
    new Date(b.data.pubDate).getTime() -
    new Date(a.data.pubDate).getTime()
);

const featuredPost = sortedPosts[0];
const latestPosts = sortedPosts.slice(1, 7);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="DigiSone Global" description={SITE_DESCRIPTION} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --surface: #ffffff;
        --surface-2: #f8fafc;
        --surface-glass: rgba(255, 255, 255, 0.65);
        --text: #0b1220;
        --muted: #64748b;
        --muted-2: #94a3b8;
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --primary-soft: rgba(37, 99, 235, 0.1);
        --accent: #6366f1;
        --violet: #8b5cf6;
        --border: rgba(15, 23, 42, 0.07);
        --border-strong: rgba(15, 23, 42, 0.12);
        --radius: 20px;
        --radius-lg: 28px;
        --radius-xl: 36px;
        --shadow-xs: 0 2px 8px rgba(15, 23, 42, 0.04);
        --shadow-sm: 0 8px 24px rgba(15, 23, 42, 0.05);
        --shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
        --shadow-lg: 0 32px 80px rgba(15, 23, 42, 0.12);
        --shadow-glow: 0 0 0 1px rgba(37, 99, 235, 0.08), 0 20px 50px rgba(37, 99, 235, 0.12);
        --font-sans: "Inter", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        --font-display: "Space Grotesk", "Inter", system-ui, sans-serif;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--text);
        background: #f1f5f9;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
      }

      /* Ambient background */
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        background:
          radial-gradient(ellipse 90% 60% at 10% -15%, rgba(37, 99, 235, 0.18), transparent 55%),
          radial-gradient(ellipse 70% 50% at 95% 5%, rgba(99, 102, 241, 0.14), transparent 50%),
          radial-gradient(ellipse 50% 40% at 50% 110%, rgba(37, 99, 235, 0.07), transparent 60%);
        pointer-events: none;
        z-index: -1;
      }

      main {
        width: 100%;
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      h1, h2, h3 {
        font-family: var(--font-display);
        font-weight: 700;
        letter-spacing: -0.04em;
        margin: 0;
      }

      p {
        line-height: 1.7;
        margin: 0;
      }

      .section {
        margin: 7rem 0;
      }

      .section-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.5rem;
        margin-bottom: 2.5rem;
        flex-wrap: wrap;
      }

      .section-title {
        font-size: clamp(1.9rem, 3.6vw, 2.85rem);
        letter-spacing: -0.045em;
      }

      .section-link {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--primary);
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: gap 0.3s var(--ease), color 0.2s ease;
      }

      .section-link:hover {
        gap: 0.7rem;
        color: var(--primary-dark);
      }

      /* ========== HERO ========== */
      .hero {
        padding: 5rem 0 3.5rem;
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
        gap: 3.5rem;
        align-items: center;
      }

      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.5rem 1.05rem 0.5rem 0.7rem;
        border-radius: 999px;
        background: var(--surface);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-xs);
        font-size: 0.84rem;
        font-weight: 600;
        color: var(--text);
        letter-spacing: -0.01em;
      }

      .hero-badge .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.22);
        animation: live-pulse 2.2s ease-in-out infinite;
      }

      @keyframes live-pulse {
        0%, 100% { box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.22); }
        50% { box-shadow: 0 0 0 7px rgba(34, 197, 94, 0.08); }
      }

      .hero h1 {
        font-size: clamp(2.9rem, 7vw, 5.1rem);
        line-height: 1.02;
        margin: 1.4rem 0 1.35rem;
        letter-spacing: -0.05em;
      }

      .hero h1 .line {
        display: block;
      }

      .hero h1 .gradient {
        background: linear-gradient(120deg, #2563eb 0%, #6366f1 45%, #8b5cf6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .hero-lead {
        font-size: 1.15rem;
        color: var(--muted);
        max-width: 520px;
        line-height: 1.75;
      }

      .hero-buttons {
        display: flex;
        gap: 0.9rem;
        margin-top: 2.25rem;
        flex-wrap: wrap;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.95rem 1.55rem;
        border-radius: 14px;
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: -0.01em;
        transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), background 0.25s ease;
        border: none;
        cursor: pointer;
        font-family: inherit;
      }

      .btn:hover {
        transform: translateY(-3px);
      }

      .btn-primary {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: white;
        box-shadow: 0 10px 28px rgba(37, 99, 235, 0.38);
      }

      .btn-primary:hover {
        box-shadow: 0 14px 36px rgba(37, 99, 235, 0.5);
      }

      .btn-secondary {
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text);
        box-shadow: var(--shadow-xs);
      }

      .btn-secondary:hover {
        background: #fff;
        box-shadow: var(--shadow-sm);
        border-color: var(--border-strong);
      }

      /* Trending card */
      .hero-card {
        position: relative;
        background: var(--surface-glass);
        backdrop-filter: blur(28px);
        -webkit-backdrop-filter: blur(28px);
        border-radius: var(--radius-xl);
        padding: 2rem 1.85rem;
        border: 1px solid rgba(255, 255, 255, 0.7);
        box-shadow: var(--shadow);
        overflow: hidden;
      }

      .hero-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #2563eb, #6366f1, #8b5cf6);
      }

      .hero-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.35rem;
      }

      .hero-card h3 {
        font-size: 1rem;
        letter-spacing: -0.02em;
      }

      .hero-card-live {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #16a34a;
        background: rgba(34, 197, 94, 0.12);
        padding: 0.25rem 0.55rem;
        border-radius: 6px;
      }

      .hero-card ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }

      .hero-card li {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        font-size: 0.94rem;
        color: var(--muted);
        font-weight: 500;
        padding: 0.55rem 0.7rem;
        border-radius: 11px;
        transition: background 0.25s ease, color 0.25s ease, transform 0.25s var(--ease);
      }

      .hero-card li:hover {
        background: var(--primary-soft);
        color: var(--primary);
        transform: translateX(4px);
      }

      .hero-card li .num {
        width: 22px;
        height: 22px;
        border-radius: 7px;
        background: var(--primary-soft);
        color: var(--primary);
        font-size: 0.72rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      /* Trust strip */
      .trust {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem 2.5rem;
        padding: 1.5rem 0 0;
        margin-top: 0.5rem;
        border-top: 1px solid var(--border);
        margin-top: 2.5rem;
        padding-top: 1.75rem;
      }

      .trust-item {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }

      .trust-item strong {
        font-family: var(--font-display);
        font-size: 1.35rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        color: var(--text);
      }

      .trust-item span {
        font-size: 0.8rem;
        color: var(--muted);
        font-weight: 500;
      }

      /* ========== FEATURED ========== */
      .featured {
        background: var(--surface);
        border-radius: var(--radius-xl);
        overflow: hidden;
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
        transition: box-shadow 0.4s var(--ease), transform 0.4s var(--ease);
      }

      .featured:hover {
        box-shadow: var(--shadow-lg);
        transform: translateY(-5px);
      }

      .featured > a {
        display: grid;
        grid-template-columns: 1.15fr 1fr;
        min-height: 440px;
      }

      .featured-image {
        min-height: 300px;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-color: #1e3a8a;
        position: relative;
      }

      .featured-image::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(160deg, rgba(15, 23, 42, 0.15) 0%, transparent 50%);
      }

      .featured-content {
        padding: 3rem 2.75rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .featured-label {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--primary);
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.09em;
        margin-bottom: 0.9rem;
      }

      .featured-meta {
        color: var(--muted);
        font-size: 0.9rem;
        font-weight: 500;
        margin-bottom: 0.9rem;
      }

      .featured h2 {
        font-size: clamp(1.7rem, 3.2vw, 2.45rem);
        line-height: 1.18;
        margin-bottom: 1.1rem;
        letter-spacing: -0.04em;
      }

      .featured p {
        color: var(--muted);
        font-size: 1.05rem;
        line-height: 1.7;
        margin-bottom: 1.85rem;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .featured .btn {
        align-self: flex-start;
      }

      /* ========== CARDS ========== */
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
        gap: 1.5rem;
      }

      .card {
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 1.85rem;
        border-radius: var(--radius);
        background: var(--surface);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-xs);
        transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.3s ease;
        overflow: hidden;
      }

      .card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--primary), var(--accent));
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .card:hover {
        transform: translateY(-7px);
        box-shadow: var(--shadow);
        border-color: rgba(37, 99, 235, 0.14);
      }

      .card:hover::before {
        opacity: 1;
      }

      .card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.1rem;
      }

      .category-tag {
        color: var(--primary);
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        background: var(--primary-soft);
        padding: 0.28rem 0.6rem;
        border-radius: 6px;
      }

      .card-meta {
        font-size: 0.8rem;
        color: var(--muted-2);
        font-weight: 500;
      }

      .card h3 {
        font-size: 1.22rem;
        line-height: 1.32;
        margin-bottom: 0.7rem;
        letter-spacing: -0.03em;
      }

      .card p {
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.65;
        flex-grow: 1;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .card-footer {
        margin-top: 1.35rem;
        padding-top: 1.1rem;
        border-top: 1px solid var(--border);
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--primary);
        display: flex;
        align-items: center;
        gap: 0.35rem;
        transition: gap 0.3s var(--ease);
      }

      .card:hover .card-footer {
        gap: 0.6rem;
      }

      /* ========== CATEGORIES ========== */
      .categories {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        gap: 1.15rem;
      }

      .category {
        background: var(--surface);
        padding: 1.7rem 1.4rem;
        border-radius: var(--radius);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-xs);
        transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s ease;
      }

      .category:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-sm);
        border-color: rgba(37, 99, 235, 0.12);
      }

      .category-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        margin-bottom: 1rem;
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.1), rgba(99, 102, 241, 0.1));
      }

      .category h3 {
        font-size: 1.02rem;
        margin-bottom: 0.3rem;
        letter-spacing: -0.025em;
      }

      .category p {
        font-size: 0.85rem;
        color: var(--muted);
      }

      /* ========== WHY ========== */
      .why-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
      }

      .why-card {
        background: var(--surface);
        padding: 2.1rem 1.85rem;
        border-radius: var(--radius);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-xs);
        transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
        position: relative;
        overflow: hidden;
      }

      .why-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-sm);
      }

      .why-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        margin-bottom: 1.2rem;
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.12), rgba(99, 102, 241, 0.12));
      }

      .why-card h3 {
        font-size: 1.15rem;
        margin-bottom: 0.5rem;
      }

      .why-card p {
        color: var(--muted);
        font-size: 0.95rem;
      }

      /* ========== NEWSLETTER ========== */
      .newsletter {
        position: relative;
        padding: 5rem 3.5rem;
        border-radius: var(--radius-xl);
        text-align: center;
        background: linear-gradient(150deg, #0b1220 0%, #1e293b 45%, #0f172a 100%);
        color: white;
        box-shadow: var(--shadow-lg);
        overflow: hidden;
      }

      .newsletter::before {
        content: "";
        position: absolute;
        top: -45%;
        left: -25%;
        width: 70%;
        height: 90%;
        background: radial-gradient(circle, rgba(37, 99, 235, 0.28), transparent 68%);
        pointer-events: none;
      }

      .newsletter::after {
        content: "";
        position: absolute;
        bottom: -35%;
        right: -20%;
        width: 55%;
        height: 75%;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.22), transparent 68%);
        pointer-events: none;
      }

      .newsletter-inner {
        position: relative;
        z-index: 1;
      }

      .newsletter h2 {
        font-size: clamp(1.85rem, 4.2vw, 2.9rem);
        margin-bottom: 0.9rem;
        letter-spacing: -0.045em;
      }

      .newsletter p {
        max-width: 500px;
        margin: 0 auto;
        color: rgba(255, 255, 255, 0.7);
        font-size: 1.08rem;
      }

      .newsletter-form {
        display: flex;
        gap: 0.75rem;
        max-width: 480px;
        margin: 2.15rem auto 0;
        flex-wrap: wrap;
      }

      .newsletter-form input {
        flex: 1;
        min-width: 200px;
        padding: 1.05rem 1.2rem;
        border-radius: 13px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.07);
        color: white;
        font-size: 0.95rem;
        font-family: inherit;
        outline: none;
        transition: border-color 0.2s ease, background 0.2s ease;
      }

      .newsletter-form input::placeholder {
        color: rgba(255, 255, 255, 0.4);
      }

      .newsletter-form input:focus {
        border-color: rgba(255, 255, 255, 0.35);
        background: rgba(255, 255, 255, 0.11);
      }

      .newsletter-form button {
        padding: 1.05rem 1.55rem;
        border: none;
        border-radius: 13px;
        background: white;
        color: #0b1220;
        font-weight: 700;
        font-size: 0.95rem;
        font-family: inherit;
        cursor: pointer;
        transition: transform 0.25s var(--ease), box-shadow 0.25s ease;
      }

      .newsletter-form button:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.3);
      }

      .newsletter-note {
        margin-top: 1.1rem;
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.35);
      }

      /* ========== RESPONSIVE ========== */
      @media (max-width: 992px) {
        .hero {
          grid-template-columns: 1fr;
          gap: 2.75rem;
          padding: 3.5rem 0 2.5rem;
        }

        .featured > a {
          grid-template-columns: 1fr;
        }

        .featured-image {
          min-height: 260px;
        }

        .featured-content {
          padding: 2.25rem 1.85rem;
        }

        .why-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 768px) {
        main {
          padding: 0 1.15rem;
        }

        .section {
          margin: 4.75rem 0;
        }

        .hero h1 {
          font-size: clamp(2.4rem, 9.5vw, 3.4rem);
        }

        .hero-lead {
          font-size: 1.05rem;
        }

        .hero-buttons {
          flex-direction: column;
        }

        .btn {
          width: 100%;
        }

        .trust {
          gap: 1.5rem 2rem;
        }

        .grid {
          grid-template-columns: 1fr;
        }

        .categories {
          grid-template-columns: 1fr 1fr;
        }

        .newsletter {
          padding: 3.25rem 1.5rem;
        }

        .newsletter-form {
          flex-direction: column;
        }

        .newsletter-form input,
        .newsletter-form button {
          width: 100%;
        }
      }

      @media (max-width: 480px) {
        .hero-badge {
          font-size: 0.78rem;
        }

        .categories {
          grid-template-columns: 1fr;
        }

        .card,
        .category,
        .why-card {
          padding: 1.4rem;
        }

        .trust-item strong {
          font-size: 1.2rem;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <!-- Hero -->
      <section class="hero">
        <div>
          <div class="hero-badge">
            <span class="dot"></span>
            Trusted by founders, operators & technology leaders
          </div>
          <h1>
            <span class="line">The Future of</span>
            <span class="line gradient">Technology, Business & AI</span>
          </h1>
          <p class="hero-lead">
            DigiSone Global delivers premium insights on Artificial Intelligence,
            Business Strategy, Startups, Cybersecurity, Cloud Computing,
            Digital Transformation and the Future of Work.
          </p>
          <div class="hero-buttons">
            <a href="/blog" class="btn btn-primary">
              Read Latest Insights
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <a href="#newsletter" class="btn btn-secondary">
              Get Weekly Briefing
            </a>
          </div>

          <div class="trust">
            <div class="trust-item">
              <strong>12k+</strong>
              <span>Monthly readers</span>
            </div>
            <div class="trust-item">
              <strong>180+</strong>
              <span>In-depth articles</span>
            </div>
            <div class="trust-item">
              <strong>4.9★</strong>
              <span>Reader rating</span>
            </div>
          </div>
        </div>

        <div class="hero-card">
          <div class="hero-card-header">
            <h3>Trending Topics</h3>
            <span class="hero-card-live">Live</span>
          </div>
          <ul>
            <li><span class="num">01</span> AI Agents & Autonomous Systems</li>
            <li><span class="num">02</span> Enterprise Automation</li>
            <li><span class="num">03</span> Future of Work</li>
            <li><span class="num">04</span> Cybersecurity & Privacy</li>
            <li><span class="num">05</span> Cloud Infrastructure</li>
            <li><span class="num">06</span> Startup Growth Strategies</li>
          </ul>
        </div>
      </section>

      <!-- Featured -->
      {featuredPost && (
        <section class="featured">
          <a href={`/blog/${featuredPost.slug}/`}>
            <div
              class="featured-image"
              style={`background-image:url(${featuredPost.data.heroImage || ''})`}
            ></div>
            <div class="featured-content">
              <div class="featured-label">Featured Story</div>
              <div class="featured-meta">
                {new Date(featuredPost.data.pubDate).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </div>
              <h2>{featuredPost.data.title}</h2>
              <p>{featuredPost.data.description}</p>
              <span class="btn btn-primary">
                Read Article
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>
        </section>
      )}

      <!-- Latest Articles -->
      <section class="section">
        <div class="section-header">
          <h2 class="section-title">Latest Articles</h2>
          <a href="/blog" class="section-link">
            View all
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
        <div class="grid">
          {latestPosts.map((post) => (
            <a href={`/blog/${post.slug}/`} class="card">
              <div class="card-top">
                <span class="category-tag">Article</span>
                <span class="card-meta">5 min read</span>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <div class="card-footer">
                Read more
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- Categories -->
      <section class="section">
        <div class="section-header">
          <h2 class="section-title">Explore Categories</h2>
        </div>
        <div class="categories">
          <div class="category">
            <div class="category-icon">🤖</div>
            <h3>Artificial Intelligence</h3>
            <p>AI Models, Agents & Automation</p>
          </div>
          <div class="category">
            <div class="category-icon">📈</div>
            <h3>Business</h3>
            <p>Strategy & Leadership</p>
          </div>
          <div class="category">
            <div class="category-icon">🚀</div>
            <h3>Startups</h3>
            <p>Funding & Growth</p>
          </div>
          <div class="category">
            <div class="category-icon">🔒</div>
            <h3>Cybersecurity</h3>
            <p>Security & Privacy</p>
          </div>
          <div class="category">
            <div class="category-icon">☁️</div>
            <h3>Cloud</h3>
            <p>AWS, Azure & GCP</p>
          </div>
          <div class="category">
            <div class="category-icon">🎥</div>
            <h3>Creator Economy</h3>
            <p>Content & Monetization</p>
          </div>
        </div>
      </section>

      <!-- Why -->
      <section class="section">
        <div class="section-header">
          <h2 class="section-title">Why Professionals Read DigiSone Global</h2>
        </div>
        <div class="why-grid">
          <div class="why-card">
            <div class="why-icon">🔍</div>
            <h3>Deep Analysis</h3>
            <p>Practical insights beyond headlines and breaking news.</p>
          </div>
          <div class="why-card">
            <div class="why-icon">🧠</div>
            <h3>Expert Perspectives</h3>
            <p>Technology, leadership and innovation from industry experts.</p>
          </div>
          <div class="why-card">
            <div class="why-icon">⚡</div>
            <h3>Actionable Takeaways</h3>
            <p>Frameworks, lessons and strategies you can apply immediately.</p>
          </div>
        </div>
      </section>

      <!-- Newsletter -->
      <section id="newsletter" class="section">
        <div class="newsletter">
          <div class="newsletter-inner">
            <h2>Get the Weekly Technology Briefing</h2>
            <p>
              Actionable insights on AI, business strategy, cybersecurity and
              digital transformation — delivered every week.
            </p>
            <form class="newsletter-form" action="#" method="post">
              <input
                type="email"
                name="email"
                placeholder="Enter your email address"
                required
                autocomplete="email"
              />
              <button type="submit">Subscribe</button>
            </form>
            <p class="newsletter-note">No spam. Unsubscribe anytime.</p>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
