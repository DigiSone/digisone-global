---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate));

const featured = sortedPosts[0];
const latestPosts = sortedPosts.slice(1, 9);
const trending = sortedPosts.slice(0, 6);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
	<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	<script src="https://cdn.tailwindcss.com"></script>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
	<style>
		.hero-bg { background: linear-gradient(rgba(0,0,0,0.75), rgba(0,0,0,0.85)), url('https://picsum.photos/id/1015/2000/1200') center/cover; }
		.card { transition: all 0.4s cubic-bezier(0.4, 0.0, 0.2, 1); }
		.card:hover { transform: translateY(-10px); }
	</style>
</head>
<body class="bg-zinc-950 text-slate-200 font-sans antialiased">

	<!-- Top Live Bar -->
	<div class="bg-black py-2 text-xs border-b border-zinc-800">
		<div class="max-w-screen-2xl mx-auto px-6 flex items-center justify-between">
			<div class="flex items-center gap-3">
				<span class="text-emerald-400 flex items-center gap-1"><i class="fa-solid fa-bolt"></i> LIVE</span>
				<span class="hidden md:inline">Anthropic releases Claude 4 • Major reasoning breakthrough</span>
			</div>
			<a href="#" class="text-cyan-400 hover:text-white text-xs font-medium">Subscribe to Daily Brief →</a>
		</div>
	</div>

	<!-- Navigation -->
	<header class="sticky top-0 z-50 bg-zinc-950 border-b border-zinc-800">
		<Header />
	</header>

	<!-- Hero -->
	<section class="hero-bg h-screen flex items-center relative">
		<div class="max-w-screen-2xl mx-auto px-6 relative z-10">
			{featured && (
				<div class="max-w-2xl">
					<div class="uppercase text-xs tracking-[2px] text-cyan-400 mb-4 font-medium">EXCLUSIVE</div>
					<a href={`/blog/${featured.slug}`} class="block">
						<h1 class="text-6xl md:text-7xl font-bold leading-none tracking-tighter text-white">
							{featured.data.title}
						</h1>
					</a>
					<p class="mt-6 text-xl text-slate-300">{featured.data.description}</p>
					
					<div class="mt-10 flex items-center gap-6">
						<a href={`/blog/${featured.slug}`} class="bg-white text-black px-10 py-4 rounded-2xl font-semibold text-lg hover:bg-cyan-400 transition-all">
							Read Now
						</a>
						<div class="text-sm">
							<p>{featured.data.author}</p>
							<p class="text-xs text-slate-400">
								{new Date(featured.data.pubDate).toLocaleDateString('en-US', {month:'long', day:'numeric'})}
							</p>
						</div>
					</div>
				</div>
			)}
		</div>
	</section>

	<div class="max-w-screen-2xl mx-auto px-6 py-16">

		<!-- Latest + Trending -->
		<div class="grid lg:grid-cols-12 gap-12">

			<!-- Latest Articles -->
			<div class="lg:col-span-8">
				<div class="flex justify-between items-center mb-8">
					<h2 class="text-4xl font-semibold tracking-tight">Latest from DigiSone</h2>
					<a href="/blog" class="text-cyan-400 hover:text-white">View All →</a>
				</div>

				<div class="space-y-12">
					{latestPosts.map(post => (
						<div class="grid md:grid-cols-5 gap-8 card group">
							<div class="md:col-span-3">
								<img src={post.data.image || `https://picsum.photos/id/${Math.floor(Math.random()*80)+20}/800/500`} 
									 class="w-full aspect-video object-cover rounded-3xl" alt="" />
							</div>
							<div class="md:col-span-2 flex flex-col">
								<span class="uppercase text-xs text-violet-400 tracking-wider">{post.data.category || "Tech"}</span>
								<a href={`/blog/${post.slug}`} class="mt-3 text-2xl font-semibold leading-tight group-hover:text-cyan-300 transition-colors">
									{post.data.title}
								</a>
								<p class="mt-4 text-slate-400 line-clamp-3">{post.data.description}</p>
								<div class="mt-auto pt-6 text-xs text-slate-500">
									{post.data.author} • {new Date(post.data.pubDate).toLocaleDateString('en-US', {month:'short', day:'numeric'})}
								</div>
							</div>
						</div>
					))}
				</div>
			</div>

			<!-- Sidebar -->
			<aside class="lg:col-span-4 space-y-12">

				<!-- Trending -->
				<div>
					<h3 class="uppercase text-xs font-semibold tracking-widest text-rose-400 mb-6 flex items-center gap-2">
						<i class="fa-solid fa-fire-flame-curved"></i> Trending on DigiSone
					</h3>
					<div class="space-y-6">
						{trending.map((post, index) => (
							<a href={`/blog/${post.slug}`} class="flex gap-5 group">
								<span class="text-5xl font-bold text-white/10 group-hover:text-white/30 transition-colors">{index + 1}</span>
								<div>
									<p class="leading-tight font-medium group-hover:text-white transition-colors line-clamp-2">{post.data.title}</p>
									<p class="text-xs text-slate-500 mt-2">{post.data.author}</p>
								</div>
							</a>
						))}
					</div>
				</div>

				<!-- Newsletter -->
				<div class="bg-gradient-to-br from-zinc-900 to-zinc-950 border border-white/10 rounded-3xl p-8">
					<h3 class="text-2xl font-semibold">The DigiSone Brief</h3>
					<p class="text-slate-400 mt-2 text-sm">Curated insights from the world of technology. Delivered weekly.</p>
					<form class="mt-6">
						<input type="email" placeholder="your@email.com" class="w-full bg-zinc-950 border border-zinc-700 rounded-2xl px-5 py-4 text-sm focus:border-cyan-400 outline-none" />
						<button type="submit" class="mt-4 w-full py-4 bg-white text-black font-semibold rounded-2xl hover:bg-cyan-400 transition-all">Subscribe Free</button>
					</form>
				</div>

			</aside>
		</div>

		<!-- Categories -->
		<section class="mt-24 border-t border-zinc-800 pt-16">
			<h3 class="text-center uppercase text-xs tracking-widest text-slate-400 mb-8">Explore Topics</h3>
			<div class="flex flex-wrap justify-center gap-4">
				{["Artificial Intelligence", "Startups", "Enterprise Tech", "Cybersecurity", "Hardware", "Future of Work", "Venture Capital", "Policy"].map((cat) => (
					<span class="px-8 py-4 bg-zinc-900 hover:bg-zinc-800 border border-zinc-700 rounded-3xl text-sm transition-all cursor-pointer hover:border-cyan-400">
						{cat}
					</span>
				))}
			</div>
		</section>

	</div>

	<Footer />
</body>
</html>
