---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-[#0b0f19] text-slate-200 font-sans antialiased selection:bg-indigo-500 selection:text-white min-h-screen flex flex-col relative overflow-x-hidden">
		
		<!-- Premium Background Decorative Glows -->
		<div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-indigo-600/10 rounded-full blur-[120px] pointer-events-none -z-10"></div>
		<div class="absolute top-[40vh] right-1/4 w-[400px] h-[400px] bg-violet-600/10 rounded-full blur-[120px] pointer-events-none -z-10"></div>
		<div class="absolute bottom-10 left-1/3 w-[600px] h-[600px] bg-blue-600/5 rounded-full blur-[150px] pointer-events-none -z-10"></div>

		<!-- Sticky Glassmorphic Header Wrapper -->
		<div class="sticky top-0 z-50 backdrop-blur-md bg-[#0b0f19]/70 border-b border-white/5">
			<Header />
		</div>

		<!-- Main Premium Content Container -->
		<main class="flex-grow max-w-5xl mx-auto px-6 py-16 md:py-24 space-y-20 relative w-full">
			
			<!-- Hero Section -->
			<section class="space-y-6 text-center md:text-left max-w-4xl">
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold tracking-wider uppercase animate-pulse">
					✨ Shifting the Tech Paradigm
				</div>
				<h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white leading-none">
					👋 Welcome to <span class="bg-gradient-to-r from-indigo-400 via-violet-400 to-blue-400 bg-clip-text text-transparent">DigiSone Global</span>
				</h1>
				<p class="text-lg md:text-xl text-slate-400 font-light leading-relaxed pt-2">
					Welcome to the official <a href="https://digisone.com" class="text-indigo-400 font-medium hover:text-indigo-300 transition-colors duration-200 underline decoration-indigo-500/40 underline-offset-4 hover:decoration-indigo-400">DigiSone Global</a> a modern technology and digital knowledge platform built for creators, businesses and professionals. Our mission is to make technology, digital marketing, artificial intelligence, web development and business growth accessible through practical, easy-to-understand and actionable content.
				</p>
			</section>

			<!-- Trusted Resource Feature Section -->
			<section class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center bg-gradient-to-b from-white/[0.03] to-transparent p-8 md:p-12 rounded-3xl border border-white/[0.05] backdrop-blur-sm shadow-2xl">
				<div class="md:col-span-7 space-y-4">
					<div class="text-xs font-bold uppercase tracking-widest text-violet-400">Our Core Purpose</div>
					<p class="text-slate-300 text-base md:text-lg leading-relaxed">
						DigiSone Global serves as a trusted resource for individuals and organizations looking to stay informed about the latest trends, tools and strategies in the digital world. Whether you are building a personal brand, growing a business, improving your technical skills or exploring emerging technologies, our content is designed to help you achieve your goals.
					</p>
				</div>
				<div class="md:col-span-5 flex justify-center md:justify-end">
					<!-- Sleek Abstract Tech Box -->
					<div class="w-full max-w-[280px] aspect-square rounded-2xl bg-gradient-to-tr from-indigo-600 to-violet-600 flex flex-col justify-between p-6 shadow-lg shadow-indigo-500/20 group hover:scale-[1.02] transition-transform duration-300">
						<div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-white font-bold text-lg">DS</div>
						<div class="space-y-1">
							<div class="text-xs text-indigo-200 tracking-wider uppercase font-medium">Global Impact</div>
							<div class="text-xl font-bold text-white tracking-tight">Knowledge to Opportunity.</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Topics Interactive Grid -->
			<section id="topics" class="space-y-8">
				<div class="space-y-2">
					<h2 class="text-xs font-bold uppercase tracking-widest text-blue-400">Curated Architecture</h2>
					<p class="text-xl md:text-2xl font-bold text-white">Here are some of the topics you can explore on DigiSone Global:</p>
				</div>
				
				<!-- Converted raw <ul> to an Ultra-Premium Interactive Card Grid -->
				<ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 !list-none p-0 m-0">
					{[
						{ title: "Technology & Innovation", desc: "Next-gen advancements and paradigms.", icon: "🚀" },
						{ title: "Artificial Intelligence (AI)", desc: "Smart systems and automation architectures.", icon: "🤖" },
						{ title: "Web Development & Design", desc: "Modern engineering and seamless UX.", icon: "💻" },
						{ title: "Digital Marketing & SEO", desc: "Strategic visibility and growth mechanics.", icon: "📈" },
						{ title: "Business Growth Strategies", desc: "Scalable frameworks for enterprise success.", icon: "📊" },
						{ title: "Productivity & Professional Development", desc: "Optimized workflows and career compounding.", icon: "⚡" }
					].map((item) => (
						<li class="group bg-white/[0.02] hover:bg-white/[0.04] border border-white/[0.05] hover:border-indigo-500/30 p-6 rounded-2xl transition-all duration-300 flex flex-col justify-between space-y-4 hover:shadow-xl hover:shadow-indigo-500/[0.02] hover:-translate-y-1">
							<div class="space-y-2">
								<div class="text-2xl p-2 bg-white/[0.03] group-hover:bg-indigo-500/10 rounded-xl w-fit transition-colors duration-300">{item.icon}</div>
								<h3 class="text-base font-semibold text-white group-hover:text-indigo-300 transition-colors duration-300">{item.title}</h3>
								<p class="text-xs text-slate-500 font-light leading-relaxed">{item.desc}</p>
							</div>
							<div class="text-xs text-indigo-400 font-medium flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
								Explore Hub <span>→</span>
							</div>
						</li>
					))}
				</ul>
			</section>

			<!-- Vision & Origin Split Layout -->
			<section class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-6">
				<!-- Vision Card -->
				<div class="bg-gradient-to-br from-white/[0.02] to-transparent p-8 rounded-2xl border border-white/[0.04] space-y-3 relative group overflow-hidden">
					<div class="absolute -right-6 -bottom-6 text-8xl opacity-[0.02] font-black pointer-events-none select-none text-white">VISION</div>
					<h3 class="text-lg font-bold text-white flex items-center gap-2">
						<span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span> Our Vision
					</h3>
					<p class="text-slate-400 text-sm leading-relaxed font-light">
						Our vision is simple: transform knowledge into opportunity. By combining practical insights with real-world applications, DigiSone Global helps readers make informed decisions and stay ahead in an increasingly competitive digital landscape.
					</p>
				</div>

				<!-- Origin Card -->
				<div class="bg-gradient-to-br from-white/[0.02] to-transparent p-8 rounded-2xl border border-white/[0.04] space-y-3 relative group overflow-hidden">
					<div class="absolute -right-6 -bottom-6 text-8xl opacity-[0.02] font-black pointer-events-none select-none text-white">ORIGIN</div>
					<h3 class="text-lg font-bold text-white flex items-center gap-2">
						<span class="w-1.5 h-1.5 rounded-full bg-violet-400"></span> Local Roots, Global Scale
					</h3>
					<p class="text-slate-400 text-sm leading-relaxed font-light">
						Originating from Sonbhadra and reaching a global audience, DigiSone Global represents the belief that valuable ideas and impactful innovation can emerge from anywhere. We are committed to delivering high-quality content that informs, educates and inspires.
					</p>
				</div>
			</section>

			<!-- Call To Action Thank You Footer Section -->
			<section class="text-center max-w-2xl mx-auto space-y-6 pt-10 border-t border-white/[0.05]">
				<p class="text-slate-300 text-base md:text-lg font-light leading-relaxed">
					Thank you for visiting DigiSone Global. We invite you to explore our articles, discover new perspectives and become part of a growing community focused on learning, innovation and meaningful digital impact.
				</p>
				<div class="pt-2">
					<a href="#topics" class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-white text-slate-900 font-medium text-sm hover:bg-slate-100 transition-all duration-200 shadow-lg shadow-white/5 hover:scale-[1.02]">
						Get Started Coding & Learning
					</a>
				</div>
			</section>

		</main>

		<!-- Premium Clean Border Footer -->
		<div class="border-t border-white/5 bg-[#070a12]">
			<Footer />
		</div>
	</body>
</html>
