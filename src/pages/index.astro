---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="DigiSone Global" description="Helping Businesses, Creators, Tech Authors & Builders by providing Premium insights on AI, software engineering, startups, and modern digital ecosystems." />
		<style>
			:root {
				--bg: #030712;
				--surface: #0b0f19;
				--surface-hover: #111827;
				--text: #f3f4f6;
				--muted: #9ca3af;
				--muted-2: #6b7280;
				--primary: #6366f1;
				--primary-glow: rgba(99, 102, 241, 0.35);
				--accent: #ec4899;
				--cyan: #06b6d4;
				--border: rgba(255, 255, 255, 0.08);
				--border-hover: rgba(99, 102, 241, 0.5);
				--radius: 1.25rem;
				--radius-lg: 1.75rem;
				--shadow: 0 1rem 3rem rgba(0, 0, 0, 0.5);
				--shadow-glow: 0 0 40px rgba(99, 102, 241, 0.2);
				--font: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
				--ease: cubic-bezier(0.16, 1, 0.3, 1);
			}

			*, *::before, *::after { box-sizing: border-box; }
			html { scroll-behavior: smooth; }

			body {
				margin: 0;
				font-family: var(--font);
				color: var(--text);
				background: var(--bg);
				-webkit-font-smoothing: antialiased;
				overflow-x: hidden;
			}

			/* Immersive Ambient Glow Background */
			body::before {
				content: '';
				position: fixed;
				inset: 0;
				z-index: -1;
				pointer-events: none;
				background: 
					radial-gradient(circle 800px at 10% 10%, rgba(99, 102, 241, 0.12), transparent 70%),
					radial-gradient(circle 800px at 90% 85%, rgba(236, 72, 153, 0.09), transparent 70%),
					radial-gradient(circle 600px at 50% 50%, rgba(6, 182, 212, 0.06), transparent 70%);
				animation: ambient-pulse 10s ease-in-out infinite alternate;
			}

			@keyframes ambient-pulse {
				from { transform: scale(1); opacity: 0.8; }
				to { transform: scale(1.05); opacity: 1; }
			}

			@keyframes float {
				0%, 100% { transform: translateY(0px); }
				50% { transform: translateY(-8px); }
			}

			@keyframes pulse-glow {
				0%, 100% { opacity: 0.4; transform: scale(1); }
				50% { opacity: 1; transform: scale(1.08); }
			}

			@keyframes fade-up {
				from { opacity: 0; transform: translateY(24px); }
				to { opacity: 1; transform: translateY(0); }
			}

			.reveal { animation: fade-up 0.8s var(--ease) both; }
			.reveal-delay-1 { animation-delay: 0.1s; }
			.reveal-delay-2 { animation-delay: 0.2s; }

			main {
				width: min(100% - 2rem, 74rem);
				margin-inline: auto;
				padding-block: 2.5rem 5rem;
			}

			a { color: inherit; text-decoration: none; }
			h1, h2, h3 { margin: 0; line-height: 1.15; letter-spacing: -0.03em; }
			p { margin: 0; line-height: 1.7; color: var(--muted); }

			.section { margin-top: 5rem; }
			.section-header {
				display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap;
			}
			.section-header h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); color: #fff; }
			.section-header a {
				color: #818cf8; font-weight: 600; font-size: 0.95rem; display: inline-flex; align-items: center; gap: 0.4rem; transition: gap 0.3s var(--ease);
			}
			.section-header a:hover { gap: 0.7rem; color: #a5b4fc; }

			/* --- HERO SECTION WITH CREATOR VIBE --- */
			.hero-grid {
				display: grid;
				grid-template-columns: 1.25fr 0.75fr;
				gap: 1.5rem;
				align-items: stretch;
			}

			.hero-main-card {
				background: linear-gradient(145deg, var(--surface), #0f172a);
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				padding: 3.5rem 2.5rem;
				box-shadow: var(--shadow);
				position: relative;
				overflow: hidden;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}
			.hero-main-card::before {
				content: '';
				position: absolute;
				top: 0; left: 0; right: 0; height: 3px;
				background: linear-gradient(90deg, #6366f1, #ec4899, #06b6d4);
			}

			.creator-badge-live {
				display: inline-flex; align-items: center; gap: 0.6rem;
				padding: 0.45rem 1.1rem; border-radius: 999px;
				background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.25);
				font-size: 0.85rem; font-weight: 600; color: #818cf8; margin-bottom: 1.5rem;
				width: fit-content;
				box-shadow: 0 0 20px rgba(99, 102, 241, 0.15);
			}
			.creator-badge-live .pulse-dot {
				width: 8px; height: 8px; border-radius: 50%; background: #6366f1;
				box-shadow: 0 0 10px #6366f1;
				animation: pulse-glow 2s infinite;
			}

			.hero-main-card h1 {
				font-size: clamp(2.6rem, 5.5vw, 4.2rem);
				color: #fff;
				margin-bottom: 1.25rem;
				font-weight: 800;
			}
			.hero-main-card h1 span {
				background: linear-gradient(135deg, #818cf8 20%, #f472b6 60%, #38bdf8 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				filter: drop-shadow(0 2px 15px rgba(99, 102, 241, 0.3));
			}

			.hero-lead {
				font-size: 1.12rem;
				max-width: 38rem;
				margin-bottom: 2rem;
			}

			.hero-actions { display: flex; flex-wrap: wrap; gap: 1rem; }
			.btn {
				display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
				min-height: 3.1rem; padding: 0.75rem 1.6rem; border-radius: 0.85rem;
				font-weight: 600; font-size: 0.95rem; border: 1px solid transparent;
				transition: all 0.3s var(--ease);
				cursor: pointer; text-decoration: none;
			}
			.btn:hover { transform: translateY(-4px); }
			.btn-primary {
				background: linear-gradient(135deg, #6366f1, #4f46e5);
				color: #fff;
				box-shadow: 0 10px 30px rgba(99, 102, 241, 0.4);
			}
			.btn-primary:hover { box-shadow: 0 15px 40px rgba(99, 102, 241, 0.6); }
			.btn-secondary {
				background: rgba(255, 255, 255, 0.04);
				border-color: var(--border);
				color: #fff;
			}
			.btn-secondary:hover { background: rgba(255, 255, 255, 0.08); border-color: rgba(99, 102, 241, 0.3); }

			/* --- SLIDING MARQUEE TICKER (Real Creator Sliding Effect) --- */
			.marquee-container {
				margin-top: 1.5rem;
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 0.9rem 0;
				overflow: hidden;
				position: relative;
				box-shadow: 0 4px 20px rgba(0,0,0,0.3);
			}
			.marquee-container::before, .marquee-container::after {
				content: ''; position: absolute; top: 0; bottom: 0; width: 60px; z-index: 2; pointer-events: none;
			}
			.marquee-container::before { left: 0; background: linear-gradient(90deg, var(--surface), transparent); }
			.marquee-container::after { right: 0; background: linear-gradient(-90deg, var(--surface), transparent); }

			.marquee-track {
				display: flex;
				width: max-content;
				gap: 2rem;
				animation: scroll-marquee 25s linear infinite;
			}
			.marquee-container:hover .marquee-track { animation-play-state: paused; }

			@keyframes scroll-marquee {
				from { transform: translateX(0); }
				to { transform: translateX(-50%); }
			}

			.marquee-item {
				display: flex; align-items: center; gap: 0.5rem;
				font-size: 0.9rem; font-weight: 500; color: var(--muted);
				background: rgba(255, 255, 255, 0.02); padding: 0.4rem 1rem; border-radius: 999px;
				border: 1px solid rgba(255, 255, 255, 0.04);
				white-space: nowrap; transition: color 0.2s;
			}
			.marquee-item:hover { color: #fff; border-color: rgba(99, 102, 241, 0.3); }

			/* Hero Side Card */
			.hero-side-card {
				background: linear-gradient(145deg, var(--surface), #0f172a);
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				padding: 2rem;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				box-shadow: var(--shadow);
			}
			.side-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; }
			.side-header h3 { font-size: 1.1rem; color: #fff; }
			.live-badge {
				font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
				color: #10b981; background: rgba(16, 185, 129, 0.12); padding: 0.25rem 0.65rem; border-radius: 999px;
				box-shadow: 0 0 15px rgba(16, 185, 129, 0.2);
			}
			.trending-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
			.trending-item {
				display: flex; align-items: center; gap: 0.75rem; padding: 0.65rem 0.8rem;
				border-radius: 0.75rem; background: rgba(255, 255, 255, 0.02); border: 1px solid transparent;
				font-size: 0.9rem; color: var(--muted); font-weight: 500;
				transition: all 0.3s var(--ease);
			}
			.trending-item:hover {
				background: rgba(99, 102, 241, 0.08);
				border-color: rgba(99, 102, 241, 0.3);
				color: #fff;
				transform: translateX(5px);
			}
			.trending-num {
				width: 1.5rem; height: 1.5rem; border-radius: 0.4rem; background: rgba(99, 102, 241, 0.15);
				color: #818cf8; font-size: 0.75rem; font-weight: 700; display: grid; place-items: center;
			}

			/* --- SOCIAL MEDIA CHANNELS BAR --- */
			.social-grid {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: 1rem;
				margin-top: 2rem;
			}
			.social-card {
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 1.25rem 1.5rem;
				display: flex;
				align-items: center;
				gap: 1rem;
				transition: all 0.35s var(--ease);
				box-shadow: 0 4px 20px rgba(0,0,0,0.2);
			}
			.social-card:hover {
				transform: translateY(-6px);
				border-color: var(--border-hover);
				background: var(--surface-hover);
				box-shadow: 0 12px 30px rgba(99, 102, 241, 0.2);
			}
			.social-icon {
				width: 2.75rem; height: 2.75rem; border-radius: 0.75rem;
				display: grid; place-items: center; color: #818cf8;
				background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.2);
				flex-shrink: 0; transition: transform 0.3s var(--ease);
			}
			.social-card:hover .social-icon { transform: scale(1.15) rotate(-6deg); }
			.social-info h4 { font-size: 0.95rem; color: #fff; margin-bottom: 0.1rem; }
			.social-info span { font-size: 0.8rem; color: var(--muted); }

			/* --- FEATURED ARTICLE --- */
			.featured-article {
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				overflow: hidden;
				box-shadow: var(--shadow);
				transition: transform 0.4s var(--ease), border-color 0.4s ease;
			}
			.featured-article:hover {
				transform: translateY(-8px);
				border-color: var(--border-hover);
				box-shadow: 0 20px 50px rgba(99, 102, 241, 0.25);
			}
			.featured-grid {
				display: grid;
				grid-template-columns: 1.2fr 1fr;
			}
			.featured-media {
				background: #0b0f19;
				min-height: 22rem;
				position: relative;
				overflow: hidden;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.featured-media img {
				width: 100%; height: 100%; object-fit: cover; display: block;
				transition: transform 0.7s var(--ease);
			}
			.featured-article:hover .featured-media img { transform: scale(1.06); }
			.featured-fallback { color: var(--muted); font-size: 0.9rem; text-align: center; padding: 2rem; }
			.featured-content {
				padding: 2.75rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}
			.badge-pill {
				font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
				color: #818cf8; background: rgba(99, 102, 241, 0.12); padding: 0.35rem 0.85rem;
				border-radius: 999px; width: fit-content; margin-bottom: 1rem;
				box-shadow: 0 0 15px rgba(99, 102, 241, 0.15);
			}
			.article-date { font-size: 0.88rem; color: var(--muted-2); margin-bottom: 0.5rem; }
			.featured-content h3 {
				font-size: clamp(1.4rem, 2.5vw, 1.95rem); color: #fff; margin-bottom: 0.75rem;
				transition: color 0.2s ease;
			}
			.featured-article:hover .featured-content h3 { color: #818cf8; }
			.article-excerpt { font-size: 0.98rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 1.5rem; }

			/* --- LATEST POSTS GRID --- */
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1.5rem;
				list-style: none; margin: 0; padding: 0;
			}
			.post-card {
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				overflow: hidden;
				display: flex;
				flex-direction: column;
				transition: all 0.4s var(--ease);
				box-shadow: 0 4px 20px rgba(0,0,0,0.2);
			}
			.post-card:hover {
				transform: translateY(-8px);
				border-color: var(--border-hover);
				box-shadow: 0 18px 45px rgba(99, 102, 241, 0.2);
			}
			.post-thumb-wrapper {
				width: 100%; aspect-ratio: 16 / 9; background: #0b0f19; position: relative; overflow: hidden;
			}
			.post-thumb {
				width: 100%; height: 100%; object-fit: cover; display: block;
				transition: transform 0.6s var(--ease);
			}
			.post-card:hover .post-thumb { transform: scale(1.06); }
			.post-body { padding: 1.5rem; display: flex; flex-direction: column; flex-grow: 1; }
			.post-date { font-size: 0.82rem; color: var(--muted-2); margin-bottom: 0.4rem; }
			.post-card h3 { font-size: 1.15rem; color: #fff; margin-bottom: 0.6rem; transition: color 0.2s; }
			.post-card:hover h3 { color: #818cf8; }
			.post-desc { font-size: 0.91rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: auto; }

			/* --- CREATOR SPOTLIGHT (VIKAS MISHRA) --- */
			.creator-spotlight {
				background: linear-gradient(135deg, rgba(11, 15, 25, 0.95), rgba(30, 27, 75, 0.6));
				border: 1px solid rgba(99, 102, 241, 0.25);
				border-radius: var(--radius-lg);
				padding: 3.5rem;
				display: grid;
				grid-template-columns: auto 1fr;
				gap: 2.5rem;
				align-items: center;
				box-shadow: var(--shadow-glow);
				position: relative;
				overflow: hidden;
				margin-top: 5rem;
			}
			.creator-spotlight::before {
				content: '';
				position: absolute;
				top: -50px; right: -50px; width: 300px; height: 300px;
				background: radial-gradient(circle, rgba(99, 102, 241, 0.2), transparent 70%);
				pointer-events: none;
				animation: float 6s ease-in-out infinite;
			}
			.creator-avatar {
				width: 7rem; height: 7rem; border-radius: 50%;
				background: linear-gradient(135deg, #6366f1, #ec4899);
				color: #fff; display: grid; place-items: center;
				font-size: 2.4rem; font-weight: 800;
				box-shadow: 0 0 35px rgba(99, 102, 241, 0.5);
				flex-shrink: 0;
				border: 3px solid rgba(255, 255, 255, 0.15);
				animation: float 4s ease-in-out infinite;
			}
			.creator-details h2 { font-size: 1.75rem; color: #fff; margin-bottom: 0.3rem; display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
			.creator-role { color: #818cf8; font-weight: 600; font-size: 0.98rem; margin-bottom: 1rem; display: block; }
			.creator-bio { color: var(--muted); font-size: 1.05rem; max-width: 48rem; line-height: 1.8; }

			/* --- CATEGORIES GRID --- */
			.categories-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1.25rem;
			}
			.category-card {
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 1.5rem;
				transition: all 0.35s var(--ease);
				box-shadow: 0 4px 20px rgba(0,0,0,0.2);
			}
			.category-card:hover {
				transform: translateY(-6px);
				border-color: var(--border-hover);
				background: var(--surface-hover);
				box-shadow: 0 12px 35px rgba(99, 102, 241, 0.2);
			}
			.cat-icon-box {
				width: 3.2rem; height: 3.2rem; border-radius: 0.85rem;
				display: grid; place-items: center; font-size: 1.4rem;
				background: rgba(99, 102, 241, 0.12); border: 1px solid rgba(99, 102, 241, 0.2);
				margin-bottom: 1rem; transition: transform 0.3s var(--ease);
			}
			.category-card:hover .cat-icon-box { transform: scale(1.15) rotate(-8deg); }
			.category-card h3 { font-size: 1.1rem; color: #fff; margin-bottom: 0.3rem; }
			.category-card p { font-size: 0.88rem; }

			/* --- NEWSLETTER BANNER --- */
			.newsletter-banner {
				margin-top: 5rem;
				padding: 4rem 2rem;
				background: linear-gradient(135deg, rgba(99, 102, 241, 0.12), rgba(236, 72, 153, 0.1));
				border: 1px solid rgba(99, 102, 241, 0.3);
				border-radius: var(--radius-lg);
				text-align: center;
				box-shadow: var(--shadow-glow);
				position: relative;
				overflow: hidden;
			}
			.newsletter-banner h2 { font-size: clamp(1.8rem, 3.5vw, 2.5rem); color: #fff; margin-bottom: 0.75rem; }
			.newsletter-banner p { max-width: 36rem; margin: 0 auto 2rem; font-size: 1.08rem; }
			.newsletter-note { margin-top: 1rem; font-size: 0.82rem; color: var(--muted-2); }

			.empty-state {
				padding: 3rem; text-align: center; background: var(--surface);
				border: 1px dashed var(--border); border-radius: var(--radius); color: var(--muted);
			}

			@media (max-width: 1024px) {
				.hero-grid { grid-template-columns: 1fr; }
				.social-grid { grid-template-columns: repeat(2, 1fr); }
				.featured-grid { grid-template-columns: 1fr; }
				.posts-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
			}
			@media (max-width: 768px) {
				.posts-grid, .categories-grid { grid-template-columns: 1fr; }
				.social-grid { grid-template-columns: 1fr; }
				.creator-spotlight { grid-template-columns: 1fr; text-align: center; justify-items: center; }
				.creator-details h2 { justify-content: center; }
				.hero-actions { flex-direction: column; }
				.btn { width: 100%; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<!-- HERO & TRENDING WIDGET -->
			<section class="hero-grid" aria-label="Hero Introduction">
				<div class="hero-main-card reveal">
					<div class="creator-badge-live">
						<span class="pulse-dot"></span> Curated & Authored by Vikas Mishra
					</div>
					<h1>Architecting the <span>Future of Tech & AI</span></h1>
					<p class="hero-lead">
						Welcome to my independent digital sanctuary. I decode cutting-edge shifts in artificial intelligence, modern software systems, startups, and elite digital strategy.
					</p>
					<div class="hero-actions">
						<a class="btn btn-primary" href="/blog/">Explore Writings →</a>
						<a class="btn btn-secondary" href="#creator-profile">Meet Vikas Mishra</a>
					</div>
				</div>

				<aside class="hero-side-card reveal reveal-delay-1" aria-label="Trending topics">
					<div class="side-header">
						<h3>Trending Focus</h3>
						<span class="live-badge">Live Index</span>
					</div>
					<ol class="trending-list">
						{
							trendingTopics.slice(0, 5).map((topic, i) => (
								<li class="trending-item">
									<span class="trending-num">{String(i + 1).padStart(2, '0')}</span>
									{topic}
								</li>
							))
						}
					</ol>
				</aside>
			</section>

			<!-- SLIDING MARQUEE TICKER (Smooth Infinite Animation) -->
			<div class="marquee-container reveal reveal-delay-2" aria-label="Sliding highlights">
				<div class="marquee-track">
					{
						[...trendingTopics, ...trendingTopics].map((item) => (
							<div class="marquee-item">
								<span>{item}</span>
							</div>
						))
					}
				</div>
			</div>

			<!-- SOCIAL MEDIA CHANNELS BAR -->
			<section aria-label="Social media channels" class="reveal">
				<div class="social-grid">
					{
						socialLinks.map((social) => (
							<a href={social.href} target="_blank" rel="noopener noreferrer" class="social-card">
								<div class="social-icon" set:html={social.svg} />
								<div class="social-info">
									<h4>{social.platform}</h4>
									<span>{social.handle}</span>
								</div>
							</a>
						))
					}
				</div>
			</section>

			<!-- FEATURED ARTICLE (Sanity CMS) -->
			<section class="section reveal" aria-label="Featured article">
				{
					featuredPost ? (
						<article class="featured-article">
							<a href={`/blog/${featuredPost.slug.current}/`} aria-label={`Read: ${featuredPost.title}`}>
								<div class="featured-grid">
									<div class="featured-media">
										{featuredPost.imageUrl ? (
											<img src={featuredPost.imageUrl} alt={featuredPost.title} loading="eager" />
										) : (
											<div class="featured-fallback">Featured Story Image</div>
										)}
									</div>
									<div class="featured-content">
										<div class="badge-pill">Editor's Choice • By Vikas Mishra</div>
										<p class="article-date">
											<time datetime={featuredPost._createdAt}>
												{new Date(featuredPost._createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
											</time>
										</p>
										<h3>{featuredPost.title}</h3>
										<p class="article-excerpt">{featuredPost.excerpt}</p>
										<span class="btn btn-primary" style="width: fit-content; min-height: 2.5rem; padding: 0.5rem 1.2rem; font-size: 0.88rem;">Read Full Story</span>
									</div>
								</div>
							</a>
						</article>
					) : (
						<div class="empty-state">No articles published yet. Add posts via Sanity Studio.</div>
					)
				}
			</section>

			<!-- LATEST ARTICLES GRID -->
			<section class="section" aria-label="Latest articles">
				<div class="section-header reveal">
					<h2>Latest Masterclasses & Articles</h2>
					<a href="/blog/">Browse All Archive →</a>
				</div>

				{
					latestPosts.length > 0 ? (
						<ul class="posts-grid">
							{latestPosts.map((post: any, i: number) => (
								<li class={`post-card reveal reveal-delay-${Math.min(i + 1, 2)}`}>
									<a href={`/blog/${post.slug.current}/`} aria-label={post.title} style="display: flex; flex-direction: column; height: 100%;">
										<div class="post-thumb-wrapper">
											{post.imageUrl ? (
												<img class="post-thumb" src={post.imageUrl} alt={post.title} loading="lazy" />
											) : (
												<div style="display:grid; place-items:center; height:100%; color:var(--muted); font-size:0.85rem;">Article Preview</div>
											)}
										</div>
										<div class="post-body">
											<p class="post-date">
												<time datetime={post._createdAt}>
													{new Date(post._createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
												</time>
											</p>
											<h3>{post.title}</h3>
											<p class="post-desc">{post.excerpt}</p>
										</div>
									</a>
								</li>
							))}
						</ul>
					) : (
						<div class="empty-state">More articles coming soon. Stay tuned!</div>
					)
				}
			</section>

			<!-- CREATOR / AUTHOR SPOTLIGHT (Vikas Mishra) -->
			<section class="creator-spotlight reveal" id="creator-profile" aria-label="About Vikas Mishra">
				<div class="creator-avatar" aria-hidden="true">VM</div>
				<div class="creator-details">
					<h2>Vikas Mishra <span style="font-size: 0.85rem; font-weight: 600; background: rgba(99,102,241,0.2); color: #818cf8; padding: 0.2rem 0.7rem; border-radius: 999px;">Founder & Lead Architect</span></h2>
					<span class="creator-role">Tech Author, Creator & Digital Ecosystem Builder</span>
					<p class="creator-bio">
						I’m Vikas Mishra. Through DigiSone Global, I curate deep insights, rigorous technological analysis, and modern digital strategies. My mission is to empower founders, engineers, and innovators with high-signal frameworks to build market-defining ventures.
					</p>
				</div>
			</section>

			<!-- EXPLORE CATEGORIES -->
			<section class="section" aria-label="Categories">
				<div class="section-header reveal">
					<h2>Explore by Knowledge Domain</h2>
					<a href="/categories/">All Topics →</a>
				</div>
				<div class="categories-grid">
					{
						categories.map((cat, i) => (
							<a href={cat.href} class={`category-card reveal reveal-delay-${Math.min(i + 1, 2)}`}>
								<div class="cat-icon-box" aria-hidden="true">{cat.icon}</div>
								<h3>{cat.title}</h3>
								<p>{cat.desc}</p>
							</a>
						))
					}
				</div>
			</section>

			<!-- NEWSLETTER SUBSCRIPTION BANNER -->
			<section class="newsletter-banner reveal" id="newsletter" aria-label="Newsletter">
				<h2>Get the Weekly Tech & Strategy Briefing</h2>
				<p>Hand-crafted insights on AI, cloud architecture, and modern product scaling delivered directly to your inbox every Sunday by Vikas Mishra.</p>
				<a class="btn btn-primary" href="/subscribe/"> Subscribe</a>
				<p class="newsletter-note">Zero spam. Unsubscribe with a single click anytime.</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
