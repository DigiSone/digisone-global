---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
	<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	<script src="https://cdn.tailwindcss.com"></script>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
</head>
<body class="bg-[#05070f] text-slate-200 font-sans antialiased">

	<!-- Top Bar -->
	<div class="bg-black py-3 text-xs border-b border-zinc-800">
		<div class="max-w-screen-2xl mx-auto px-6 flex items-center justify-between">
			<div class="flex items-center gap-4 text-emerald-400">
				<i class="fa-solid fa-bolt"></i>
				<span class="font-medium tracking-wider">GLOBAL TECH INTELLIGENCE</span>
			</div>
			<div class="hidden md:flex items-center gap-6 text-xs">
				<a href="#" class="hover:text-white transition-colors">Newsletters</a>
				<a href="#" class="hover:text-white transition-colors">Research</a>
				<a href="#" class="hover:text-white transition-colors">Events</a>
			</div>
		</div>
	</div>

	<!-- Header -->
	<header class="sticky top-0 z-50 bg-[#05070f]/95 backdrop-blur-xl border-b border-white/5">
		<Header />
	</header>

	<!-- Hero -->
	<section class="min-h-screen flex items-center relative hero-bg bg-cover bg-center" 
			 style="background-image: linear-gradient(rgba(5,7,15,0.75), rgba(5,7,15,0.9)), url('https://picsum.photos/id/1015/2000/1200')">
		<div class="max-w-5xl mx-auto px-6 text-center md:text-left">
			<div class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-white/10 backdrop-blur border border-white/20 text-sm mb-8">
				<span class="text-cyan-400">✦</span> ESTABLISHED 2024
			</div>
			
			<h1 class="text-6xl md:text-7xl lg:text-8xl font-bold tracking-tighter leading-none text-white">
				DigiSone <span class="bg-gradient-to-r from-cyan-300 to-violet-300 bg-clip-text text-transparent">Global</span>
			</h1>
			
			<p class="mt-8 text-2xl md:text-3xl text-slate-300 max-w-3xl mx-auto md:mx-0">
				Premium technology intelligence for leaders, innovators, and builders.
			</p>
			
			<div class="mt-12 flex flex-wrap justify-center md:justify-start gap-5">
				<a href="#explore" class="px-10 py-5 bg-white text-black font-semibold rounded-3xl text-lg hover:bg-cyan-400 transition-all">
					Explore the Platform
				</a>
				<a href="#" class="px-10 py-5 border border-white/40 hover:border-white rounded-3xl text-lg transition-all">
					Watch Film
				</a>
			</div>
		</div>

		<div class="absolute bottom-12 left-1/2 text-xs tracking-widest opacity-60 flex flex-col items-center">
			SCROLL TO DISCOVER
			<div class="w-px h-12 bg-gradient-to-b from-transparent via-slate-400 to-transparent mt-4"></div>
		</div>
	</section>

	<!-- Trust Bar -->
	<div class="border-b border-white/10 py-8 bg-black/40">
		<div class="max-w-screen-2xl mx-auto px-6 flex flex-wrap justify-center gap-x-16 gap-y-6 items-center text-sm opacity-75">
			<div>Featured in</div>
			<div class="font-medium">TechCrunch</div>
			<div class="font-medium">Forbes</div>
			<div class="font-medium">Wired</div>
			<div class="font-medium">YourStory</div>
			<div class="font-medium">The Economic Times</div>
		</div>
	</div>

	<!-- Core Value -->
	<section id="explore" class="max-w-screen-2xl mx-auto px-6 py-28">
		<div class="grid md:grid-cols-2 gap-16 items-center">
			<div>
				<span class="uppercase text-xs tracking-widest text-violet-400">Our Mission</span>
				<h2 class="text-5xl font-bold tracking-tighter leading-none mt-6">
					Knowledge that drives the future.
				</h2>
				<p class="mt-8 text-lg text-slate-400 max-w-md">
					DigiSone Global delivers deeply researched, beautifully presented intelligence on artificial intelligence, emerging technology, business strategy, and digital transformation.
				</p>
			</div>
			<div class="bg-gradient-to-br from-zinc-900 to-zinc-950 border border-white/10 rounded-3xl p-12">
				<div class="space-y-8">
					<div class="flex gap-6">
						<div class="text-4xl">🚀</div>
						<div>
							<div class="font-semibold text-xl">Future-First Thinking</div>
							<div class="text-slate-400">We decode tomorrow’s technology today.</div>
						</div>
					</div>
					<div class="flex gap-6">
						<div class="text-4xl">🧠</div>
						<div>
							<div class="font-semibold text-xl">Independent Journalism</div>
							<div class="text-slate-400">No agendas. Only clarity and insight.</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Topics -->
	<section class="bg-zinc-900 py-20">
		<div class="max-w-screen-2xl mx-auto px-6">
			<h3 class="text-center text-sm uppercase tracking-widest text-slate-400 mb-12">What We Cover</h3>
			<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
				{[
					"Artificial Intelligence", "Startups & Venture", "Enterprise Technology", 
					"Cybersecurity", "Semiconductors", "Digital Transformation", 
					"Future of Work", "Policy & Regulation"
				].map(topic => (
					<div class="bg-zinc-950 border border-white/10 hover:border-cyan-400/50 p-8 rounded-3xl transition-all hover:-translate-y-1 text-center">
						<p class="font-semibold text-lg">{topic}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Vision -->
	<section class="max-w-screen-2xl mx-auto px-6 py-28 text-center">
		<div class="max-w-2xl mx-auto">
			<h2 class="text-5xl font-bold tracking-tight">From Sonbhadra to the World</h2>
			<p class="mt-8 text-slate-400 text-lg leading-relaxed">
				Born with Indian roots and a global vision. DigiSone Global is where serious thinkers come to understand technology’s impact on business, society, and humanity.
			</p>
			<div class="mt-12">
				<a href="#" class="inline-block px-12 py-6 bg-white text-black font-semibold rounded-3xl text-lg hover:bg-gradient-to-r hover:from-cyan-400 hover:to-violet-400 hover:text-white transition-all">
					Join the Community
				</a>
			</div>
		</div>
	</section>

	<Footer />
</body>
</html>
