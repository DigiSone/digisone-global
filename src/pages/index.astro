---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-[#0b0f19] text-slate-200 font-sans antialiased selection:bg-indigo-500 selection:text-white min-h-screen flex flex-col relative overflow-x-hidden">
		
		<!-- Background Glows -->
		<div class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-indigo-600/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>
		<div class="absolute top-[35vh] right-1/4 w-[500px] h-[500px] bg-violet-600/10 rounded-full blur-[130px] pointer-events-none -z-10"></div>
		<div class="absolute bottom-20 left-1/3 w-[700px] h-[700px] bg-blue-600/5 rounded-full blur-[160px] pointer-events-none -z-10"></div>

		<!-- Sticky Header -->
		<div class="sticky top-0 z-50 backdrop-blur-xl bg-[#0b0f19]/80 border-b border-white/5">
			<Header />
		</div>

		<main class="flex-grow max-w-5xl mx-auto px-5 md:px-6 py-16 md:py-24 space-y-24 w-full">

			<!-- Hero -->
			<section class="space-y-8 text-center md:text-left">
				<div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gradient-to-r from-indigo-500/10 to-violet-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold tracking-[1px] uppercase">
					<span class="relative flex h-2 w-2">
						<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
						<span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-400"></span>
					</span>
					Shaping the Future of Tech
				</div>

				<h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tighter leading-none text-white">
					Welcome to <span class="bg-gradient-to-r from-indigo-300 via-violet-300 to-cyan-300 bg-clip-text text-transparent">DigiSone Global</span>
				</h1>

				<p class="max-w-3xl mx-auto md:mx-0 text-lg md:text-xl text-slate-400 font-light leading-relaxed">
					A premium technology platform delivering actionable insights on Artificial Intelligence, Web Development, Digital Marketing, Business Strategy and Emerging Technologies.
				</p>

				<div class="flex flex-wrap justify-center md:justify-start gap-4 pt-4">
					<a href="#topics" 
						class="px-8 py-4 bg-white text-slate-900 font-semibold rounded-2xl hover:bg-slate-100 transition-all duration-300 flex items-center gap-3 group">
						Explore Topics
						<span class="group-hover:translate-x-1 transition-transform">→</span>
					</a>
					<a href="#" 
						class="px-8 py-4 border border-white/30 hover:border-white/60 rounded-2xl transition-all duration-300">
						Watch Latest Video
					</a>
				</div>
			</section>

			<!-- Purpose Section -->
			<section class="grid md:grid-cols-12 gap-10 items-center bg-gradient-to-br from-white/[0.03] to-transparent border border-white/5 rounded-3xl p-8 md:p-14 backdrop-blur-sm">
				<div class="md:col-span-7 space-y-6">
					<div class="uppercase text-xs tracking-[2px] font-semibold text-violet-400">Our Mission</div>
					<h2 class="text-3xl md:text-4xl font-semibold leading-tight text-white">
						Knowledge that turns into opportunity
					</h2>
					<p class="text-slate-400 leading-relaxed text-[17px]">
						DigiSone Global is your trusted source for practical, high-quality content on technology, AI, digital growth, and innovation. We simplify complex topics and deliver real-world strategies that help individuals and businesses thrive.
					</p>
				</div>

				<div class="md:col-span-5 flex justify-center">
					<div class="w-full max-w-xs aspect-square bg-gradient-to-br from-indigo-600 via-violet-600 to-fuchsia-600 rounded-3xl p-8 flex flex-col justify-between shadow-2xl shadow-indigo-500/30 hover:scale-105 transition-transform duration-500">
						<div class="text-4xl">🌍</div>
						<div>
							<div class="text-white/90 text-sm tracking-widest">FROM SONBHADRA TO THE WORLD</div>
							<div class="text-2xl font-bold text-white mt-2">Global Impact, Local Roots</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Topics Section -->
			<section id="topics" class="space-y-10">
				<div class="text-center md:text-left">
					<span class="text-xs font-bold uppercase tracking-widest text-blue-400">Knowledge Architecture</span>
					<h2 class="text-3xl md:text-4xl font-bold text-white mt-2">Explore Our Core Domains</h2>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
					{[
						{ title: "Technology & Innovation", desc: "Next-gen advancements and breakthrough paradigms", icon: "🚀" },
						{ title: "Artificial Intelligence", desc: "Machine learning, automation & intelligent systems", icon: "🤖" },
						{ title: "Web Development", desc: "Modern frameworks, performance & beautiful UX", icon: "💻" },
						{ title: "Digital Marketing", desc: "SEO, content strategy & growth hacking", icon: "📈" },
						{ title: "Business & Startups", desc: "Scaling, strategy and entrepreneurship", icon: "📊" },
						{ title: "Productivity", desc: "Systems, tools and high-performance workflows", icon: "⚡" }
					].map((topic) => (
						<div class="group bg-white/[0.02] hover:bg-white/[0.04] border border-white/5 hover:border-indigo-400/30 p-8 rounded-3xl transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-indigo-500/10">
							<div class="text-4xl mb-6 transition-transform group-hover:scale-110 duration-300">{topic.icon}</div>
							<h3 class="text-xl font-semibold text-white group-hover:text-indigo-300 transition-colors">{topic.title}</h3>
							<p class="text-slate-400 mt-3 text-[15px] leading-relaxed">{topic.desc}</p>
							<div class="mt-6 text-xs text-indigo-400 font-medium flex items-center gap-2 opacity-70 group-hover:opacity-100">
								Explore Collection <span class="text-base">→</span>
							</div>
						</div>
					))}
				</div>
			</section>

			<!-- Vision + Origin -->
			<section class="grid md:grid-cols-2 gap-8">
				<div class="bg-gradient-to-br from-white/[0.03] to-transparent border border-white/5 rounded-3xl p-9 group">
					<div class="text-indigo-400 mb-4">✦ OUR VISION</div>
					<h3 class="text-2xl font-semibold text-white">Democratizing High-Quality Tech Knowledge</h3>
					<p class="text-slate-400 mt-5 leading-relaxed">
						We believe powerful ideas should be accessible to everyone. DigiSone Global exists to bridge the gap between complex technology and practical understanding.
					</p>
				</div>

				<div class="bg-gradient-to-br from-white/[0.03] to-transparent border border-white/5 rounded-3xl p-9 group">
					<div class="text-violet-400 mb-4">✦ OUR ROOTS</div>
					<h3 class="text-2xl font-semibold text-white">From Sonbhadra to the Global Stage</h3>
					<p class="text-slate-400 mt-5 leading-relaxed">
						Born in India with a global mindset. We prove that world-class content and ideas can originate from anywhere and reach everywhere.
					</p>
				</div>
			</section>

			<!-- Final CTA -->
			<section class="text-center py-12 border-t border-white/5">
				<p class="text-slate-300 text-lg max-w-2xl mx-auto">
					Thank you for being part of the DigiSone Global community.<br>
					Stay curious. Keep learning. Build the future.
				</p>
				<a href="#" class="mt-8 inline-block px-10 py-4 bg-gradient-to-r from-indigo-500 to-violet-500 text-white font-semibold rounded-2xl hover:scale-105 transition-transform shadow-lg shadow-indigo-500/30">
					Start Exploring Now
				</a>
			</section>

		</main>

		<div class="border-t border-white/5 bg-[#070a12]">
			<Footer />
		</div>
	</body>
</html>
