---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = posts[0];
const latestPosts = posts.slice(1, 7);

const trendingTopics = [
	'AI Agents & Autonomous Systems',
	'Enterprise Automation',
	'Future of Work',
	'Cybersecurity & Privacy',
	'Cloud Infrastructure',
	'Startup Growth Strategies',
];

const categories = [
	{ icon: '🤖', title: 'Artificial Intelligence', desc: 'Models, Agents & Automation', href: '/categories' },
	{ icon: '📈', title: 'Business Strategy', desc: 'Leadership & Growth', href: '/categories' },
	{ icon: '🚀', title: 'Startups', desc: 'Funding & Scale', href: '/categories' },
	{ icon: '🔒', title: 'Cybersecurity', desc: 'Security & Privacy', href: '/categories' },
	{ icon: '☁️', title: 'Cloud', desc: 'AWS, Azure & GCP', href: '/categories' },
	{ icon: '🌐', title: 'Future of Work', desc: 'Teams, Tools & Culture', href: '/categories' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			:root {
				--bg: #f1f5f9;
				--surface: #ffffff;
				--text: #0b1220;
				--muted: #475569;
				--muted-2: #94a3b8;
				--primary: #2563eb;
				--primary-dark: #1d4ed8;
				--primary-soft: rgba(37, 99, 235, 0.1);
				--accent: #6366f1;
				--border: rgba(15, 23, 42, 0.08);
				--radius: 1.25rem;
				--radius-lg: 1.75rem;
				--shadow-xs: 0 0.15rem 0.5rem rgba(15, 23, 42, 0.04);
				--shadow: 0 1rem 2.5rem rgba(15, 23, 42, 0.08);
				--shadow-lg: 0 1.75rem 4rem rgba(15, 23, 42, 0.12);
				--font: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
				--ease: cubic-bezier(0.22, 1, 0.36, 1);
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				margin: 0;
				font-family: var(--font);
				color: var(--text);
				background: var(--bg);
				-webkit-font-smoothing: antialiased;
			}

			body::before {
				content: '';
				position: fixed;
				inset: 0;
				z-index: -1;
				pointer-events: none;
				background:
					radial-gradient(ellipse 80% 50% at 10% -10%, rgba(37, 99, 235, 0.12), transparent 55%),
					radial-gradient(ellipse 60% 40% at 90% 0%, rgba(99, 102, 241, 0.1), transparent 50%);
				animation: ambient-shift 18s ease-in-out infinite alternate;
			}

			@keyframes ambient-shift {
				from { opacity: 0.85; transform: scale(1); }
				to { opacity: 1; transform: scale(1.04); }
			}

			/* ——— Entrance animations ——— */
			@keyframes fade-up {
				from {
					opacity: 0;
					transform: translateY(18px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@keyframes fade-in {
				from { opacity: 0; }
				to { opacity: 1; }
			}

			@keyframes scale-in {
				from {
					opacity: 0;
					transform: scale(0.97);
				}
				to {
					opacity: 1;
					transform: scale(1);
				}
			}

			.reveal {
				animation: fade-up 0.7s var(--ease) both;
			}

			.reveal-delay-1 { animation-delay: 0.08s; }
			.reveal-delay-2 { animation-delay: 0.16s; }
			.reveal-delay-3 { animation-delay: 0.24s; }
			.reveal-delay-4 { animation-delay: 0.32s; }
			.reveal-delay-5 { animation-delay: 0.4s; }

			main {
				width: min(100% - 2rem, 72rem);
				margin-inline: auto;
				padding-block: 1.5rem 4rem;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			h1,
			h2,
			h3 {
				margin: 0;
				line-height: 1.15;
				letter-spacing: -0.03em;
			}

			p {
				margin: 0;
				line-height: 1.7;
			}

			.section {
				margin-top: 4rem;
			}

			.section-header {
				display: flex;
				align-items: end;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1.35rem;
				flex-wrap: wrap;
			}

			.section-header h2 {
				font-size: clamp(1.5rem, 3vw, 2rem);
			}

			.section-header a {
				color: var(--primary);
				font-weight: 600;
				font-size: 0.95rem;
				transition: gap 0.25s var(--ease), color 0.2s ease, transform 0.2s ease;
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
			}

			.section-header a:hover {
				color: var(--primary-dark);
				gap: 0.55rem;
				transform: translateX(2px);
			}

			/* ——— Hero ——— */
			.hero {
				display: grid;
				grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.85fr);
				gap: 2.5rem;
				align-items: center;
				padding: 2.75rem 0 2rem;
			}

			.hero-badge {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.45rem 0.95rem 0.45rem 0.65rem;
				border-radius: 999px;
				background: var(--surface);
				border: 1px solid var(--border);
				box-shadow: var(--shadow-xs);
				font-size: 0.84rem;
				font-weight: 600;
				margin-bottom: 1.1rem;
			}

			.hero-badge .dot {
				width: 0.5rem;
				height: 0.5rem;
				border-radius: 50%;
				background: #22c55e;
				box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
				animation: pulse 2.2s ease-in-out infinite;
			}

			@keyframes pulse {
				0%, 100% { box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.22); }
				50% { box-shadow: 0 0 0 7px rgba(34, 197, 94, 0.08); }
			}

			.hero h1 {
				font-size: clamp(2.4rem, 6vw, 4rem);
				max-width: 14ch;
				margin-bottom: 1rem;
			}

			.hero h1 span {
				background: linear-gradient(120deg, #2563eb, #6366f1 55%, #8b5cf6);
				background-size: 200% auto;
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
				animation: gradient-move 6s ease infinite;
			}

			@keyframes gradient-move {
				0%, 100% { background-position: 0% center; }
				50% { background-position: 100% center; }
			}

			.hero-lead {
				color: #334155;
				font-size: 1.1rem;
				max-width: 36rem;
			}

			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 1.5rem;
			}

			.btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.4rem;
				min-height: 2.75rem;
				padding: 0.7rem 1.2rem;
				border-radius: 0.75rem;
				font-weight: 600;
				font-size: 0.95rem;
				border: 1px solid transparent;
				transition:
					transform 0.25s var(--ease),
					box-shadow 0.25s var(--ease),
					background 0.2s ease,
					border-color 0.2s ease;
			}

			.btn:hover {
				transform: translateY(-3px);
			}

			.btn:active {
				transform: translateY(-1px);
			}

			.btn:focus-visible {
				outline: 2px solid var(--primary);
				outline-offset: 2px;
			}

			.btn-primary {
				background: linear-gradient(135deg, #2563eb, #1d4ed8);
				color: #fff;
				box-shadow: 0 0.5rem 1.25rem rgba(37, 99, 235, 0.3);
			}

			.btn-primary:hover {
				box-shadow: 0 0.85rem 1.75rem rgba(37, 99, 235, 0.45);
			}

			.btn-secondary {
				background: var(--surface);
				border-color: var(--border);
				color: var(--text);
			}

			.btn-secondary:hover {
				border-color: rgba(37, 99, 235, 0.25);
				box-shadow: var(--shadow);
			}

			.trust {
				display: flex;
				flex-wrap: wrap;
				gap: 1.5rem 2rem;
				margin-top: 2rem;
				padding-top: 1.5rem;
				border-top: 1px solid var(--border);
			}

			.trust strong {
				display: block;
				font-size: 1.25rem;
				letter-spacing: -0.02em;
			}

			.trust span {
				font-size: 0.8rem;
				color: #475569;
				font-weight: 500;
			}

			/* Trending card */
			.trending {
				background: rgba(255, 255, 255, 0.8);
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				padding: 1.5rem 1.35rem;
				box-shadow: var(--shadow);
				position: relative;
				overflow: hidden;
				animation: scale-in 0.7s var(--ease) both;
				animation-delay: 0.15s;
				transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
			}

			.trending:hover {
				transform: translateY(-4px);
				box-shadow: var(--shadow-lg);
			}

			.trending::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				height: 3px;
				background: linear-gradient(90deg, #2563eb, #6366f1, #8b5cf6);
				background-size: 200% 100%;
				animation: gradient-move 4s linear infinite;
			}

			.trending-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 1rem;
			}

			.trending-header h2 {
				font-size: 1rem;
			}

			.live {
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				color: #15803d;
				background: rgba(34, 197, 94, 0.12);
				padding: 0.2rem 0.45rem;
				border-radius: 0.35rem;
				animation: live-glow 2s ease-in-out infinite;
			}

			@keyframes live-glow {
				0%, 100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
				50% { box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.12); }
			}

			.trending ol {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 0.25rem;
			}

			.trending li {
				display: flex;
				align-items: center;
				gap: 0.7rem;
				padding: 0.5rem 0.55rem;
				border-radius: 0.65rem;
				color: var(--muted);
				font-size: 0.92rem;
				font-weight: 500;
				transition:
					background 0.2s ease,
					color 0.2s ease,
					transform 0.25s var(--ease);
			}

			.trending li:hover {
				background: var(--primary-soft);
				color: var(--primary);
				transform: translateX(4px);
			}

			.trending .num {
				width: 1.4rem;
				height: 1.4rem;
				border-radius: 0.4rem;
				background: var(--primary-soft);
				color: var(--primary);
				font-size: 0.7rem;
				font-weight: 700;
				display: grid;
				place-items: center;
				flex-shrink: 0;
				transition: transform 0.25s var(--ease);
			}

			.trending li:hover .num {
				transform: scale(1.08);
			}

			/* Featured */
			.featured a {
				display: grid;
				grid-template-columns: 1.15fr 1fr;
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				overflow: hidden;
				box-shadow: var(--shadow);
				transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
				min-height: 20rem;
			}

			.featured a:hover {
				transform: translateY(-5px);
				box-shadow: var(--shadow-lg);
			}

			.featured-media {
				background: linear-gradient(145deg, #1e3a8a, #312e81);
				min-height: 14rem;
				overflow: hidden;
			}

			.featured-media img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				aspect-ratio: 2 / 1;
				transition: transform 0.6s var(--ease);
			}

			.featured a:hover .featured-media img {
				transform: scale(1.04);
			}

			.featured .body {
				padding: 1.75rem 1.75rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}

			.featured .label {
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: var(--primary);
				margin-bottom: 0.45rem;
			}

			.featured .date {
				color: var(--muted);
				font-size: 0.9rem;
				margin-bottom: 0.55rem;
			}

			.featured h3 {
				font-size: clamp(1.35rem, 2.5vw, 1.85rem);
				margin-bottom: 0.55rem;
				transition: color 0.2s ease;
			}

			.featured a:hover h3 {
				color: var(--primary-dark);
			}

			.featured .desc {
				color: var(--muted);
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
				margin-bottom: 1.1rem;
			}

			.featured .btn {
				align-self: flex-start;
			}

			/* Cards grid */
			.grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1.25rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.card a {
				display: grid;
				gap: 0;
				height: 100%;
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				overflow: hidden;
				transition:
					transform 0.3s var(--ease),
					box-shadow 0.3s var(--ease),
					border-color 0.25s ease;
				position: relative;
			}

			.card a::after {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				height: 3px;
				background: linear-gradient(90deg, var(--primary), var(--accent));
				opacity: 0;
				transition: opacity 0.25s ease;
			}

			.card a:hover {
				transform: translateY(-6px);
				box-shadow: var(--shadow);
				border-color: rgba(37, 99, 235, 0.15);
			}

			.card a:hover::after {
				opacity: 1;
			}

			.card img {
				width: 100%;
				height: auto;
				aspect-ratio: 2 / 1;
				object-fit: cover;
				display: block;
				background: #312e81;
				transition: transform 0.5s var(--ease);
			}

			.card a:hover img {
				transform: scale(1.05);
			}

			.card .body {
				padding: 1rem 1.05rem 1.15rem;
				display: grid;
				gap: 0.35rem;
			}

			.card .date {
				color: var(--muted);
				font-size: 0.85rem;
			}

			.card h3 {
				font-size: 1.08rem;
				transition: color 0.2s ease;
			}

			.card a:hover h3 {
				color: var(--primary);
			}

			.card .desc {
				color: var(--muted);
				font-size: 0.92rem;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			/* Categories */
			.categories {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1rem;
			}

			.category {
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 1.35rem 1.2rem;
				box-shadow: var(--shadow-xs);
				transition:
					transform 0.3s var(--ease),
					box-shadow 0.3s var(--ease),
					border-color 0.25s ease;
			}

			.category:hover {
				transform: translateY(-5px);
				box-shadow: var(--shadow);
				border-color: rgba(37, 99, 235, 0.14);
			}

			.category-icon {
				width: 2.6rem;
				height: 2.6rem;
				border-radius: 0.75rem;
				display: grid;
				place-items: center;
				font-size: 1.2rem;
				margin-bottom: 0.85rem;
				background: linear-gradient(135deg, rgba(37, 99, 235, 0.1), rgba(99, 102, 241, 0.1));
				transition: transform 0.3s var(--ease);
			}

			.category:hover .category-icon {
				transform: scale(1.08) rotate(-4deg);
			}

			.category h3 {
				font-size: 1rem;
				margin-bottom: 0.25rem;
			}

			.category p {
				font-size: 0.85rem;
				color: var(--muted);
			}

			/* Why */
			.why-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1rem;
			}

			.why-card {
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 1.5rem 1.35rem;
				box-shadow: var(--shadow-xs);
				transition:
					transform 0.3s var(--ease),
					box-shadow 0.3s var(--ease);
			}

			.why-card:hover {
				transform: translateY(-5px);
				box-shadow: var(--shadow);
			}

			.why-icon {
				width: 2.75rem;
				height: 2.75rem;
				border-radius: 0.8rem;
				display: grid;
				place-items: center;
				font-size: 1.2rem;
				margin-bottom: 1rem;
				background: linear-gradient(135deg, rgba(37, 99, 235, 0.12), rgba(99, 102, 241, 0.12));
				transition: transform 0.3s var(--ease);
			}

			.why-card:hover .why-icon {
				transform: scale(1.1);
			}

			.why-card h3 {
				font-size: 1.08rem;
				margin-bottom: 0.4rem;
			}

			.why-card p {
				color: var(--muted);
				font-size: 0.94rem;
			}

/* Newsletter — light / white version */
.newsletter {
	margin-top: 4rem;
	padding: 2.75rem 1.5rem;
	border-radius: var(--radius-lg);
	background: #ffffff;
	color: var(--text);
	text-align: center;
	box-shadow: var(--shadow);
	border: 1px solid var(--border);
	position: relative;
	overflow: hidden;
}

/* optional soft blue glow (light theme) */
.newsletter::before {
	content: '';
	position: absolute;
	top: -40%;
	left: -20%;
	width: 60%;
	height: 80%;
	background: radial-gradient(circle, rgba(37, 99, 235, 0.08), transparent 70%);
	pointer-events: none;
}

.newsletter::after {
	content: '';
	position: absolute;
	bottom: -30%;
	right: -15%;
	width: 50%;
	height: 70%;
	background: radial-gradient(circle, rgba(99, 102, 241, 0.07), transparent 70%);
	pointer-events: none;
}

.newsletter > * {
	position: relative;
	z-index: 1;
}

.newsletter h2 {
	font-size: clamp(1.4rem, 3vw, 2rem);
	margin-bottom: 0.5rem;
	color: var(--text);
}

.newsletter > p {
	color: var(--muted);
	max-width: 32rem;
	margin: 0 auto 1.25rem;
}

.newsletter form {
	display: flex;
	flex-wrap: wrap;
	gap: 0.6rem;
	justify-content: center;
	max-width: 28rem;
	margin: 0 auto;
}

.newsletter input {
	flex: 1 1 12rem;
	min-height: 2.75rem;
	padding: 0.7rem 0.9rem;
	border-radius: 0.75rem;
	border: 1px solid var(--border);
	background: #f8fafc;
	color: var(--text);
	font: inherit;
}

.newsletter input::placeholder {
	color: var(--muted-2, #94a3b8);
}

.newsletter input:focus {
	outline: 2px solid #93c5fd;
	outline-offset: 1px;
	background: #fff;
	border-color: rgba(37, 99, 235, 0.35);
}

.newsletter button {
	min-height: 2.75rem;
	padding: 0.7rem 1.1rem;
	border: 0;
	border-radius: 0.75rem;
	background: linear-gradient(135deg, #2563eb, #1d4ed8);
	color: #fff;
	font-weight: 700;
	font: inherit;
	cursor: pointer;
	transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.newsletter button:hover {
	transform: translateY(-2px);
	box-shadow: 0 0.6rem 1.25rem rgba(37, 99, 235, 0.35);
}

.note {
	margin-top: 0.75rem;
	font-size: 0.8rem;
	color: var(--muted);
}

			.empty {
				padding: 2rem;
				border: 1px dashed var(--border);
				border-radius: var(--radius);
				background: var(--surface);
				color: var(--muted);
				text-align: center;
			}

			@media (max-width: 900px) {
				.hero {
					grid-template-columns: 1fr;
					gap: 2rem;
				}

				.featured a {
					grid-template-columns: 1fr;
				}

				.why-grid,
				.categories {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 720px) {
				.grid {
					grid-template-columns: 1fr;
				}

				.categories {
					grid-template-columns: 1fr 1fr;
				}

				.actions {
					flex-direction: column;
				}

				.btn {
					width: 100%;
				}

				.newsletter form {
					flex-direction: column;
				}

				.newsletter input,
				.newsletter button {
					width: 100%;
				}
			}

			@media (max-width: 480px) {
				.categories {
					grid-template-columns: 1fr;
				}
			}

			/* Accessibility: respect reduced motion */
			@media (prefers-reduced-motion: reduce) {
				*,
				*::before,
				*::after {
					animation: none !important;
					transition: none !important;
					scroll-behavior: auto !important;
				}
			}
/* Partner referral — Binance */
.partner {
	margin-top: 4rem;
	content-visibility: auto;
	contain-intrinsic-size: 280px;
}

.partner-label {
	font-size: 0.75rem;
	font-weight: 700;
	letter-spacing: 0.06em;
	text-transform: uppercase;
	color: var(--muted);
	margin-bottom: 0.75rem;
}

.partner-card {
	display: grid;
	grid-template-columns: 1.2fr 0.8fr;
	gap: 1.5rem;
	align-items: center;
	padding: 1.75rem 1.75rem;
	border-radius: var(--radius-lg);
	border: 1px solid rgba(240, 185, 11, 0.22);
	background:
		radial-gradient(ellipse 80% 80% at 100% 0%, rgba(240, 185, 11, 0.12), transparent 55%),
		linear-gradient(145deg, #0b0e11, #141820 55%, #0b0e11);
	color: #fff;
	box-shadow: var(--shadow);
	transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.25s ease;
}

.partner-card:hover {
	transform: translateY(-4px);
	box-shadow: var(--shadow-lg);
	border-color: rgba(240, 185, 11, 0.4);
}

.partner-kicker {
	display: inline-flex;
	align-items: center;
	gap: 0.4rem;
	font-size: 0.75rem;
	font-weight: 700;
	letter-spacing: 0.05em;
	text-transform: uppercase;
	color: #f0b90b;
	margin-bottom: 0.65rem;
}

.partner-card h3 {
	font-size: clamp(1.35rem, 2.5vw, 1.85rem);
	letter-spacing: -0.03em;
	margin-bottom: 0.55rem;
	color: #fff;
}

.partner-card p {
	color: rgba(255, 255, 255, 0.72);
	font-size: 0.98rem;
	max-width: 34rem;
	margin-bottom: 1.15rem;
}

.partner-cta {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 0.4rem;
	min-height: 2.75rem;
	padding: 0.7rem 1.2rem;
	border-radius: 0.75rem;
	background: #f0b90b;
	color: #0b0e11;
	font-weight: 700;
	font-size: 0.95rem;
	border: none;
	transition: transform 0.2s var(--ease), box-shadow 0.2s ease;
}

.partner-card:hover .partner-cta {
	transform: translateY(-2px);
	box-shadow: 0 0.6rem 1.25rem rgba(240, 185, 11, 0.35);
}

.partner-side {
	display: grid;
	gap: 0.65rem;
	justify-items: end;
}

.partner-chip {
	display: inline-flex;
	align-items: center;
	gap: 0.45rem;
	padding: 0.55rem 0.85rem;
	border-radius: 999px;
	background: rgba(255, 255, 255, 0.06);
	border: 1px solid rgba(255, 255, 255, 0.1);
	font-size: 0.85rem;
	font-weight: 600;
	color: rgba(255, 255, 255, 0.9);
}

.partner-chip .dot {
	width: 0.45rem;
	height: 0.45rem;
	border-radius: 50%;
	background: #f0b90b;
}

.partner-brand {
	font-size: 0.8rem;
	color: rgba(255, 255, 255, 0.45);
	font-weight: 500;
}

.partner-disclaimer {
	margin-top: 0.75rem;
	font-size: 0.78rem;
	line-height: 1.55;
	color: var(--muted);
	max-width: 52rem;
}

@media (max-width: 720px) {
	.partner-card {
		grid-template-columns: 1fr;
		padding: 1.4rem 1.25rem;
	}

	.partner-side {
		justify-items: start;
	}
}
