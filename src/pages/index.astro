---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = posts[0];
const latestPosts = posts.slice(1, 7);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			:root {
				--bg: #f1f5f9;
				--surface: #fff;
				--text: #0b1220;
				--muted: #64748b;
				--primary: #2563eb;
				--primary-dark: #1d4ed8;
				--border: rgba(15, 23, 42, 0.08);
				--radius: 1.25rem;
				--shadow: 0 1rem 2.5rem rgba(15, 23, 42, 0.08);
				--font: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				margin: 0;
				font-family: var(--font);
				color: var(--text);
				background: var(--bg);
				-webkit-font-smoothing: antialiased;
			}

			main {
				width: min(100% - 2rem, 70rem);
				margin-inline: auto;
				padding-block: 2rem 4rem;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			h1,
			h2,
			h3 {
				margin: 0;
				line-height: 1.15;
				letter-spacing: -0.03em;
			}

			p {
				margin: 0;
				line-height: 1.7;
			}

			.hero {
				display: grid;
				gap: 1.25rem;
				padding: 2.5rem 0 3rem;
			}

			.hero h1 {
				font-size: clamp(2.25rem, 6vw, 3.75rem);
				max-width: 18ch;
			}

			.hero h1 span {
				background: linear-gradient(120deg, #2563eb, #6366f1 55%, #8b5cf6);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}

			.hero p {
				color: var(--muted);
				font-size: 1.1rem;
				max-width: 40rem;
			}

			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 0.5rem;
			}

			.btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-height: 2.75rem;
				padding: 0.7rem 1.2rem;
				border-radius: 0.75rem;
				font-weight: 600;
				font-size: 0.95rem;
				border: 1px solid transparent;
				transition: transform 0.15s ease, box-shadow 0.15s ease;
			}

			.btn:hover {
				transform: translateY(-1px);
			}

			.btn:focus-visible {
				outline: 2px solid var(--primary);
				outline-offset: 2px;
			}

			.btn-primary {
				background: linear-gradient(135deg, #2563eb, #1d4ed8);
				color: #fff;
				box-shadow: 0 0.5rem 1.25rem rgba(37, 99, 235, 0.3);
			}

			.btn-secondary {
				background: var(--surface);
				border-color: var(--border);
				color: var(--text);
			}

			.section {
				margin-top: 3.5rem;
			}

			.section-header {
				display: flex;
				align-items: end;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1.25rem;
				flex-wrap: wrap;
			}

			.section-header h2 {
				font-size: clamp(1.5rem, 3vw, 2rem);
			}

			.section-header a {
				color: var(--primary);
				font-weight: 600;
				font-size: 0.95rem;
			}

			.section-header a:hover {
				color: var(--primary-dark);
			}

			/* Featured = first post, full width */
			.featured {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.featured a {
				display: grid;
				gap: 1rem;
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				overflow: hidden;
				box-shadow: var(--shadow);
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}

			.featured a:hover {
				transform: translateY(-3px);
				box-shadow: 0 1.25rem 3rem rgba(15, 23, 42, 0.12);
			}

			.featured img {
				width: 100%;
				height: auto;
				aspect-ratio: 2 / 1;
				object-fit: cover;
				display: block;
				background: #1e3a8a;
			}

			.featured .body {
				padding: 1.25rem 1.35rem 1.5rem;
			}

			.featured .label {
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: var(--primary);
				margin-bottom: 0.4rem;
			}

			.featured .date {
				color: var(--muted);
				font-size: 0.9rem;
				margin-bottom: 0.5rem;
			}

			.featured h3 {
				font-size: clamp(1.35rem, 2.5vw, 1.85rem);
				margin-bottom: 0.5rem;
			}

			.featured .desc {
				color: var(--muted);
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			/* Latest grid */
			.grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1.25rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.card a {
				display: grid;
				gap: 0.65rem;
				height: 100%;
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				overflow: hidden;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}

			.card a:hover {
				transform: translateY(-3px);
				box-shadow: var(--shadow);
			}

			.card img {
				width: 100%;
				height: auto;
				aspect-ratio: 2 / 1;
				object-fit: cover;
				display: block;
				background: #312e81;
			}

			.card .body {
				padding: 0.9rem 1rem 1.1rem;
				display: grid;
				gap: 0.35rem;
			}

			.card .date {
				color: var(--muted);
				font-size: 0.85rem;
			}

			.card h3 {
				font-size: 1.1rem;
			}

			.card .desc {
				color: var(--muted);
				font-size: 0.92rem;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			/* Newsletter */
			.newsletter {
				margin-top: 4rem;
				padding: 2.25rem 1.5rem;
				border-radius: var(--radius);
				background: linear-gradient(145deg, #0b1220, #1e293b);
				color: #fff;
				text-align: center;
			}

			.newsletter h2 {
				font-size: clamp(1.4rem, 3vw, 2rem);
				margin-bottom: 0.5rem;
			}

			.newsletter p {
				color: rgba(255, 255, 255, 0.72);
				max-width: 32rem;
				margin: 0 auto 1.25rem;
			}

			.newsletter form {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				justify-content: center;
				max-width: 28rem;
				margin: 0 auto;
			}

			.newsletter input {
				flex: 1 1 12rem;
				min-height: 2.75rem;
				padding: 0.7rem 0.9rem;
				border-radius: 0.75rem;
				border: 1px solid rgba(255, 255, 255, 0.15);
				background: rgba(255, 255, 255, 0.08);
				color: #fff;
				font: inherit;
			}

			.newsletter input::placeholder {
				color: rgba(255, 255, 255, 0.45);
			}

			.newsletter input:focus {
				outline: 2px solid #93c5fd;
				outline-offset: 1px;
			}

			.newsletter button {
				min-height: 2.75rem;
				padding: 0.7rem 1.1rem;
				border: 0;
				border-radius: 0.75rem;
				background: #fff;
				color: #0b1220;
				font-weight: 700;
				font: inherit;
				cursor: pointer;
			}

			.note {
				margin-top: 0.75rem;
				font-size: 0.8rem;
				color: rgba(255, 255, 255, 0.4);
			}

			.empty {
				padding: 2rem;
				border: 1px dashed var(--border);
				border-radius: var(--radius);
				background: var(--surface);
				color: var(--muted);
				text-align: center;
			}

			@media (max-width: 720px) {
				.grid {
					grid-template-columns: 1fr;
				}

				.newsletter form {
					flex-direction: column;
				}

				.newsletter input,
				.newsletter button {
					width: 100%;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero" aria-label="Introduction">
				<h1>The Future of <span>Technology, Business & AI</span></h1>
				<p>
					DigiSone Global delivers premium insights on Artificial Intelligence, business strategy,
					startups, cybersecurity, cloud, and the future of work.
				</p>
				<div class="actions">
					<a class="btn btn-primary" href="/blog">Read Latest Insights</a>
					<a class="btn btn-secondary" href="#newsletter">Get Weekly Briefing</a>
				</div>
			</section>

			<!-- Featured (first post) -->
			<section class="section" aria-label="Featured article">
				{
					featuredPost ? (
						<article class="featured">
							<a href={`/blog/${featuredPost.id}/`}>
								{featuredPost.data.heroImage && (
									<Image
										width={1020}
										height={510}
										src={featuredPost.data.heroImage}
										alt={featuredPost.data.title}
										loading="eager"
										fetchpriority="high"
										format="webp"
									/>
								)}
								<div class="body">
									<div class="label">Featured Story</div>
									<p class="date">
										<time datetime={featuredPost.data.pubDate.toISOString()}>
											{featuredPost.data.pubDate.toLocaleDateString('en-US', {
												year: 'numeric',
												month: 'long',
												day: 'numeric',
											})}
										</time>
									</p>
									<h3>{featuredPost.data.title}</h3>
									<p class="desc">{featuredPost.data.description}</p>
								</div>
							</a>
						</article>
					) : (
						<div class="empty">No posts yet. Add markdown files in src/content/blog.</div>
					)
				}
			</section>

			<!-- Latest posts -->
			<section class="section" aria-label="Latest articles">
				<div class="section-header">
					<h2>Latest Articles</h2>
					<a href="/blog">View all</a>
				</div>

				{
					latestPosts.length > 0 ? (
						<ul class="grid">
							{latestPosts.map((post) => (
								<li class="card">
									<a href={`/blog/${post.id}/`}>
										{post.data.heroImage && (
											<Image
												width={720}
												height={360}
												src={post.data.heroImage}
												alt={post.data.title}
												loading="lazy"
												format="webp"
											/>
										)}
										<div class="body">
											<p class="date">
												<time datetime={post.data.pubDate.toISOString()}>
													{post.data.pubDate.toLocaleDateString('en-US', {
														year: 'numeric',
														month: 'short',
														day: 'numeric',
													})}
												</time>
											</p>
											<h3>{post.data.title}</h3>
											<p class="desc">{post.data.description}</p>
										</div>
									</a>
								</li>
							))}
						</ul>
					) : (
						<div class="empty">More articles coming soon.</div>
					)
				}
			</section>

			<!-- Newsletter -->
			<section class="newsletter" id="newsletter" aria-label="Newsletter signup">
				<h2>Get the Weekly Technology Briefing</h2>
				<p>Actionable insights on AI, strategy, security, and digital transformation.</p>
				<form action="#" method="post">
					<label for="email" style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden;">
						Email address
					</label>
					<input
						id="email"
						name="email"
						type="email"
						autocomplete="email"
						required
						placeholder="Enter your email address"
					/>
					<button type="submit">Subscribe</button>
				</form>
				<p class="note">No spam. Unsubscribe anytime.</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
