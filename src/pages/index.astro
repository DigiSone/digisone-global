	<body>
		<Header />
		<main>
			<!-- Hero + Trending -->
			<section class="hero" aria-label="Introduction">
				<div>
					<div class="hero-badge reveal">
						<span class="dot" aria-hidden="true"></span>
						Trusted by founders, operators & technology leaders
					</div>
					<h1 class="reveal reveal-delay-1">The Future of <span>Technology, Business & AI</span></h1>
					<p class="hero-lead reveal reveal-delay-2">
						DigiSone Global delivers premium insights on Artificial Intelligence, business strategy,
						startups, cybersecurity, cloud, and the future of work.
					</p>
					<div class="actions reveal reveal-delay-3">
						<a class="btn btn-primary" href="/blog">Read Latest Insights</a>
						<a class="btn btn-secondary" href="#newsletter">Get Weekly Briefing</a>
					</div>
					<div class="trust reveal reveal-delay-4" aria-label="Platform stats">
						<div>
							<strong>{posts.length}</strong>
							<span>Published articles</span>
						</div>
						<div>
							<strong>12k+</strong>
							<span>Monthly readers</span>
						</div>
						<div>
							<strong>4.9★</strong>
							<span>Reader rating</span>
						</div>
					</div>
				</div>

				<aside class="trending" aria-label="Trending topics">
					<div class="trending-header">
						<h2>Trending Topics</h2>
						<span class="live">Live</span>
					</div>
					<ol>
						{
							trendingTopics.map((topic, i) => (
								<li>
									<span class="num">{String(i + 1).padStart(2, '0')}</span>
									{topic}
								</li>
							))
						}
					</ol>
				</aside>
			</section>

			<!-- Featured -->
			<section class="section featured reveal" aria-label="Featured article">
				{
					featuredPost ? (
						<article>
							<a href={`/blog/${featuredPost.id}/`} aria-label={`Read: ${featuredPost.data.title}`}>
								<div class="featured-media">
									{featuredPost.data.heroImage && (
										<Image
											width={1020}
											height={510}
											src={featuredPost.data.heroImage}
											alt={featuredPost.data.title}
											loading="eager"
											fetchpriority="high"
											format="webp"
										/>
									)}
								</div>
								<div class="body">
									<div class="label">Featured Story</div>
									<p class="date">
										<time datetime={featuredPost.data.pubDate.toISOString()}>
											{featuredPost.data.pubDate.toLocaleDateString('en-US', {
												year: 'numeric',
												month: 'long',
												day: 'numeric',
											})}
										</time>
									</p>
									<h3>{featuredPost.data.title}</h3>
									<p class="desc">{featuredPost.data.description}</p>
									<span class="btn btn-primary">Read Article</span>
								</div>
							</a>
						</article>
					) : (
						<div class="empty">No posts yet. Add markdown files in src/content/blog.</div>
					)
				}
			</section>

			<!-- Latest -->
			<section class="section" aria-label="Latest articles">
				<div class="section-header reveal">
					<h2>Latest Articles</h2>
					<a href="/blog">View all →</a>
				</div>

				{
					latestPosts.length > 0 ? (
						<ul class="grid">
							{latestPosts.map((post, i) => (
								<li class={`card reveal reveal-delay-${Math.min(i + 1, 5)}`}>
									<a href={`/blog/${post.id}/`} aria-label={post.data.title}>
										{post.data.heroImage && (
											<Image
												width={720}
												height={360}
												src={post.data.heroImage}
												alt={post.data.title}
												loading="lazy"
												format="webp"
											/>
										)}
										<div class="body">
											<p class="date">
												<time datetime={post.data.pubDate.toISOString()}>
													{post.data.pubDate.toLocaleDateString('en-US', {
														year: 'numeric',
														month: 'short',
														day: 'numeric',
													})}
												</time>
											</p>
											<h3>{post.data.title}</h3>
											<p class="desc">{post.data.description}</p>
										</div>
									</a>
								</li>
							))}
						</ul>
					) : (
						<div class="empty">More articles coming soon.</div>
					)
				}
			</section>

			<!-- Categories -->
			<section class="section" aria-label="Categories">
				<div class="section-header reveal">
					<h2>Explore Categories</h2>
					<a href="/categories">Browse all →</a>
				</div>
				<div class="categories">
					{
						categories.map((cat, i) => (
							<a href={cat.href} class={`category reveal reveal-delay-${Math.min(i + 1, 5)}`}>
								<div class="category-icon" aria-hidden="true">
									{cat.icon}
								</div>
								<h3>{cat.title}</h3>
								<p>{cat.desc}</p>
							</a>
						))
					}
				</div>
			</section>

			<!-- Why -->
			<section class="section" aria-label="Why professionals read DigiSone Global">
				<div class="section-header reveal">
					<h2>Why Professionals Read DigiSone Global</h2>
				</div>
				<div class="why-grid">
					<div class="why-card reveal reveal-delay-1">
						<div class="why-icon" aria-hidden="true">🔍</div>
						<h3>Deep Analysis</h3>
						<p>Practical insights beyond headlines and breaking news.</p>
					</div>
					<div class="why-card reveal reveal-delay-2">
						<div class="why-icon" aria-hidden="true">🧠</div>
						<h3>Expert Perspectives</h3>
						<p>Technology, leadership and innovation from industry operators.</p>
					</div>
					<div class="why-card reveal reveal-delay-3">
						<div class="why-icon" aria-hidden="true">⚡</div>
						<h3>Actionable Takeaways</h3>
						<p>Frameworks, lessons and strategies you can apply immediately.</p>
					</div>
				</div>
			</section>

<!-- Partner referral -->
